topology { level tenant level project parent tenant }
subject customer { anchor project; reach self; identifies customer_id; roles none; binds owner }
subject staff { anchor project; reach self; identifies sub; roles none }
object doc {
  table docs
  scoped tenant > project
  relation owner: customer via owner_id
  relation team: staff via group tc(grp, mem) edge te(mem, grp) on team_id
  permission view = owner + team @rls maps select
}
object note {
  table notes
  scoped tenant > project
  relation circle: customer via group tc(grp, mem) edge te(mem, grp) on circle_id
  permission view = circle @rls maps select
}
object board {
  table boards
  scoped tenant > project
  relation crew: staff via group tc(grp, mem) edge te(mem, grp) on crew_id materialized
  permission view = crew @rls maps select
}
object page {
  table pages
  scoped tenant > project
  relation in_folder: staff via closure folder_paths(ancestor_id, descendant_id) base folders(id, parent_id) on folder_id
  permission view = in_folder @rls maps select
}
