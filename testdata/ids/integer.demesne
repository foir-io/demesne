identifiers integer
topology { level platform virtual level tenant parent platform level project parent tenant }
vocabulary staff {
  permission resource:read
  preset viewer @ project = resource:read
  preset owner @ tenant = *
  rank owner > viewer
}
rolestore staff {
  assignments role_grants
  kind        grantee_kind = "staff"
  subject     grantee_id
  scope       tenant_id project_id
  rolejoin    role_id roles id key
  revoked     revoked_at
}
grant support at tenant via edge support_grants(holder_id, tenant_id)
subject helper { anchor tenant; reach via grant support; identifies sub; roles none }
subject staff { anchor tenant; reach descendants; identifies staff_id; roles configurable staff; binds admin }
subject operator { anchor platform; reach descendants; identifies operator_id via membership ops_users(user_ref, is_ops) active state = "ON"; roles none }
subject member { anchor project; reach self; identifies member_id; roles none; binds owner }
object acl_entry {
  table acl
  scoped tenant > project
  permission view = @store_manage @rls maps select
  permission edit = @store_manage @rls maps update
}
object doc {
  table docs
  scoped tenant > project
  relation owner: member via owner_id
  relation grantee: member via grant acl(resource_id, principal_kind, principal_id, access) where resource_type = "doc"
  relation parent: member via composition docs(id, parent_id)
  relation team: member via group tc(grp, mem) edge te(mem, grp) on team_id
  permission view = owner + grantee:read + grantee:write + parent + team @rls maps select
  permission edit = owner + grantee:write @rls maps update
}
object note {
  table notes
  scoped tenant > project
  relation doc: member via object doc->view on doc_id
  permission view = doc @rls maps select
}
object ledger {
  table ledgers
  scoped tenant > project
  relation owner: member via owner_id
  permission view = owner @rls maps select
  permission edit = owner @kernel maps update
}
object resource {
  table resources
  scoped tenant > project
  relation tenant: tenant via tenant_id
  relation holder: staff via role
  permission view = holder + tenant->owner @rls maps select
}
object folio {
  table folios
  scoped tenant > project
  relation shared: member via edge folio_shares(member_id, folio_id) key rule_id
  permission view = some r in rules_live prefix "read." held rules_held (shared) @rls maps select
}
object page {
  table pages
  scoped tenant > project
  relation in_folder: member via closure folder_paths(ancestor_id, descendant_id) base folders(id, parent_id) on folder_id
  permission view = in_folder @rls maps select
}
