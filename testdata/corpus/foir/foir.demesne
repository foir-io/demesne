// END GENERATED: the catalogue vocabulary

// Where a member's roles live — lets the compiler GENERATE the role-resolution
// definers (is_tenant_member / member_has_project_role / the
// project-management-tier definer) instead of referencing hand-written ones (V9).
rolestore memberships {
  // A member's roles are the ones their memberships hold, whichever pool they
  // sign in from: the same rows the platform's one reader answers from
  // (rbac.HeldAt). They are read whole only for a request nothing narrows: one
  // an app narrowed carries its person as user_id and no sub, and reaches rows
  // through the reach claims worked out from what the app and the person's
  // agreement allow.
  //
  // A role given at an organisation is not read here. It reaches rows through
  // the claims worked out for a request standing at that organisation, where
  // what it gives is cut to what an organisation narrows. Declaring org_id with
  // the plane at the project is what keeps it out (`ra.org_id IS NULL`) while
  // auth.member_has_perm keeps its four arguments.
  //
  // The holder's column is holder_id and not user_id: the lookups generated
  // from this store take a parameter named user_id, and a column of that name
  // on the table they read would be compared with itself.
  assignments membership_roles
  subject     holder_id
  scope       tenant_id project_id org_id
  plane       project
  // The join target is roles_active, a view over `roles` that serves each role
  // as the request's channel does (public.role_as_served) and leaves out a
  // disabled one, NOT the base table. The Go-side reader (rbac's ListHeldRoles)
  // reads roles the same way; without this view a disabled role would keep its
  // row-level reach after the console showed it gone, and a role a push changed
  // would change what the rules admit before its release,
  // because this spec has no `disabled` concept and the emitted definers would
  // join `roles` unfiltered.
  //
  // NOT a grammar gap. demesne declines this deliberately and names this exact
  // case: "Adopter-specific admission rules stay your policy: a disabled role, or
  // a client- or RP-scoped grant." `revoked` (an assignment withdrawn) belongs to
  // the grammar; `disabled` (a role definition switched off) is adopter policy,
  // and the engine stays domain-agnostic by not absorbing it. The emitter
  // interpolates this name as a bare relation into a JOIN, so a view lands the
  // filter in every generated definer at once — present and future — for one
  // migration and one word, rather than a demesne release and six go.mod pins.
  //
  // The `object roles` block below is deliberately NOT repointed: the console
  // must still LIST disabled roles to offer re-enabling them.
  rolejoin    role_id roles_active id key
  revoked     revoked_at by revoked_by
  permissions permissions   // roles.permissions — the materialized effective set the
                            // holds-resolver reads (EID-334 adoption); a custom role
                            // resolves verbatim. Additive: no SQL emitter references it.
  pk          id
  granted     granted_at by granted_by   // assign-management write surface (EID-334)
}

// The PLATFORM plane (Demesne v3 WS6) — retires the staff god-flag.
// Staff authority is a role anchored at the VIRTUAL platform root: a revocable,
// audited role_assignments row (NULL tenant_id + project_id), NOT a standing
// boolean column. The god-flag column and its auth function
// were dropped by the accompanying migration.
//
// TTS-1017: this vocabulary is now BACKED BY A ROLESTORE (below), which is what
// turns `platform:manage` from a declaration that compiles to nothing into the
// gate that staff authority actually runs through. `platform:manage` is
// deliberately absent from `vocabulary catalogue`: a member must not be able to
// grant it, and keeping it out of the catalogue vocabulary is what makes CapGrant
// reject it as an unknown permission — a structural boundary, not a policed one.
//
// THE VOCABULARY DECLARES NO PRESET. The last one — the staff preset `@
// platform = platform:manage` — is deleted. It was the final survivor of the
// preset model TTS-1044 removed, and it was the last place in the system where a
// role KEY carried meaning. It emitted two things and only two: the
// `roleTiers*()` accessors (Go + TS), each of which answered "is this principal
// staff?" by asking whether the staff preset's KEY was held — a KEY probe standing in front of
// the permission that actually decides — and a `Presets` block on the platform
// holds-resolver that nothing resolves through (PermsCol is set, so the resolver
// reads roles.permissions verbatim). Deleting it makes the emitted answer
// unavailable, which is the point: staff authority has exactly one definition,
// `@holds(platform:manage)` at the platform plane, and the seeded role row is
// ordinary — it works because of what it GRANTS, not because of what it is called.
vocabulary platform {
  permission platform:manage

  // TTS-1190: founding a workspace is a capability an ACCOUNT holds — an
  // ordinary role_assignments row at (NULL, NULL) — not a signup mode and not
  // an entitlement (both take a subject that does not exist yet, or a tenant
  // the asker does not have). Declared in THIS vocabulary because the grant
  // precedes any tenant: the platform plane is the only scope an unassigned
  // account can hold anything at. It implies nothing, and platform:manage does
  // not imply it — staff authority is management, not membership of every
  // door; the tenant create rule names both verbs side by side instead.
  //
  // Being platform vocabulary buys the boundaries for free: CapGrant reports it
  // Unknown to tenant role authors (a tenant cannot compose it into a role),
  // AuthorizeRoleGrant's plane-mixing refusal keeps it off any role that
  // carries workspace verbs (so holding a workspace never confers founding another),
  // and auth.platform_vocabulary() keeps it out of every tenant's union of workspace verbs.
  permission platform:create_workspace
}

// The PLATFORM rolestore (demesne v0.77.0). Same physical table as `rolestore
// memberships` — one role_assignments row shape for the whole system — but declared
// `plane platform`, so every scope column BELOW the platform level is pinned
// `IS NULL` in all three surfaces (the emitted definer, the assignment fetch and
// the Go/TS Resolve). The emitted check is
//
//   auth.platform_has_perm(user_id text, p_perm text)
//     … AND ra.tenant_id IS NULL AND ra.project_id IS NULL AND p_perm = ANY(r.permissions)
//
// — no scope argument, so it sits exactly where auth.has_platform_role sat: top
// level, claim-free, cross-tenant. Two consequences are load-bearing:
//
//  1. Platform authority is UNREACHABLE from a tenant- or project-scoped row. A
//     role carrying platform:manage assigned at `tenant_id = X` does not satisfy
//     the platform check — asserted by TestPlatformPlaneRejectsTenantScopedGrant.
//     Without the plane, v0.76.0's wildcard-on-NULL would make the tenant column
//     `(IS NULL OR = check)` and a tenant-scoped grant would pass at that tenant.
//  2. Because v0.76.0 made a NULL root scope mean "every tenant", a WORKSPACE-
//     vocabulary role assigned at NULL/NULL would reach every tenant. The
//     separation holds because platform:manage lives in its own vocabulary and
//     its own rolestore — a role row mixing platform:manage with a workspace verb
//     would leak that verb everywhere. The seed invariant (TTS-1042) asserts
//     no such row is seeded.
//
// @holds(platform:manage) resolves here rather than to `rolestore memberships` because
// demesne resolves a @holds term to the rolestore whose VOCABULARY declares the
// permission. A permission declared in two ROLESTORE-BACKED vocabularies, or a
// vocabulary backing two rolestores, is a compile error rather than a silent pick.
//
rolestore platform {
  assignments membership_roles
  subject     holder_id
  // org_id is named, with the plane at the platform, so auth.platform_has_perm
  // reads only a role given above every workspace (`AND ra.org_id IS NULL`, and
  // the tenant and project NULL). Only a person of the platform's own pool can be
  // given one: a role's place is checked against where the person's pool sits.
  scope       tenant_id project_id org_id
  plane       platform
  // roles_active, not roles — same reason as `rolestore memberships` above: a disabled
  // role must lose its row-level reach, and both planes have to agree or the
  // divergence just moves. Staff authority is the plane where it matters
  // most: platform:manage is cross-tenant, so a disabled staff role left honoured
  // by RLS is honoured everywhere.
  rolejoin    role_id roles_active id key
  revoked     revoked_at by revoked_by
  permissions permissions
  pk          id
  granted     granted_at by granted_by
}

// Staff (Foir's own people) — EID-254: NO LONGER an unconditional god-flag.
// A staff flag ANDed with `project_id IS NULL` (the standing cross-tenant
// bypass on every policy) is replaced by a SCOPED grant: a staff account reaches a
// tenant's subtree only while it holds an ACTIVE, expiring, revocable row in the
// impersonation_grants edge. The grant compiles to auth.impersonation_grants_reach
// (sub, tenant_id) — a disjunct of the old workspace-owner definer AND a top branch on every
// tenant-scoped object, both scoped to the granted tenant (no ambient reach).
// Bootstrap (the first grant / break-glass) lives in the BYPASSRLS plane, never
// here. Managing grants (who may write impersonation_grants) is the table's own
// object write rule — owner-originated, no self-escalation.
// A GRANT CONFERS REACH, NEVER VERBS. It widens WHICH rows a staff account can
// reach and never what they may do to them: every governed object pairs its
// impersonation term with member_has_perm(sub, ...), which reads the CALLER's own
// assignments, so an approval cannot hand out a permission the staff account does not
// hold and revoking their role revokes it inside the grant too.
//
// The decided alternative to two others that are individually plausible.
// Conferring the APPROVER's verbs makes a staff account's authority depend on who
// signed; intersecting the two makes one answer depend on two moving parts, so
// the same support session can act one day and not the next because somebody
// else's role changed. Reach here, verbs there, is the only shape where the
// answer is a property of the staff account.
// STAFF STANDING IS THE GRANT'S, NOT A ROLE'S. Inside a workspace, the staff arm
// `@holds(platform:manage)` sits in the permission half beside the verb, so
// whatever satisfied containment switches it on. Two things satisfy containment
// for a staff account: this grant, and a tenant claim, which the session layer
// issues to a staff account holding a role of its own in the workspace exactly
// as it does for anybody else. Left unqualified, that role would carry every verb
// for a staff account and only its own verbs for anyone else.
//
// So every tenant-contained staff arm reads
//
//   (@holds(platform:manage) and not @claim("staff_reach", "role"))
//
// and the session mints staff_reach = "role" when the claim rests on the
// account's own role with no approved grant covering the scope. The account is
// then held to that role's verbs by the @holds terms beside the arm, which read
// its own assignments. The claim is absent for everyone else, including staff
// with a grant and every hand-built claim, and `not @claim` compiles to
// `(claim = value) IS NOT TRUE`, so absent is the arm exactly as it was.
// Platform-plane objects and the tenant entity itself carry no workspace claim
// and are untouched: staff navigate every workspace and manage the
// platform plane ambiently.
grant impersonation at tenant
  via edge impersonation_grants(grantee_id, tenant_id)
  active revoked_at expires expires_at
  // A grant may name a project and an organisation. One that names neither
  // reaches the whole workspace, which is what every grant does today; one
  // that names a level is confined to it. `missing allow` is that rule.
  scope project on project_id missing allow
  scope org     on org_id     missing allow
  pk id granted by granted_by revoked by revoked_by created created_at column reason   // write surface (EID-334 adoption); additive

subject impersonator { anchor platform; reach via grant impersonation; identifies sub; roles none }

// ── ANCESTRY: an organisation reaches what is below it ─────────────────────────
//
// The containment term on an organisation-scoped object is an EQUALITY —
// `org_id IS NULL OR org_id = <claim>` — so an organisation reads its own rows
// and the project-shared tier and nothing else. That is correct and stays
// correct; what it cannot say is that a PARENT reads a child's rows, because
// "below me" is not a property of the row, it is a property of the tree.
//
// A closure table turns that into an equality after all. organization_closure
// holds one row per (ancestor, descendant) pair including the self pair, so
// "the row's organisation is at or below mine" is a two-column lookup and needs
// no new comparison, no ltree and no recursive term in a policy.
//
// WHY IT IS A GRANT AND NOT A NEW SCOPE LEVEL. The reach slot already exists and
// is already in production for impersonation, and its edge columns are free —
// nothing requires the table to be grants-shaped, only that it maps a reaching
// identity to a reached level value. ancestor_id and descendant_id are exactly
// that. Declaring it here is the whole of the row-layer change: the emitter
// splices the reach into the organisation term of every object scoped to org,
// and the closure itself does not change.
//
// ⚠️ `confers select` IS THE POINT, NOT A DETAIL. Emitted without a bound, the
// reach is identical across select, insert, update and delete — so a parent
// would gain the right to WRITE and DELETE its descendants' rows, silently, on
// the same day it gained the right to read them. An ancestor's reach is a
// reporting and support capability; a write belongs to whoever is standing in
// the organisation that owns the row. Much cheaper to bound now than to narrow
// later, because narrowing a reach that shipped is a capability withdrawal.
//
// ⚠️ The reach is spliced INSIDE the containment conjunct, not beside it, and
// that depends on the subject below anchoring at `org`. A grant at the leaf
// level whose subject anchors elsewhere becomes a TOP-LEVEL disjunct, which
// stands alone and drops the tenant and project conjuncts entirely — on INSERT
// that is a cross-project write. demesne decides this in grantReachIsContained
// and the anchor is the input it reads.
//
// It confers no reach on `organizations` or `organization_members` themselves:
// both are `scoped tenant > project` — an organisation's own row is its
// identity, not something inside it — so the grant does not apply to them and
// navigating the tree stays the definers' job.
// A credential holding the cross-organisation read capability reads the whole
// project rather than one organisation. The claim is minted by the adopter and
// lifts containment at the org level, for reads only.
grant orgreach at org via claim org_reach = "project" confers select

grant ancestry at org
  via edge organization_closure(ancestor_id, descendant_id)
  confers select

// The same closure read the other way. A definition composes UPWARD: a
// descendant inherits what its ancestors declare, where management
// composes downward. One edge, two directions, told apart by name.
//
// The closure holds the self pair at depth 0, so the set contains the caller's
// own organization as well as its ancestors. That makes the containment term's
// `org_id = claim` disjunct redundant beside it rather than necessary, which is
// the right way round: the redundancy is harmless, and the alternative would be
// a set that silently excluded the caller's own definitions.
//
// WHICH OBJECTS TAKE IT. An object belongs here when it holds a DECLARATION that
// composes into a project's schema or its configuration. It does not belong when
// it holds a ROW, even a row about a declaration: operation_executions, dead
// letters, publish batches and schedules all carry the organization axis and all
// stay DOWNWARD, because an ancestor's people supporting a client read that
// client's runs. public_query_names is a declaration by that test though it is
// derived rather than authored — each row is a root query name a model or
// operation mints, at that definition's own level, and it names the model key
// behind it. Left downward, an ancestor would read every private model key its
// clients declared through the names they generate.
grant inheritance at org
  via edge organization_closure(descendant_id, ancestor_id)
  named organization_closure_inherit
  confers select

// The reaching subject. `identifies org_id` is what supplies the ancestor half
// of the lookup: the caller's own organisation claim, the same one the equality
// term reads, so a caller carrying no organisation reaches nothing and a project
// with no organisations emits a predicate nothing can satisfy and nothing pays
// for.
//
// `roles none`: ancestry decides REACH and never permission. What an ancestor
// may do with a descendant's row is still the object's own permission
// expression, unchanged — this only widens which rows the containment term
// admits, and every verb gate above it still applies.
subject org_ancestor { anchor org; reach via grant ancestry; identifies org_id; roles none }
// TTS-1017: `roles none`, and every `staff` TERM is gone from the objects below.
// `roles configurable platform` is what made demesne emit auth.has_platform_role —
// a definer that resolved a platform assignment and then matched `r.key IN
// (the staff preset's key)`, the last three key-matching sites in the generated SQL
// (has_platform_role itself, projects_accessors and tenants_accessors). Staff
// authority is now @holds(platform:manage) against `rolestore platform`, so the
// role's KEY is no longer an input anywhere — in the emitted SQL, in the Go
// handlers, or in the clients: a tenant-authored role carrying platform:manage
// would work, and the seeded platform-root row works only because of what it
// GRANTS. The preset that named that row was deleted with the vocabulary above.
subject staff    { anchor platform; reach descendants; identifies sub;         roles none } // platform-role plane (WS6)
// THE PERSON, in every pool, as demesne's two planes see them. `user_id` names
// the person a request acts for: who signed in, or the person a service or an
// operation carries. `sub` names the caller itself.
//
// `member` is the person holding roles through their memberships. It is
// identified by the caller, never by a person a caller carries: an operation
// started by somebody runs under its own grants, not under their roles.
//
// `user` is the person owning rows. A row's owner is resolved from the owner
// subject anchored at the object's leaf level, so the person is declared at
// both leaves an owned row can sit at, the project and the organisation, with
// the same claim and the same reach. It is one person, stated at two levels.
subject member     { anchor tenant;  reach descendants; identifies sub;     roles configurable catalogue; binds admin }
subject user       { anchor project; reach self;        identifies user_id; roles none;               binds owner }
subject user_in_org { anchor org;    reach self;        identifies user_id; roles none;               binds owner }
subject service  { anchor project;  reach self;        identifies sub;         roles none }
// THE OWNER A WRITE IS MADE FOR. A caller the platform has already judged may
// write a row belonging to someone else writes it under its own claims, with
// that owner named in delegated_owner for the one transaction: an operation
// attributing a record under records:attribute, an app writing the record of
// the user its identity resolves to, an operation handing a record to a
// user. The claim is minted by the platform after that judgement and never
// from a header. It admits the named owner's rows and nothing else, inside the
// containment every other term is held to, so the write and every read beside
// it stay under the caller's project and organisation. Before it, those writes
// ran with RLS bypassed.
subject owner_delegate { anchor project; reach self; identifies delegated_owner; roles none; transient }
// THE USER A READ NAMES. A holder of a user permission at the named reach
// reaches the one user a request names, and no other. The platform judges that
// the caller may name one and writes who was named into the claims for the one
// transaction, by their id. A request that names somebody by an address is
// answered the same way: the platform finds whose verified address it is in
// the pool the request is for, and names that user. It admits that user's own
// row and nothing else, inside the containment every other term is held to. It
// is never read from a header.
subject user_named          { anchor project; reach self; identifies named_user;       roles none; transient }
// THE ONE USER A WRITE MAKES. Making a user is a write, and a write reads the
// row it makes: the user, the address they are known by and the place they
// first stand. The platform judges that the caller may make one and names the
// user this transaction makes, so a holder of the create that reads no user is
// shown that one and no other. Never read from a header.
subject user_made           { anchor project; reach self; identifies made_user;        roles none; transient }
// THE ONE ORGANISATION A WRITE MAKES. Making an organisation is a write, and a
// write reads the row it makes. The platform judges that the caller may make
// one and names the one this transaction makes, so a holder of the create that
// reads no organisation is shown that one and no other. Never read from a
// header.
subject organization_named  { anchor project; reach self; identifies named_organization; roles none; transient }
// THE ONE RECORD A WRITE IS MADE FOR. A collaborator adding or removing a
// composition child under a parent they may edit (the record gates below)
// writes a row whose owner is the parent's, or nobody. The platform names that
// one record in delegated_record for the transaction, after the gate admits
// it: the child it is creating, by the id it will insert, or the child it is
// deleting. It admits that record and its versions and variants and nothing
// else, so the collaborator reaches no other row of the owner's.
subject record_delegate { anchor project; reach self; identifies delegated_record; roles none; transient }
// THE MODELS A HOLDER REACHES FOR EVERY OWNER. A grant's reach says whose rows
// it covers: unwritten, the holder's own; all, every owner's. A record
// permission is held for every model or for the models a grant names, so the
// platform works out, once for a request, which models its holder reads, writes
// and deletes every owner's records of, from what the holder holds where the
// request stands, and mints them: a claim for every model (records_read_all),
// or the list of models these three are identified by. The record's rules read
// them where they once read whether a user was signed in, which kind of key
// was presented and which door the request came through.
//
// A set, so a request that touches records of two models is held to each
// model's own reach. Never minted from a header.
subject record_reader_all  { anchor project; reach self; identifies records_read_all_of;   roles none; transient set }
subject record_writer_all  { anchor project; reach self; identifies records_write_all_of;  roles none; transient set }
subject record_deleter_all { anchor project; reach self; identifies records_delete_all_of; roles none; transient set }

object project {
  table  projects
  level  project                 // the projects table IS the project node (self col = id)
  scoped tenant > project
  reach impersonation bound project for select
  reach impersonation unscoped for delete, insert, update
  // A project is STRUCTURE (a containment node), not users' content — so platform
  // staff see + manage it AMBIENTLY (the `staff` term → has_platform_role), exactly
  // like the `tenant` level-entity. Impersonation grants are reserved for the
  // CONTENT scoped beneath a project (records/files), not the project node itself.
  //
  // TTS-1023: `view` was `staff + tenant->owner + member + @session` — the last
  // three all gated on something OTHER than what the caller may DO.
  // `tenant->owner` compiled to the old workspace-owner definer and `member` to
  // the old project-role definer — both matches on the role KEYS of the four deleted
  // built-in role presets (TTS-1044) — and `@session` to a bare `id =
  // jwt.project_id`, a grant on the raw session claim with no lookup of any kind, so
  // forged claims sufficed. All three are replaced by the single capability the read
  // IS: @holds(projects:read).
  //
  // One term covers what three did: @holds is scope-keyed, and on a level entity
  // its project argument is the row's own id, so a TENANT-level assignment
  // (project_id NULL) satisfies it across the tenant (the old tenant->owner reach)
  // while a PROJECT-level one satisfies it at exactly that project (the old member
  // reach). projects:read is project-tier and a read — implied by project:manage (and
  // so by tenant:manage), and any composed role a tenant gives its readers can carry
  // it — so every console role that could see a project before keeps the read; a
  // CUSTOM role gains it iff its tenant put projects:read in it, which is the entire
  // point.
  //
  // The `guard status <> "CHURNED"` clause is gone with the terms it qualified:
  // demesne applies a guard only to `via role` / `via memberin` / `@session` terms,
  // so on a capability-only permission it would compile to nothing at all. It was
  // already inert in fact — CHURNED is a TENANT status (tenants.status); projects
  // only ever carry ACTIVE / DELETED — and a silently-inert clause is worse than an
  // absent one. The tenant object below keeps its own (live) CHURNED guard.
  // TTS-1047 split the single projects:write that gated all three writes. The four
  // permissions now name four verbs, tiered by whose act each operation is:
  // create/delete are TENANT-tier (they change which projects exist and consume the
  // plan's project quota); read/write are PROJECT-tier (they act on one project row
  // and are confined to it). A project:manage holder can therefore see AND rename
  // the project it manages, and can neither create nor destroy one.
  //
  // `delete` is the weakest of the four in practice: DeleteProject SOFT-deletes
  // (`UPDATE projects SET status = 'DELETED'`), so archival is decided by
  // projects_update — which a projects:write holder satisfies — and this policy
  // governs a hard DELETE no product path takes. The gate that carries archival is
  // the in-handler RequireVerb(projects:delete) in DeleteProject. See the vocabulary
  // comment on projects:delete; do not read this line as the archival gate.
  // The select arm stays unqualified: auth.projects_accessors enumerates this
  // permission, and the union enumerator cannot represent the conjunction that
  // pairs the staff arm with the role marker (the write arms below take it). A
  // staff account on a role of its own therefore reads the project row it
  // reaches, which the claim already confines to that one project.
  permission view   = @holds(platform:manage) + @holds(projects:read)               @rls maps select
  // Creating and deleting a project are the workspace's acts, so only a role
  // given across the workspace answers them. Asked here, @holds would key on the
  // row's own id, where a workspace role given in one project matches as well and
  // gives there what tenant:manage implies, projects:create and projects:delete
  // among it, though neither may be given below the workspace. Borrowed from the
  // workspace entity, whose only scope column is its own id, the question is
  // asked with no project at all.
  relation ws_create: member via object tenant->projectscreate on tenant_id for insert
  relation ws_delete: member via object tenant->projectsdelete on tenant_id for delete
  permission create = (@holds(platform:manage) and not @claim("staff_reach", "role")) + ws_create             @rls maps insert
  permission delete = (@holds(platform:manage) and not @claim("staff_reach", "role")) + ws_delete             @rls maps delete
  permission edit   = (@holds(platform:manage) and not @claim("staff_reach", "role")) + @holds(projects:write)              @rls maps update

  // ── Lent capability predicates (TTS-1023 / TTS-1039) ───────────────────────────
  // Predicate-only (they emit no policy of their own): they exist so a table
  // scoped at the TENANT level — operation_versions, whose project column is
  // provenance rather than an access key — can ask "does the caller hold <verb>
  // AT THE PROJECT THIS ROW BELONGS TO" through `via object project-><verb> on
  // <col>`, which a plain @holds on a tenant-scoped object cannot express.
  //
  // Why they are necessary: @holds keys on the object's DECLARED scope columns, so
  // a table scoped at the TENANT level cannot read the capability at the row's own
  // project — @holds there matches only a tenant-level assignment, locking every
  // project-scoped holder out. Borrowing the predicate from the PROJECT entity,
  // whose project axis is its primary key and is never null, resolves the verb at
  // the row's project without moving the object's own scope.
  // Every bridge here is CLAIM-PINNED: `@holds(<verb>) and @within(project)`.
  //
  // Both halves are load-bearing. @holds is the CAPABILITY (does the caller hold
  // the verb at this project) and @within is the CONTAINMENT (is this project the
  // one the session is in). @holds alone admits every project in the tenant to a
  // tenant-wide holder, because auth.member_has_perm treats a NULL project_id
  // assignment as a wildcard — which is the shape every tenant founder holds, and
  // the defect these pairs close. @within alone would be pure containment, which
  // TestBorrowedPermissionsAreNotPureContainment rejects, and rightly: a borrowed
  // permission named `project_can_*` that checks no authority reads as a gate and
  // is not one.
  //
  // On the project entity @within emits `id = <project claim>`, because scopeCol
  // resolves the level's own primary key when the object IS the level entity.
  permission opsread     = @holds(operations:read)   and @within(project)   @rls predicate
  permission opswrite    = @holds(operations:write)  and @within(project)   @rls predicate
  permission modelsread  = @holds(models:read)       and @within(project)   @rls predicate
  permission modelswrite = @holds(models:write)      and @within(project)   @rls predicate
  // Staff take the same pairing, and the reason is measured rather than assumed.
  // A bare @holds(platform:manage) was the branch that carried no project term on
  // `operations` and let a staff session standing in one project read another
  // project's operations. The same branch was missed on the model side: measured
  // on production afterwards, a platform:manage session standing in one project
  // still read all 145 models, 54 of them another project's. It is not
  // reintroduced here unpinned.
  //
  // One permission serves all four maps because platform:manage is a single verb,
  // not a read/write pair.
  permission modelsstaff = (@holds(platform:manage) and not @claim("staff_reach", "role")) and @within(project)  @rls predicate
  permission opsstaff    = (@holds(platform:manage) and not @claim("staff_reach", "role")) and @within(project)  @rls predicate
  // And the same for the service principal, which was the last of the four
  // unbounded disjuncts to be counted: it stood alone on the model permissions
  // carrying no project term while the same principal on `operations` sat under a
  // project term, so the two tables disagreed about one caller.
  permission modelsservice = @kind("service") and @within(project)  @rls predicate

}

// The users' data plane (EID-263: platform sharing retired). RLS is the
// fail-closed core — staff OR (tenant+project containment AND (app/service
// no-claim OR owner)). record_relationships stays STRUCTURAL (it grants no
// access); app-declared grants will ride the access descriptor (record_acl).
// PURE-RELATION MODEL (descriptor→relations epic): the access shape is composed
// from generic RELATIONS + terms, not the prescriptive `descriptor {}` block. The
// engine no longer prescribes "access = owner + visibility + grants" — these are
// ordinary relations over actor types, exactly as the control plane (project/tenant)
// already works. Byte-identical to the descriptor it replaces.
//   - owner: a UNIFIED (owner_id, owner_kind) principal reference — the same
//     (kind, id) shape the grant edge uses for grantees. owner_kind 'user' names a
//     person, in whichever pool they sign in to, and owner_id is their id in the
//     one users table, so it is matched against whichever id the caller carries.
//     'organization' names an organisation (org_owner below).
//   - grantee: the access-class grant relation over the UNIFIED resource_acl store
//     (discriminated by resource_type), to specific people of either pool; referenced
//     per access class (grantee:read|write|delete).
//   - mode access_mode = "public": binary visibility (private = owner+grants; public
//     = anyone reads) as a read-only column-condition term.
// Records take the org level, which is what makes the containment claim true of
// the DATA rather than only of the user directory. Everything derived from a
// record follows it below — the field index, the lookups, the geometry, the
// embeddings, the edges and the grants — because a reader who cannot see a
// record but can see its indexed values or match it on a similarity search has
// not been contained.

// Whether a row's owner is anyone but a console user. Holding every user's
// notifications reaches the users of the project's own pool and not a console
// user's inbox, which stays theirs: the row says only that a user owns it, so
// the owner's pool is asked. The body is in migration 20271015100000.
external predicate owner_outside_the_console(text)
// The level a record write lands at: the row sits at the level the request
// stands at, or it sits at the project's shared level and is owned by the
// organisation the request stands in. The record's update and delete floors ask
// it, and so does the records write gate, so the refusal a caller is told and
// the one the row layer makes are one answer. The body is in migration
// 20270812180000.
external predicate record_write_level_admits(text, text, text, text)
// The same question asked of a record's projection (a lookup, an index row, an
// edge, a point): it is written where its record is written. A projection sits
// at its record's level, so a projection at the shared level is written by the
// request its record's floor admits there. Body in the same migration.
external predicate record_projection_write_level_admits(text, text, text)
// Whether a request reads a record at the level it stands at. An
// organisation-owned record of the project's model sits at the shared level, so
// the containment term admits it at every organisation, and holding every
// record of its model, or a role in the organisation that owns it, then read
// one organisation's records from another's. A grant applies at the level it is
// held: a request standing at an organisation reads only the organisation-owned
// records of that organisation and the ones below it, as it reads only their
// contained rows, unless it stands as the project. Standing at the project
// reads them all. The body is in migration 20271026110000.
external predicate record_read_level_admits(text, text, text)
// Whether the reader of an event, or of a delivery of one, may know of the
// person it names: it names nobody, or the reader is that person or reaches
// them as the users rule's standing term asks. The body is in migration
// 20271114100000.
external predicate event_subject_reached(text)
// Whether a membership, by its organisation and its pool, reaches the caller's
// organisation: a membership at an organisation always passes (containment
// decides it), and one at the project passes for a caller at the project, a
// caller with the reach across organisations, or a caller at an organisation
// served the membership's pool. The body is in migration 20271114100000.
external predicate standing_reaches_the_callers_pool(text, text)
// Whether a row stands exactly where the request does: in the request's
// project, or, for a request at the workspace with no project, in none. A row
// with no project is the workspace's own, so a wildcard admits it for the
// workspace's callers; this keeps a caller in one project from reading or
// writing it, as the wildcard alone would let a key there. The body is in
// migration 20271125120000.
external predicate stands_in_the_requests_project(text, text)

object record {
  table  records
  // Update and delete take the shared tier too, and `require edit` and
  // `require delete` below floor them back to the level the request writes at.
  // The wildcard alone would let a request standing in one organisation change
  // every shared row; read the two together.
  scoped tenant > project > org wildcard confers select, insert, update, delete
  relation owner:       user | service via owner_id where owner_kind = "user"
  // The user a write is made for (owner_delegate, above).
  relation delegated_owner: owner_delegate via owner_id where owner_kind = "user"
  // The one record a write is made for (record_delegate, above), and its
  // versions and variants, which name it as their root.
  relation delegated_record: record_delegate via id
  relation delegated_slice:  record_delegate via root_id
  // Every owner's records of the row's model, for a holder whose grant says so
  // (the three sets above).
  relation reads_all:   record_reader_all  via model_key
  relation writes_all:  record_writer_all  via model_key
  relation deletes_all: record_deleter_all via model_key
  relation grantee:     user via grant resource_acl(resource_id, principal_kind, principal_id, access) where resource_type = "record" tracked
  // EID-364: composition cascade. A composed CHILD record (e.g. a tilly_block /
  // tilly_action whose `noteId` reference is kind:"composition") inherits the caller's
  // access to its PARENT — restoring the EID-243/245 read cascade (and the EID-72 write
  // cascade) onto the unified resource_acl foundation. The edge is the structural
  // record_relationships table (from = the child holding the reference, to = the parent
  // it points at); the cascade is strictly 1-hop (the engine composition-prunes the
  // parent predicate), matching Tilly's flat note→{block,action} shape and foreclosing
  // RLS recursion. Threaded at the calling verb: read cascades view, write cascades edit,
  // delete cascades delete — the same select/update/delete cascade the pre-Demesne RLS had.
  relation comp_parent: record via composition record_relationships(from_record_id, to_record_id) where kind = "composition"
  // EID-314: relationship-derived READ visibility — the app-author opt-in "borrow".
  // A reference field declared kind:"association_read" projects its edge with
  // kind="association_read"; this relation lets the REFERRING record borrow the
  // caller's READ access to the record it points AT — the cross-object visibility the
  // engine's `via object` primitive provides, expressed over the structural
  // record_relationships edge (Foir keeps all app models in one `records` table, so a
  // reference is an edge, not a column). Referenced ONLY by `view`: read-only, never
  // edit/create/delete. Strictly 1-hop (the engine composition-prunes the parent
  // predicate, base = withoutComposition), so it cannot chain or cycle — referencing a
  // record never confers more than the one declared read. Opt-in PER EDGE: a plain
  // association projects kind "association" and borrows nothing, preserving
  // record_relationships' structural-only stance (the privilege-escalation guard).
  relation read_borrow: record via composition record_relationships(from_record_id, to_record_id) where kind = "association_read"
  // A variant/version record is a SLICE of its canonical record, related by a
  // COLUMN (not a record_relationships edge), so comp_parent/read_borrow never
  // cover it and its own (default-private) access_mode gates it — a variant-
  // targeted lookup then returns EMPTY for a logged-in user (user_id set turns
  // off the @app_scope no-claim branch, and the private slice matches nothing).
  // access_mode belongs to the LOGICAL record; a slice borrows READ from its canonical
  // record so its visibility follows it.
  //
  // TTS-1547: this borrows via root_id, NOT parent_id, and that is load-bearing.
  // The slice chain is two deep, not one — a variant hangs off the record, and
  // ReparentVersionsToVariant moves that variant's versions onto the VARIANT
  // ("a variant created the ordinary way OWNS its versions"). A parent_id borrow is
  // severed one hop short for those versions: the engine composition-prunes the parent
  // predicate, so the intermediate variant is judged on its own private access_mode and
  // never on its own borrow. Anonymous readers never noticed (the @app_scope no-claim
  // branch covers them at every level); every signed-in user read an empty variant.
  // root_id names the canonical record directly, so the borrow stays strictly 1-hop —
  // the property that keeps this free of recursion and cycles — while being correct at
  // any slice depth. root_id is derived by trigger from parent_id, so it cannot drift.
  relation slice_root: record via composition records(id, root_id)
  // A MEMBER of the organization this row is contained in: a user holding
  // a role there. Membership carries the role (organization_members
  // → an org-pinned role_assignments row), and this is the row-layer half of
  // it: the role's scopes decide what the member may do, and this term is
  // what lets the row be reached at all. Without it a member reached only the
  // rows they personally owned or were granted, so every write to the pop-up's
  // own stock, orders and menu was refused as "no rows" while the role said
  // yes. Borrowed from the organizations object
  // rather than a memberin term, because the accessor enumeration this object
  // tracks composes through borrowed objects and grants, not memberships.
  relation org_member: organizations via object organizations->view on org_id
  // The organization's own settings: a row OWNED by the org (owner_kind =
  // "organization", org_id NULL: the organization owner plane) is READ by a
  // user holding a role in the org, the same way. Read, not edit or
  // create: an org-owned row is provisioned by the project, and editing it is
  // decided by what the user's role grants (org_writer, below). No
  // owner_kind guard: organization ids share no namespace with any person's
  // ids, so "a role holder in the org named by owner_id" is false on a
  // row owned by anyone else. A version or a variant of an org-owned record
  // carries its record's owner, id and kind alike.
  relation org_owner:  organizations via object organizations->view on owner_id
  // Who may EDIT the organization's own records: a user whose role there
  // grants writing the record's model, "*", "records:*", "records:write" or
  // "records:write:<model>", as the delegated write gate reads a role. Any
  // role at all reaches the row to read it, through the membership grant
  // org_owner borrows; that is not authority to change what the organization
  // owns, which is the role's permissions to grant, per model. The role is the
  // one the user's membership carries, inherited down the tree as the
  // membership grant is. The record object carries one grant relation, so
  // this borrows the organization_record_writer predicate over that view
  // rather than declaring a second.
  relation org_writer: user via object organization_record_writer->write on id
  // The same user ADDS a version or a variant when they edit a record that
  // versions: saving the edit inserts a row under the record, carrying its owner
  // at the shared level. org_writer names the row by its own id, and a row being
  // inserted is not there yet to be named, so this names the record it belongs
  // to by root_id, which the insert trigger derives from parent_id before the
  // check runs. A record itself has no root_id, so this adds no way to create
  // one.
  relation org_slice_writer: user via object organization_record_writer->write on root_id
  // EID-350: the resource_acl `tracked` feeds grant/revoke; `track owner`/`track
  // visibility` extend the changelog to the records TABLE so an owner transfer
  // (owner_id/owner_kind) and a visibility flip (access_mode) are event-driven for
  // the realtime force-drop too, not just the gateway's periodic re-check.
  track owner
  track visibility
  // WHOSE RECORDS A HOLDER REACHES.
  //
  // Each rule below is the same four answers, and none of them asks what kind
  // of caller the request has.
  //
  //   - Its own. A user's are the rows that user owns (owner), in whichever
  //     pool they sign in to. A holder that stands as the project (the stands
  //     claim: it acts for the project and for no person who signs in to an
  //     application) has the project's: every row no person owns.
  //   - What was opened to it. A record shared with it (grantee), one its
  //     organisation holds (org_member, org_owner, org_writer), a public one to
  //     read, and a record that is part of one it reaches or borrows from one
  //     (comp_parent, read_borrow, slice_root).
  //   - Every owner's, where its grant says all for the row's model
  //     (records_read_all, reads_all, and their write and delete twins).
  //   - The one owner or the one record the platform named for the request,
  //     after judging it (the three delegates).
  //
  // A user's own record is reached by its owner, by whoever it was opened to,
  // by a holder of all for its model and by a delegate, and by nobody else:
  // standing as the project does not reach it, and neither does belonging to
  // the organisation it sits in. It is held for every door, by asking what the
  // holder holds.
  //
  // The claims are minted by the platform from the holder's own grants and
  // never from a header. Each widens, so one that is absent admits nothing.
  //
  // This object enumerates conditionally: a claim admits readers no query can
  // name, so demesne emits records_accessors_conditional and withholds the
  // plain name. The handlers read the conditional form.
  //
  // view tests its columns and claims before it calls a function. Postgres
  // tries an OR's terms in the order they are written and stops at the first
  // true one, so a public row, or one read by a key that reads every record,
  // never pays for the organisation, grant and composition lookups. A version
  // row borrows this whole policy for its root, so the order counts once per
  // version read.
  //
  // Of the three composition lookups, slice_root comes first: it is the one
  // that admits a version or a variant, and those are the rows every
  // resolution reads. Each lookup is a definer Postgres plans afresh in every
  // query that calls it (about 5 to 12 ms on production, 15 October 2026), so a
  // query that reads one version and calls all three pays all three plannings
  // to find the answer the last one gives.
  permission view   = (@claim("stands", "project") and not @row(owner_kind, "user")) + owner + mode access_mode = "public" + @claim("records_read_all", "true") + reads_all + delegated_owner + delegated_record + delegated_slice + (org_member and not @row(owner_kind, "user")) + org_owner + grantee:read + slice_root + comp_parent + read_borrow   @rls maps select
  permission edit   = (@claim("stands", "project") and not @row(owner_kind, "user")) + owner + (org_member and not @row(owner_kind, "user")) + org_writer + grantee:write + comp_parent + @claim("records_write_all", "true") + writes_all + delegated_owner + delegated_record + delegated_slice   @rls        maps update
  // A new row is its creator's or the project's, as its model's plane says. A
  // holder of all for the model adds to what it may change: the version an
  // edit saves under somebody else's record. A row made for an owner the
  // creator is not, or by a creator who does not stand as the project and
  // makes a row that is the project's, is one of the delegates.
  permission create = (@claim("stands", "project") and not @row(owner_kind, "user")) + owner + (org_member and not @row(owner_kind, "user")) + org_slice_writer + @claim("records_write_all", "true") + writes_all + delegated_owner + delegated_record + delegated_slice   @rls        maps insert
  permission delete = (@claim("stands", "project") and not @row(owner_kind, "user")) + owner + (org_member and not @row(owner_kind, "user")) + grantee:delete + comp_parent + @claim("records_delete_all", "true") + deletes_all + delegated_owner + delegated_record + delegated_slice   @rls        maps delete
  // THE LEVEL A WRITE LANDS AT, AND THE ONE SHARED ROW AN ORGANISATION WRITES.
  //
  // What a request changes lands where it stands: at its organisation's level,
  // or at the project's shared level when it stands at the project. One kind of
  // row sits at the shared level on purpose and still belongs to an
  // organisation: an organisation-owned record of the project's model, which
  // auth.stamp_record_org leaves with org_id NULL so a project credential can
  // find it before it knows which organisation a request is for. Pinning update
  // and delete to `org_id IS NOT DISTINCT FROM claim` refused that row to the
  // organisation that owns it whenever the request was confined to that
  // organisation, and left it writable only from the project.
  //
  // So a write lands at the request's level when the row's org_id is the claim
  // (both absent, for a request at the project), or when the row sits at the
  // shared level and is owned by the organisation the request stands in:
  // owner_kind "organization" and owner_id equal to the org_id claim. That owner
  // test is the direct one, the rule organizationOwner already holds a create
  // to. It is not org_owner's organizations_can_view(owner_id): that is a VIEW
  // test, true for staff, for any console user holding settings:read in the project and
  // for any user holding a role in the owning organisation, wherever the
  // request stands, so
  // as a level test it would let a request confined to one organisation write a
  // row another organisation owns.
  //
  // This decides WHERE, never WHO. Who may write the row is the permission
  // above: org_writer lets a user whose role in the organisation grants
  // records:write on the model edit it and not delete it, the no-user
  // branch lets a service, a console user, a support session or a dispatch token
  // standing in the organisation do both, and any other user reaches it
  // only through a grant or a composition, as at the organisation's own level.
  //
  // WHY A FLOOR AND NOT A CONTAINMENT TERM. The containment grammar widens a
  // level only through the row's own level column (a NULL, or a reach set over
  // org_id), and this rule reads the owner columns. So the wildcard above takes
  // update and delete, and this restrictive floor takes them back. The predicate
  // is external because it must also pass a request that carries no organisation
  // claim, and no term tests a claim's absence. Every surface the write
  // predicate compiles to carries the floor: the two policies, record_can_edit,
  // and the write and delete arms of the composition borrows.
  require view      = @external(record_read_level_admits, owner_kind, owner_id, @org_id)
  require edit      = @external(record_write_level_admits, org_id, owner_kind, owner_id, @org_id)
  require delete    = @external(record_write_level_admits, org_id, owner_kind, owner_id, @org_id)
  // An insert lands at the same level. The stamp puts a new row where the
  // request stands, except a record the project's organisation-owned model
  // holds and that record's versions and variants, which stay at the shared
  // level with the record's owner; the stamp checks no owner for those, so
  // without this a request standing in one organisation could add a version or
  // a variant under a record another organisation owns. Every other insert the
  // stamp allows is already at the request's level, so this narrows that one.
  require create    = @external(record_write_level_admits, org_id, owner_kind, owner_id, @org_id)
  // EID-378: share-aware CREATE. records_insert is owner-only because the floor
  // cannot self-check a create that ESTABLISHES the composition edge — the edge
  // does not exist at WITH CHECK time. So creation is a PEP gate: authorized by the
  // caller's `edit` on the composition parent (CanEdit, equal by delegation),
  // resolved app-side from the new row's reference. Emits NO RLS (the floor is
  // unchanged); it is the CREATE analog of EID-72's share-aware UPDATE.
  gate create via comp_parent -> edit
  // EID-378 delete parity: removing a composition child (a recipient deleting a
  // line) is the same collaboration need as adding one, so gate it on `edit` of the
  // parent too. records_delete's own cascade only honors a `delete` grant; this gate
  // is what lets a WRITE-grantee remove a child. Unlike create, the edge exists at
  // delete time, so it is enforced via the edge-based comp_parent definer.
  gate delete via comp_parent -> edit
  // Layer 2 (PDP): a verb RLS can't distinguish (publish ≡ update to the row engine).
  permission publish = records:publish   @pdp
}

// The users whose role in an organisation grants writing a record's model,
// per record the organisation owns: the view organization_member_record_writes
// (migration 20270814190000), one row per record and user. A predicate
// only, borrowed by the record's edit as org_writer; it emits no policy, since
// a view carries none.
object organization_record_writer {
  table  organization_member_record_writes
  pk     resource_id
  scoped tenant > project
  relation writer: user via principal_id
  permission write = writer   @rls predicate
}

// The UNIFIED grant store (resource_acl), governed as its OWN object so the WRITE
// path is moat-preserving. Replaces the placeholder `settings record_acl`
// (containment-only, which let any in-scope console user grant on any record). A grant row
// may be written / listed / revoked ONLY by a principal who can `edit` the resource
// it points at — enforced by @store_manage, which the engine compiles to a per-kind
// dispatch (auth.resource_acl_manage(resource_type, resource_id) → the kind's
// can-edit, fail-closed). The set of kinds is the descriptor objects on this store
// (record today; file/notes as they adopt the descriptor). The descriptors' READ
// definers (auth.resource_acl_grants_<kind>) are SECURITY DEFINER and bypass these
// policies, so resource reads are unaffected.
object resource_grant {
  table  resource_acl
  pk     (resource_type, resource_id, principal_kind, principal_id, access)   // composite PK — no single-col row identity (EID-371 §4.1)
  scoped tenant > project > org wildcard confers select, insert
  permission view   = @store_manage   @rls maps select
  permission create = @store_manage   @rls maps insert
  permission edit   = @store_manage   @rls maps update   // inert (grant tuples are immutable); keeps resource_acl_update regenerated, not orphaned
  permission delete = @store_manage   @rls maps delete
}

object record_lookup {
  table  record_lookups
  pk     (tenant_id, project_id, model_key, lookup_name, channel, scope_key, variant_id, locale, key_hash)   // no PK; natural identity is this unique index (EID-371 §4.1)
  scoped tenant > project > org wildcard confers select, insert, update, delete
  relation owner: user | service via owner_id where owner_kind = "user"
  // Every owner's records of the row's model, for a holder whose grant says so
  // (see record).
  relation reads_all:  record_reader_all via model_key
  relation writes_all: record_writer_all via model_key
  // A lookup row is an indexed POINTER to its record, so READ follows the record
  // itself: whoever can view the record can resolve a pointer at it — public,
  // granted and composed reach included, evaluated AT the record via the engine's
  // cross-object accessor, never denormalised onto this table where it could go
  // stale. Without this arm the bare user-owned view leaves a signed-in
  // user the owner term only, so a typed lookup on a public record returns
  // empty the moment a user claim is present — anonymous reads more than
  // authenticated, the non-monotonic footgun. Writes stay user-owned: only
  // the app plane and the owning user materialise or retire pointers.
  relation rec: record via object record->view on record_id
  // Writes follow the record's EDIT, not just its owner: the write coda
  // re-emits projection rows inside the caller's own RLS transaction, and the
  // rows mirror the RECORD's owner — so a share-grantee's legitimate write
  // (grantee:write on the record, or a composition child re-emitting its
  // parent) produced rows the bare owner arm refused, failing the whole
  // mutation. Whoever may edit the record may maintain its pointers; a
  // user with no edit reach on the record still cannot touch them.
  relation rec_edit: record via object record->edit on record_id
  // A projection is reached as its record is. It carries the record's owner
  // and model, so the three answers that need no lookup are asked of the row
  // itself, and rec asks the record for the rest.
  permission view   = (@claim("stands", "project") and not @row(owner_kind, "user")) + @claim("records_read_all", "true") + reads_all + owner + rec        @rls maps select
  permission create = (@claim("stands", "project") and not @row(owner_kind, "user")) + @claim("records_write_all", "true") + writes_all + owner + rec_edit   @rls maps insert
  permission edit   = (@claim("stands", "project") and not @row(owner_kind, "user")) + @claim("records_write_all", "true") + writes_all + owner + rec_edit   @rls maps update
  permission delete = (@claim("stands", "project") and not @row(owner_kind, "user")) + @claim("records_write_all", "true") + writes_all + owner + rec_edit   @rls maps delete
  // A projection is written where its record is written: at the request's own
  // level, or at the shared level when its record is one the request's
  // organisation owns. The record's write coda maintains these rows inside the
  // writer's transaction, so without this the organisation that may now write
  // its shared record would be refused its record's projections. See the
  // record object's floor for why a floor and not a containment term.
  require edit      = @external(record_projection_write_level_admits, org_id, record_id, @org_id)
  require delete    = @external(record_projection_write_level_admits, org_id, record_id, @org_id)
}

object record_field_index {
  table  record_field_index
  pk     (record_id, field_path)   // composite PK (EID-371 §4.1)
  scoped tenant > project > org wildcard confers select, insert, update, delete
  relation owner: user | service via owner_id where owner_kind = "user"
  // Every owner's records of the row's model, for a holder whose grant says so
  // (see record).
  relation reads_all:  record_reader_all via model_key
  relation writes_all: record_writer_all via model_key
  // Same READ shape as record_lookup, for the same reason: an index row is a
  // projection of its record, and the Tier-2 filter splices an EXISTS on this
  // table into the records list query — under RLS, an invisible index row makes
  // the filter false, so a record the caller CAN view silently drops out of any
  // non-equality filtered list the moment a user claim is present. READ
  // follows the record; writes stay user-owned (the write coda mirrors the
  // record's owner onto the row).
  relation rec: record via object record->view on record_id
  // Same write shape as record_lookup, for the same coda: index maintenance
  // runs in the writer's RLS transaction and rows mirror the record's owner,
  // so writes follow the record's EDIT reach rather than owner-only.
  relation rec_edit: record via object record->edit on record_id
  // A projection is reached as its record is. It carries the record's owner
  // and model, so the three answers that need no lookup are asked of the row
  // itself, and rec asks the record for the rest.
  permission view   = (@claim("stands", "project") and not @row(owner_kind, "user")) + @claim("records_read_all", "true") + reads_all + owner + rec        @rls maps select
  permission create = (@claim("stands", "project") and not @row(owner_kind, "user")) + @claim("records_write_all", "true") + writes_all + owner + rec_edit   @rls maps insert
  permission edit   = (@claim("stands", "project") and not @row(owner_kind, "user")) + @claim("records_write_all", "true") + writes_all + owner + rec_edit   @rls maps update
  permission delete = (@claim("stands", "project") and not @row(owner_kind, "user")) + @claim("records_write_all", "true") + writes_all + owner + rec_edit   @rls maps delete
  // Written where its record is written; see record_lookup.
  require edit      = @external(record_projection_write_level_admits, org_id, record_id, @org_id)
  require delete    = @external(record_projection_write_level_admits, org_id, record_id, @org_id)
}

// ── User-owned satellites folded under the spec (Landing 2, Wave A) ──────────────
// Previously hand-written RLS. CONVERGENCE, not preservation: the asymmetric
// owner-widening of the old policies is normalised to the uniform user-owned
// shape. This CLOSES real leaks across users — segment_memberships /
// segment_preferences SELECT+DELETE and the then provider-identities table UPDATE+DELETE
// previously had NO owner term, so an in-project user could read/delete other
// users' rows. The owner term now applies on every op.
// A device token belongs to the user it pushes to.
object device_token {
  table  device_tokens
  scoped tenant > project > org wildcard confers select, insert
  relation owner: user | service via owner_id where owner_kind = "user"
  // Where the device's person stands, read as the users rule reads it: a
  // device stands at the project, so its own row says nothing of who may
  // reach it.
  relation owner_stands: user_standing via object user_standing->stands on owner_id for select
  // A device is registered by its own person, or by an app for them. Reading,
  // changing or removing one is its person's, or a caller's that reaches its
  // person: an app acting for nobody, or whoever sends to every person.
  permission view   = owner + ((@app_scope + @holds(notifications:write.all) + @claim("notifications_write_all", "true")) and owner_stands)   @rls maps select
  permission create = @app_scope + owner                                                                             @rls maps insert
  permission edit   = owner + ((@app_scope + @holds(notifications:write.all) + @claim("notifications_write_all", "true")) and owner_stands)   @rls maps update
  permission delete = owner + ((@app_scope + @holds(notifications:write.all) + @claim("notifications_write_all", "true")) and owner_stands)   @rls maps delete
}
// A preference belongs to a PERSON, so it takes `notification`'s two-plane shape
// for the same reasons, and it needs both halves of that shape at once.
//
// `wildcard` so project_id may be NULL, meaning the row covers every project in
// the workspace. Plain `> project` forced every row to name one project, which
// made "tell me about this workspace" unexpressible and left a workspace-wide
// announcement — which has no project to stamp — with no preference to consult
// at all, so it was admitted unconditionally.
//
// A console user's preferences are theirs alone, as their inbox is: holding
// every user's preferences reaches the users of the project's own pool
// (owner_outside_the_console), so no console user reads or changes another's.
//
// `create` follows `notification` in not asking the owner's pool: it is the one
// op where the writer may legitimately not be the owner, and privacy is
// enforced on read.
object notification_preference {
  table  notification_preferences
  scoped tenant > project wildcard > org wildcard confers select, insert
  relation owner:       user | service via owner_id where owner_kind = "user"
  // The one user a write is made for, where the platform judged the caller
  // may write for a user it names (see `subject owner_delegate`). It reads
  // that user's rows too: a send reads what its recipient chose to be told of
  // before it writes anything for them.
  relation delegated_owner: owner_delegate via owner_id where owner_kind = "user"
  // Where the person the row is for stands, read as the users rule reads it.
  // A choice stands where it was made, and one made at the project answers
  // for every place, so its own row says nothing of who may reach its person.
  relation owner_stands: user_standing via object user_standing->stands on owner_id for select
  // WHOSE ROWS A HOLDER REACHES is what it holds. A person reaches their own.
  // Every user's is the reach a grant says, worked out from what the holder
  // holds and read here as a claim; it is every application user's that the
  // holder reaches (owner_stands), and not a console user's own, which stays
  // theirs alone as it was. Writing a row for somebody else is the write of
  // every user's, which is what sending is, or the write for one user the
  // request names.
  permission view   = owner + (@claim("notifications_read_all", "true") and owner_stands) + delegated_owner   @rls maps select
  permission edit   = owner + (@claim("notifications_write_all", "true") and @within(project) and owner_stands) + delegated_owner   @rls maps update
  permission delete = owner + (@claim("notifications_write_all", "true") and @within(project) and owner_stands)   @rls maps delete
  // A console user's own is theirs alone: a row whose owner signs in to the
  // console is reached by its owner and by nobody else's reach.
  require view      = owner + @external(owner_outside_the_console, owner_id)
  require edit      = owner + @external(owner_outside_the_console, owner_id)
  require delete    = owner + @external(owner_outside_the_console, owner_id)
  permission create = owner + @claim("notifications_write_all", "true") + delegated_owner                        @rls maps insert
}

// ── Users ──────────────────────────────────────────────────────────────────────
//
// Everyone who signs in is a row of `users`, in one identity pool. The table
// holds two populations, and one object serves both:
//
//   a project's own users   The row carries its workspace and project, and is
//                           held to them like any other project table.
//   the console's users     The platform's pool, which the console signs in to.
//                           The row carries no workspace: a console user is in
//                           none, and is reached through the workspaces and
//                           projects they hold a role in.
//
// `tenant wildcard > project wildcard` is what lets one object hold both: a
// row with no workspace passes containment for every caller, and what admits
// it is then its own terms. So every term names the pool it is for. A term for
// a project's users also names the project (`@within(project)`), which a row
// of the platform's pool cannot satisfy, and a term for the console's users
// names the platform's pool. Neither set of rules reaches the other's rows.
//
// A USER HOLDS NO ORGANISATION. Where a user stands is a membership, so an
// organisation's confinement cannot be read off the user's own row. It is read
// off their memberships: `stands` asks whether the caller's containment admits
// any place this user stands, which is the question the organisation column
// once answered and is asked of the same claim. A caller confined to one
// organisation reaches the users who stand in it or at the project, and one at
// the project with no organisation reaches those who stand at the project,
// unless it holds the reach across organisations. It only ever narrows: it
// sits beside the term that says who is asking, and admits nobody by itself.
//
// A user reads their own row wherever they stand. What a holder reaches of
// other people's is what it holds, for every kind of holder: a console user's
// role is asked through @holds, and a key's, an operation's and a platform
// process's reach is worked out from what each holds and arrives as a claim.
// The last term of each rule is what the release before asked, any caller that
// was a service, and answers a request that release built and no other.
//
// THE USER A WRITE MAKES. Making a user is a write, and a write reads the row
// it makes. A new user stands nowhere until their membership is written a
// statement later, so `stands` would hide them from whoever is making them.
// The platform names the one user this transaction makes (see `subject
// user_made`), and that user and what hangs from them is read and written by
// its maker for that transaction.
//
// THE CONSOLE'S DIRECTORY. A console user is visible to staff, to themselves,
// to whoever holds members:read across a workspace they stand in (`roster`: the
// standing is the directory and the capability is the gate, so the two move
// together or any member of a workspace would see every other), and to the
// others who stand at a project they stand at (`peer`). Both read memberships
// (see workspace_roster). They change their own row, and only staff make or
// remove one.
object user_standing {
  table  memberships
  pk     user_id
  scoped tenant > project > org wildcard confers select, insert
  // A membership at the project reaches a caller confined to an organisation
  // only where the organisation is served the pool the membership is in: an
  // organisation that shares the project's pool reads the project's people,
  // and one with a pool of its own reads only those who are members of it.
  permission stands = @scoped   @rls predicate
  require stands    = @external(standing_reaches_the_callers_pool, org_id, pool_id)
}

// Whether the person a request acts for stands in a project: an active
// membership there, at the project or at an organisation in it, in any pool.
// A predicate object, borrowed by a row's project, so "a person of this
// project" is decided from where the person stands and never from what kind of
// person they are.
object project_standing {
  table  memberships
  pk     project_id
  scoped tenant > project
  relation self: user via user_id
  permission stands = self and @row(status, "active")   @rls predicate
}

object users {
  table  users
  scoped tenant wildcard > project wildcard
  relation self:   user via id
  // The one user a request names, where the platform judged the caller may
  // name one (see `subject user_named` above).
  relation named:  user_named via id
  relation made:   user_made via id
  relation stands:       user_standing via object user_standing->stands on id for select
  relation stands_exact: user_standing via object user_standing->stands on id
  relation roster:       member via object workspace_roster->roster on id
  relation peer:         member via object project_peer->peer on id
  // The staff arm among a project's users is there for the same reason as in
  // `template billing` above, and with the same bound: an approved grant
  // carries containment and no permission, so without it a support engineer
  // opening a workspace to look into a user's problem cannot see the user.
  // Read only.
  permission view   = ((self + made + (((@holds(platform:manage) and not @claim("staff_reach", "role")) + @holds(users:read.all) + @claim("users_read_all", "true") + named) and stands)) and @row(pool_kind, "application") and @within(project)) + ((@holds(platform:manage) + self + roster + peer) and @row(pool_kind, "platform"))   @rls maps select
  permission create = ((@holds(users:create) + @claim("users_create", "true")) and @row(pool_kind, "application") and @within(project)) + (@holds(platform:manage) and @row(pool_kind, "platform"))   @rls maps insert
  permission edit   = ((self + made + ((@holds(users:write.all) + @claim("users_write_all", "true")) and stands_exact)) and @row(pool_kind, "application") and @within(project)) + ((@holds(platform:manage) + self) and @row(pool_kind, "platform"))   @rls maps update
  permission delete = (((@holds(users:delete.all) + @claim("users_delete_all", "true")) and stands_exact) and @row(pool_kind, "application") and @within(project)) + (@holds(platform:manage) and @row(pool_kind, "platform"))   @rls maps delete
}

// What a user is known by. An identifier is read and changed by whoever may
// read and change its user, in either pool: the rule is borrowed from the
// user's own row, so there is one place it is written.
object user_identifiers {
  table  user_identifiers
  scoped platform
  relation of_user:    users via object users->view on user_id
  relation edits_user: users via object users->edit on user_id
  relation made:       user_made via user_id
  permission view   = of_user + made      @rls maps select
  permission create = edits_user + made   @rls maps insert
  permission edit   = edits_user + made   @rls maps update
  permission delete = edits_user          @rls maps delete
}

// How a person signs in, and what is sent to them on the way. These hold
// secrets (a password's hash, the codes a person is sent, a provider's stored
// tokens), so they are not read as their user's row is: a console user's row
// is seen by the other members of a project they share, and their password is
// not. A person reads and changes their own. In a project's pool, whoever
// holds the project's users reaches them, reading on users:read.all and
// changing on users:write.all, as does a caller that carries no person and acts
// for the project (`@app_scope`). In the platform's pool, staff do, and no rule
// admits making one: a password or a link made for somebody else is a sign-in
// somebody else chose for them, and one a person writes for themselves skips
// the password change that checks the old one and is rate limited. The
// sign-in itself writes on a connection these rules do not govern.
object sign_in_methods {
  table  sign_in_methods
  scoped tenant wildcard > project wildcard
  relation self:         user via user_id
  relation made:         user_made via user_id
  permission view   = ((self + made + @app_scope + (@holds(users:read.all) + @claim("users_read_all", "true"))) and @row(pool_kind, "application") and @within(project)) + (((@holds(platform:manage) and not @claim("staff_reach", "role")) + self) and @row(pool_kind, "platform"))   @rls maps select
  permission create = (self + made + @app_scope + (@holds(users:write.all) + @claim("users_write_all", "true"))) and @row(pool_kind, "application") and @within(project)   @rls maps insert
  permission edit   = ((self + made + @app_scope + (@holds(users:write.all) + @claim("users_write_all", "true"))) and @row(pool_kind, "application") and @within(project)) + (((@holds(platform:manage) and not @claim("staff_reach", "role")) + self) and @row(pool_kind, "platform"))   @rls maps update
  permission delete = ((self + made + @app_scope + (@holds(users:write.all) + @claim("users_write_all", "true"))) and @row(pool_kind, "application") and @within(project)) + (((@holds(platform:manage) and not @claim("staff_reach", "role")) + self) and @row(pool_kind, "platform"))   @rls maps delete
}

// The same rule as sign_in_methods, for the same reason.
object user_credentials {
  table  user_credentials
  scoped tenant wildcard > project wildcard
  relation self:         user via user_id
  relation made:         user_made via user_id
  permission view   = ((self + made + @app_scope + (@holds(users:read.all) + @claim("users_read_all", "true"))) and @row(pool_kind, "application") and @within(project)) + (((@holds(platform:manage) and not @claim("staff_reach", "role")) + self) and @row(pool_kind, "platform"))   @rls maps select
  permission create = (self + made + @app_scope + (@holds(users:write.all) + @claim("users_write_all", "true"))) and @row(pool_kind, "application") and @within(project)   @rls maps insert
  permission edit   = ((self + made + @app_scope + (@holds(users:write.all) + @claim("users_write_all", "true"))) and @row(pool_kind, "application") and @within(project)) + (((@holds(platform:manage) and not @claim("staff_reach", "role")) + self) and @row(pool_kind, "platform"))   @rls maps update
  permission delete = ((self + made + @app_scope + (@holds(users:write.all) + @claim("users_write_all", "true"))) and @row(pool_kind, "application") and @within(project)) + (((@holds(platform:manage) and not @claim("staff_reach", "role")) + self) and @row(pool_kind, "platform"))   @rls maps delete
}

// The names people give their own security keys and passkeys that the
// identity store holds, which cannot rename a key itself. Read and changed as
// sign_in_methods are, except that a person names their own in either pool:
// a name is no secret and signs nobody in, so the reason no rule makes a
// sign-in method in the platform's pool does not hold for it.
object factor_names {
  table  factor_names
  scoped tenant wildcard > project wildcard
  relation self:         user via user_id
  relation made:         user_made via user_id
  permission view   = ((self + made + @app_scope + (@holds(users:read.all) + @claim("users_read_all", "true"))) and @row(pool_kind, "application") and @within(project)) + (((@holds(platform:manage) and not @claim("staff_reach", "role")) + self) and @row(pool_kind, "platform"))   @rls maps select
  permission create = ((self + made + @app_scope + (@holds(users:write.all) + @claim("users_write_all", "true"))) and @row(pool_kind, "application") and @within(project)) + (((@holds(platform:manage) and not @claim("staff_reach", "role")) + self) and @row(pool_kind, "platform"))   @rls maps insert
  permission edit   = ((self + made + @app_scope + (@holds(users:write.all) + @claim("users_write_all", "true"))) and @row(pool_kind, "application") and @within(project)) + (((@holds(platform:manage) and not @claim("staff_reach", "role")) + self) and @row(pool_kind, "platform"))   @rls maps update
  permission delete = ((self + made + @app_scope + (@holds(users:write.all) + @claim("users_write_all", "true"))) and @row(pool_kind, "application") and @within(project)) + (((@holds(platform:manage) and not @claim("staff_reach", "role")) + self) and @row(pool_kind, "platform"))   @rls maps delete
}

// Where a person stands. A membership is read by its own user, by whoever
// reads the users of its place, and by whoever may view the organisation it
// is at, which is how an organisation's own people see who is in it. It is
// written by whoever may change users there, and by whoever is making the
// user it is the first membership of.
//
// `project wildcard`, as the roles a membership holds are: a membership at a
// workspace names no project. A role is asked through @holds, which is keyed
// on the row's own project, so a workspace-wide row asks for workspace-wide
// authority. A reach that arrives as a claim says nothing of where it was
// given, so each such arm names the project: a credential of one project
// writes no membership at the workspace.
//
// A key or an operation holds no role, so no @holds term answers for it. What
// it reaches is worked out from what it holds and arrives as a claim: one that
// reads or changes every user's account, or one that reads or changes who is
// in a place. Either is held to the project the claims name and to the rows of
// an application's own users: such a caller never writes a console user's
// membership.
//
// IT IS THE REGISTRY OF WHO IS IN AN ORGANISATION, and it is confined the way
// the registry is and not by the organisation axis. A credential confined to
// one organisation reaches strictly downward: the memberships at its own
// organisation and at every one beneath it, never a parent's, a sibling's or
// the project's own. One that carries no organisation reaches the whole
// project (`missing allow`), which is what lets whoever manages the
// project read and staff any organisation in it by naming it, without
// standing there first. The axis would hide every organisation's memberships
// from a caller at the project, and a roster that reads as empty is worse
// than one that is refused.
//
// The users themselves stay on the axis (`user_standing`, which reads this
// table for the users object): a caller confined to one organisation reads
// the users who stand in it, beneath it or at the project.
object memberships {
  table  memberships
  scoped tenant > project wildcard
  relation self:     user via user_id
  relation made:     user_made via user_id
  // The one user a request names, where the platform judged the caller may
  // name one: whoever reads that user reads where they stand.
  relation named:    user_named via user_id
  relation org_view: organizations via object organizations->view on org_id
  relation confined: service via closure organization_closure(ancestor_id, descendant_id) on org_id from claim org_id missing allow
  permission view   = self + (made and @within(project)) + (named and @within(project)) + (@holds(platform:manage) and not @claim("staff_reach", "role")) + @holds(members:read) + @holds(users:read.all) + (@claim("users_read_all", "true") and @within(project) and confined) + (@claim("members_read", "true") and @within(project) and @row(pool_kind, "application") and confined) + org_view   @rls maps select
  permission create = (made and @within(project)) + (@holds(platform:manage) and not @claim("staff_reach", "role")) + @holds(members:write) + @holds(users:write.all) + (@claim("users_write_all", "true") and @within(project) and confined) + (@claim("members_write", "true") and @within(project) and @row(pool_kind, "application") and confined)   @rls maps insert
  permission edit   = (@holds(platform:manage) and not @claim("staff_reach", "role")) + @holds(members:write) + @holds(users:write.all) + (@claim("users_write_all", "true") and @within(project) and confined) + (@claim("members_write", "true") and @within(project) and @row(pool_kind, "application") and confined)   @rls maps update
  permission delete = (@holds(platform:manage) and not @claim("staff_reach", "role")) + @holds(members:write) + @holds(users:write.all) + (@claim("users_write_all", "true") and @within(project) and confined) + (@claim("users_delete_all", "true") and @within(project) and confined) + (@claim("members_write", "true") and @within(project) and @row(pool_kind, "application") and confined)   @rls maps delete
}

// A request to join an organisation that takes them (join_requests), made by
// signing in at its page. It is confined the way the registry of who is in an
// organisation is: a caller confined to one organisation reaches the requests
// at it and beneath it, and one at the project every organisation's. The
// person asking reads their own; whoever reads an organisation's members reads
// its requests, and whoever writes them settles one. The platform makes a
// request at sign-in, past row security, so nothing here admits a create.
object join_requests {
  table  join_requests
  scoped tenant > project
  relation self:     user via user_id
  relation confined: service via closure organization_closure(ancestor_id, descendant_id) on org_id from claim org_id missing allow
  permission view = self + ((@holds(members:read) + (@claim("members_read", "true") and @within(project))) and confined)   @rls maps select
  permission edit = (@holds(members:write) + (@claim("members_write", "true") and @within(project))) and confined   @rls maps update
}

// The pools of a project: its own, and any an organisation of it has started.
// A pool is a declaration, and it composes as one: an organisation is served
// its own pool, the pools of the organisations above it and the project's,
// which are the ones a sign-in there can be for, and never a sibling's. A pool
// is started and dropped by the platform after it has judged the caller, so no
// policy admits a write.
object identity_pools {
  table  identity_pools
  scoped tenant > project > org wildcard confers select
  reach ancestry via inheritance for select
  permission view = @scoped   @rls maps select
}

// ── The org REGISTRY (TTS-1895) ────────────────────────────────────────────────
// The FOUR tables that describe orgs, NOT tables that live inside one:
// organizations, organization_members, organization_limits and
// organization_provisions. (It said "three" until the provisioning ledger
// joined them; the count is spelled out because the last one drifted.)
//
// `scoped tenant > project`, deliberately NOT `> org`. An organizations row IS an
// org's identity; scoping it to org would make an org's own row invisible to the
// project's manager who runs it, and organization_members is the very table
// that decides who is in an org — reading it through an org claim is circular.
// The data partitions have since opted in (forty-one objects now carry the axis, see
// the topology block), and these four still stay where they are.
//
// OPEN, and recorded here rather than left silent: what an ORG-CONFINED caller
// may see OF the registry. Today the policies ask for a project claim and the
// settings verbs, so a confined credential reads the registry through the
// service arm below and not on its own account. The unanswered half is whether
// such a caller should be able to read its OWN organizations row, its OWN
// members and its OWN limits — a self-read, not a partition — and if so whether
// descendants come with it. Nobody has needed it yet, which is why it is a
// question and not a policy; it is written down because the shape of the answer
// (a self-read arm keyed on the org claim) is NOT the same shape as opting these
// tables into the axis, and an audit that finds only silence here will propose
// the second.
//
// Gated on the SETTINGS verbs rather than `use contained`, same reasoning as
// email_copy_override above: managing the tenants of a SaaS built on Foir is
// project configuration, and bare containment would make these policies satisfiable
// by a project claim alone with no verb behind it.
//
// THE SERVICE ARM CANNOT BE THE ONE `users` CARRIES. There, `scoped tenant >
// project > org wildcard` puts a containment conjunct ABOVE the OR-group, so a
// bare @kind("service") disjunct is already bounded by the caller's organization.
// The registry has no org level and deliberately never will, for the reason just
// given. A bare service disjunct here would therefore let a credential CONFINED to
// one organization enumerate every organization of the project, its siblings and
// its ancestors included — the enumeration oracle this level exists to refuse. So
// the arm carries containment explicitly, through the closure relations below.
//
// Without such an arm there is no @kind("service") term at all, and an api key or
// a forwarded service principal passes every handler gate and then reads nothing:
// withheld content reading as zero, arriving through the surface meant to fix it.
object organizations {
  table  organizations
  scoped tenant > project
  // A service credential confined to an organization reaches strictly downward:
  // its own organization and every descendant, never a parent or a sibling.
  // `missing allow` is what makes an unconfined credential — one carrying no
  // org_id — reach the whole project, which is what every service credential
  // does today.
  relation confined: service via closure organization_closure(ancestor_id, descendant_id) on id from claim org_id missing allow
  // INSERT asks the same question of a DIFFERENT column, and it is a real
  // difference rather than a special case. On insert the new row's own id was
  // minted microseconds ago and the closure trigger has not run, so there is no
  // (ancestor, descendant) pair to find and a check against `id` would refuse
  // every create, including an unconfined credential's. What an insert can
  // answer is WHERE the organization is being hung, which is parent_id. Asking
  // it there is also what makes a confined credential's creates land strictly
  // BELOW its own organization, with a root create (parent_id NULL) refused by
  // the same predicate rather than by a second rule that could disagree.
  relation confined_parent: service via closure organization_closure(ancestor_id, descendant_id) on parent_id from claim org_id missing allow
  relation named: organization_named via id
  // THE MEMBERSHIP IS THE GRANT. organization_members says who acts for an
  // organization and as what; organization_member_grants is that table in
  // grant shape (resource = the org, principal = the user, access =
  // "operate"), limited to memberships carrying a role. It joins `view` — an
  // org's member may read their own organization's row, and only that one — and
  // `view` is what records and files borrow, by their org_id (org-owned rows
  // by their owner_id), to say "a member of this organization may reach
  // me". A borrow is enumerable only through the select verb, which is why
  // it is `view` and not a verb of its own. Containment sits above every
  // term, so the borrow reaches nothing outside the organization the caller
  // stands in; the role's scopes decide how far a reach goes per model, above
  // the row layer.
  relation member: user via grant organization_member_grants(resource_id, principal_kind, principal_id, access)
  // The one tenant-contained staff arm left unqualified. `record` borrows this
  // permission through org_member for its accessor enumeration, and the engine
  // cannot enumerate `(@holds(platform:manage) and not @claim(...))`: it drops
  // both leaves as narrowing and is left with no relational term. Records
  // already admit any console user holding the claim through @app_scope, so the borrow
  // opens nothing there; what stays open is reading this project's organisation
  // rows. The verb gates in front of every organisation read hold a staff
  // account on its own role to organizations:read.
  permission view   = @holds(platform:manage) + @holds(organizations:read) + member:operate   @rls maps select
  // Making an organisation is its own permission, apart from changing or
  // removing the ones there are: a holder of the create adds a row and cannot
  // touch another.
  permission create = (@holds(platform:manage) and not @claim("staff_reach", "role")) + @holds(organizations:create)   @rls maps insert
  // Scheduling an organisation's deletion is its own permission too, and it is
  // a change of the row's status: a holder of the delete alone writes the row.
  // Which change each holder may make is the verb's to hold. Removing a row is
  // the delete's, and no verb a caller reaches removes one: the sweep does,
  // once a scheduled deletion has come due.
  // orgsettings:write changes the row as well: an organisation's name, how it
  // is presented, its joining and its sign-in rules. Which of its columns each
  // permission may change is the gate's to charge.
  permission edit   = (@holds(platform:manage) and not @claim("staff_reach", "role")) + @holds(organizations:write) + @holds(organizations:delete) + @holds(orgsettings:write)   @rls maps update
  permission delete = (@holds(platform:manage) and not @claim("staff_reach", "role")) + @holds(organizations:delete)   @rls maps delete
  admit select, update, delete = @kind("service") and @within(tenant) and @within(project) and confined
  admit insert                = @kind("service") and @within(tenant) and @within(project) and confined_parent
  // The organisation a judged create names, read by whoever is making it (see
  // `subject organization_named`). It is an arm of the select alone and not
  // of `view`, which records, files and memberships borrow: naming the row
  // being made lends nothing of what an organisation holds.
  admit select                = @within(tenant) and @within(project) and named
  export edit as organization_registry_write_allowed(id text as check_org_id, tenant_id text as row_tenant_id, project_id text as row_project_id)
  // The insert's own predicate, exported for the one fact that is recorded
  // about an organisation by whoever made it: that it was made. Every other
  // fact about an organisation is recorded by whoever may change it.
  export create as organization_registry_create_allowed(id text as check_org_id, tenant_id text as row_tenant_id, project_id text as row_project_id, parent_id text as row_parent_id)
}

// Per-org quotas the project's manager sets. Same registry treatment.
object organization_limits {
  table  organization_limits
  pk     (org_id, metric)
  scoped tenant > project
  relation confined: service via closure organization_closure(ancestor_id, descendant_id) on org_id from claim org_id missing allow
  permission view   = (@holds(platform:manage) and not @claim("staff_reach", "role")) + @holds(organizations:read)    @rls maps select
  permission create = (@holds(platform:manage) and not @claim("staff_reach", "role")) + @holds(organizations:write)   @rls maps insert
  permission edit   = (@holds(platform:manage) and not @claim("staff_reach", "role")) + @holds(organizations:write)   @rls maps update
  permission delete = (@holds(platform:manage) and not @claim("staff_reach", "role")) + @holds(organizations:write)   @rls maps delete
  admit select, insert, update, delete = @kind("service") and @within(tenant) and @within(project) and confined
}

// The provisioning ledger. One row per provision id, carrying the markers each
// step commits with its own mutation, so a retried call resumes rather than
// creating a second organisation.
//
// No delete: a ledger that can be erased cannot answer "has this already run",
// which is the only question it exists for. The table's own CHECKs hold the
// step markers consistent; this says who may read and write them at all.
//
// org_id is GENERATED from the organisation the provision created, falling back
// to the parent it was asked to create under, so a confined service is held to
// its own subtree from the first INSERT — before the organisation exists.
object organization_provisions {
  table  organization_provisions
  scoped tenant > project
  relation confined: service via closure organization_closure(ancestor_id, descendant_id) on org_id from claim org_id missing allow
  // Whoever makes organisations reads the record of the provisions that make
  // them: a provision is carried out step by step, each step reads the record
  // of the ones before, and a retry answers from it.
  permission view   = (@holds(platform:manage) and not @claim("staff_reach", "role")) + @holds(organizations:read) + @holds(organizations:create)    @rls maps select
  // A provision is the record of one organisation being made, written and
  // advanced by whoever is making it: the create, as the organisation's own
  // insert asks.
  permission create = (@holds(platform:manage) and not @claim("staff_reach", "role")) + @holds(organizations:create)   @rls maps insert
  permission edit   = (@holds(platform:manage) and not @claim("staff_reach", "role")) + @holds(organizations:create)   @rls maps update
  admit select, insert, update = @kind("service") and @within(tenant) and @within(project) and confined
}

// ── Append-only / reduced-op containment tables (Landing 2, Wave B) ──────────────
// Previously hand-written RLS, pure @scoped containment (staff OR tenant+project)
// with NO owner axis and NO roles — the same shape as the settings tables, but with
// a reduced op-set (an event stream is insert+read; an immutable history never
// updates). Modelled as `use contained` minus the verbs the table never had: an
// omitted verb emits NO policy, so under FORCE-RLS that op stays denied (preserving
// the append-only / immutable behaviour). The staff reach converges to the
// scoped form (must select the project), consistent with records + the settings
// tables, rather than the old ambient tenant-wide branch.
object config_history         { table config_history;         scoped tenant > project; use contained; omit edit }                // immutable, prunable history (D,I,S)
// auth_exchange_tickets takes the org axis because a credential exchange is
// issued at the install's level and redeems for a token carrying that level.
// Exact-level, no inheritance: a ticket is redeemed where it was issued.
object auth_exchange_tickets  { table auth_exchange_tickets;  scoped tenant > project > org wildcard confers select, insert; use contained; omit delete }              // ephemeral, expiry-cleaned (I,S,U)

// The applied-migration ledger. No owner axis: a migration is a console act
// over a definition's whole corpus, so there is no owning user and nothing
// on the row is a user's data.
//
// A migration belongs to the level that declared it, the level owning the
// definition it is about. `> org wildcard` stamps and pins that level on the
// row, a caller sees the shared tier's ledger, its own and every organisation's
// below it, and settles or writes off only a row at exactly its own level.
// Whether a level has applied a content hash is read at exactly that level,
// because the same hash at another level is another migration.
//
// `omit delete` is the point of a ledger. A row records that a migration ran
// against its owning level; removing it would let the same migration run again
// over data that has already moved, which is the one thing the ledger exists to
// stop. Project deletion still cleans up, through the foreign key rather than
// through a policy, and the organisation purge removes a purged level's rows.
object record_migration { table record_migrations; scoped tenant > project > org wildcard confers select, insert; use contained; omit delete }   // applied ledger (I,S,U)

// A release: the moment a level's drafted definitions became what production
// runs, recording who asked, when, and every copy it stamped over the one it
// replaced. It belongs to the level whose definitions it carries. `> org
// wildcard` stamps and pins that level, a caller sees the shared tier's
// releases, its own and those below it, and schedules, cancels or rolls back
// only a release at exactly its own level, which is the only level it can
// release.
//
// `omit delete` because it is history: a rollback is found through the release
// it rolls back, and a release that vanished would leave that rollback naming
// nothing. Project deletion cleans up through the foreign key, and the
// organisation purge through the organisation's.
object releases { table releases; scoped tenant > project > org wildcard confers select, insert; use contained; omit delete }   // release history (I,S,U)

// The idempotency ledger for record writes. Plain project containment: the row
// is written and replayed by the same caller, in the same transaction as the
// write it describes, so it is reachable exactly when that write was.
//
// UPDATE is required, and the reason is the two-step shape rather than an
// oversight: the key is CLAIMED before the work (so a concurrent retry loses
// the race and reads rather than writes) and the response is recorded after it
// succeeds. Both halves are the same transaction and the same claimant, so the
// row is only ever written by the attempt that owns it — an `omit edit` here
// denied that second statement and left every row holding an empty response,
// which the replay path then correctly refused as an attempt that never
// completed.
object record_write_idempotency_row { table record_write_idempotency; scoped tenant > project; use contained }   // idempotency ledger (I,S,U,D)

// The keys of KEYED calls the platform keys. No caller reads or writes a row:
// the key layer writes each in the call's own transaction as the platform's
// own role, and reads it on the platform's lane. Fóir's staff may read them.
object call_idempotency {
  table  call_idempotency
  scoped platform
  permission view   = @holds(platform:manage)  @rls maps select
  permission create = @holds(platform:manage)  @rls maps insert
  permission edit   = @holds(platform:manage)  @rls maps update
  permission delete = @holds(platform:manage)  @rls maps delete
}

// ── Project-scoped tables normalised from owner-WIDENING hand-written RLS (Wave B) ──
// Matt's decision (2026-06-17): note_mentions and notifications are PROJECT
// operations, scoped to a project. The old hand-written policies carried owner
// branches that WIDENED beyond the project (a cross-project mentioned/recipient
// user). Those widenings are dropped — converging to project containment.
// note_mentions is plain in-project content (any in-project console user, like the
// records plane); notifications are PERSONAL to their recipient, so the
// owner term gates every read/write within the project, and the system INSERT is @open.
object note_mention { table note_mentions; scoped tenant > project > org wildcard confers select, insert; use contained }
// note_attachments is the link between a note and the `files` row holding its
// bytes. Same shape as note_mention above and for the same reason: it is an
// in-project edge, not content, so containment is the whole row-layer statement.
//
// A composite pk, because the pair IS the row. There is no id to mint and nothing
// else the table could be keyed by.
//
// `omit edit`, so no UPDATE policy is emitted and FORCE-RLS leaves the op denied.
// Both columns of the key are the row's identity — moving a link is deleting one
// and writing another, never editing one in place.
//
// WHAT THIS DELIBERATELY DOES NOT SAY: "readable if you can read the note". The
// note's own SELECT tree turns on a `mode access_mode = "public"` leaf plus
// grant leaves, and any `and` placed in that tree fails to
// compile — the accessor enumerator cannot compose a mode-leaf. That is the same
// wall public.note_subject_visible exists to work around, and the answer here is
// the same: the note-content floor lives on the note-reading queries, and a row
// here carries no note content to floor. A caller who reaches these rows directly
// learns that an opaque note id has an opaque file id attached, and the file's own
// bytes stay behind files_select.
object note_attachment { table note_attachments; pk (note_id, file_id); scoped tenant > project > org wildcard confers select, insert; use contained; omit edit }
// note_embeddings is the semantic index over notes: one vector per note,
// written ONLY by the worker on the bypass pool (create/edit/delete are
// omitted, so FORCE-RLS default-denies every authenticated write). The SELECT
// here is containment, and deliberately NOT "readable if you can read the
// note": retrieval JOINs notes under the caller's own claims plus
// note_subject_visible, so the join is where real visibility is decided — a
// vector row alone discloses nothing but its existence, and only in-project.
object note_embedding { table note_embeddings; scoped tenant > project > org wildcard confers select, insert; use contained; omit create; omit edit; omit delete }
// note_approvals is the structured approval primitive: a held mutation, the
// verb whose holders may decide it, and the decision as a recorded act.
// Containment for select/insert/update: the card renders for whoever can read
// the note (the LIST RPC repeats the note-visibility floor), creation is the
// assistant lane's service principal or a console user, and the DECIDE gate — the
// verb the held mutation requires — is handler-side RequireVerbAtOwnPlace against
// the row's required_verb, which no static policy can express. No delete:
// a decision is a record, and records are not unmade.
object note_approval { table note_approvals; scoped tenant > project > org wildcard confers select, insert; use contained; omit delete }
// TTS-684: ONE notification object serving BOTH planes — the merge of the former
// project users' notifications table and the console's `notification` table.
// This is TTS-313's missing wave: every other owned table moved to the unified
// (owner_id, owner_kind) principal reference; this one still keyed on user_id.
//
// A notification is its owner's, a user in either pool. Holding every user's
// notifications reaches the users of the project's own pool and never a console
// user's inbox, which is theirs alone: the row says only that a user owns it, so
// the owner's pool is asked (owner_outside_the_console). That is the whole moat.
//
// `create` deliberately does NOT ask the owner's pool: sending a notification
// means addressing a row to SOMEONE ELSE (an announcement, a mention), so the
// writer is never the owner. Privacy lives on read, not on create.
object notification {
  table  notifications
  // `wildcard`, so project_id may be NULL and the row is then visible across the
  // whole tenant — `(project_id IS NULL OR project_id = claims.project_id)`.
  //
  // A notification belongs to a USER: the inbox read is `owner_id = @user_id`
  // with no tenant or project term at all. Plain `> project` ANDed
  // `project_id = claims.project_id` onto every policy, which partitioned a
  // person's own inbox by whichever project they happened to be standing in —
  // switch project, lose your notifications — and made a workspace-wide
  // announcement unrepresentable, since there is no one project to stamp.
  //
  // The tenant/project/user selection on the Announcements screen is the
  // AUDIENCE, not the row's identity. A project's users' rows keep a real
  // project and are unaffected; the wildcard only admits the tenant-wide case
  // that could not be expressed before.
  scoped tenant > project wildcard > org wildcard confers select, insert
  relation owner:       user | service via owner_id where owner_kind = "user"
  // The one user a write is made for, where the platform judged the caller
  // may write for a user it names (see `subject owner_delegate`). It reads
  // that user's rows too: a send reads what its recipient chose to be told of
  // before it writes anything for them.
  relation delegated_owner: owner_delegate via owner_id where owner_kind = "user"
  // Where the person the notification is for stands, read as the users rule
  // reads it. A notification stands where its send stood, and one sent at the
  // project stands at the project tier every organisation's claim admits, so
  // its own row says nothing of who may reach its person.
  relation owner_stands: user_standing via object user_standing->stands on owner_id for select
  // WHOSE ROWS A HOLDER REACHES is what it holds. A person reaches their own.
  // Every user's is the reach a grant says, worked out from what the holder
  // holds and read here as a claim; it is every application user's that the
  // holder reaches (owner_stands), and not a console user's own, which stays
  // theirs alone as it was. Writing a row for somebody else is the write of
  // every user's, which is what sending is, or the write for one user the
  // request names; a send is judged before it writes (recipient_reach.go).
  permission view   = owner + (@claim("notifications_read_all", "true") and owner_stands) + delegated_owner   @rls maps select
  permission edit   = owner + (@claim("notifications_write_all", "true") and @within(project) and owner_stands) + delegated_owner   @rls maps update
  permission delete = owner + (@claim("notifications_write_all", "true") and @within(project) and owner_stands)   @rls maps delete
  // A console user's own is theirs alone: a row whose owner signs in to the
  // console is reached by its owner and by nobody else's reach.
  require view      = owner + @external(owner_outside_the_console, owner_id)
  require edit      = owner + @external(owner_outside_the_console, owner_id)
  require delete    = owner + @external(owner_outside_the_console, owner_id)
  permission create = owner + @claim("notifications_write_all", "true") + delegated_owner                        @rls maps insert
}

// A person's conversation with an agent, and its messages. Personal within a
// project, as a notification is: the owner term gates every verb, so a person
// reads their own threads and no one else's, and only in the project they are
// in. Ask Fóir's thread with no project open stands at the workspace, in no
// project, and is read only there. A thread is made only BY its owner, so create = owner. No staff relation:
// the scoping still emits the impersonation-reach term, and `user_id = sub` is
// ANDed over every verb, so a staff account impersonating into a tenant reads
// only its OWN threads there, never another person's.
//
// No org axis, for the reason the owner relation gives: it is narrower than
// one. An org claim is shared by everyone standing in that org; a user id is
// not. A visitor's thread carries no user and is reached by no claim: the
// platform reads it by the secret the visitor's browser keeps.
//
// A thread's messages carry their owner on their own row, so the same rule
// reads them without a join. The platform appends the model's and the tools'
// messages for the owner, on the owner's own claims.
object thread {
  table  threads
  scoped tenant > project wildcard
  relation owner: member via user_id
  permission view   = owner    @rls maps select
  permission create = owner    @rls maps insert
  permission edit   = owner    @rls maps update
  permission delete = owner    @rls maps delete
  require view   = @external(stands_in_the_requests_project, project_id, @project_id)
  require create = @external(stands_in_the_requests_project, project_id, @project_id)
  require edit   = @external(stands_in_the_requests_project, project_id, @project_id)
  require delete = @external(stands_in_the_requests_project, project_id, @project_id)
}
object thread_message {
  table  thread_messages
  scoped tenant > project wildcard
  relation owner: member via user_id
  permission view   = owner    @rls maps select
  permission create = owner    @rls maps insert
  permission delete = owner    @rls maps delete
  require view   = @external(stands_in_the_requests_project, project_id, @project_id)
  require create = @external(stands_in_the_requests_project, project_id, @project_id)
  require delete = @external(stands_in_the_requests_project, project_id, @project_id)
}

// A file a person sends an agent with a message, read through the thread it
// was sent in: the thread's rule, on the attachment's own row. A visitor's
// carries no user and is reached by no claim, as their thread is.
object agent_attachment {
  table  agent_attachments
  scoped tenant > project wildcard
  relation owner: member via user_id
  permission view   = owner    @rls maps select
  permission create = owner    @rls maps insert
  permission delete = owner    @rls maps delete
  require view   = @external(stands_in_the_requests_project, project_id, @project_id)
  require create = @external(stands_in_the_requests_project, project_id, @project_id)
  require delete = @external(stands_in_the_requests_project, project_id, @project_id)
}

// A person's own account at an agent's MCP server. Theirs alone to read and
// remove; whoever authors the project's agents removes any, so a connection
// can be cut from above.
object mcp_connection {
  table  mcp_connections
  scoped tenant > project
  relation owner: member via user_id
  permission view   = owner                          @rls maps select
  permission create = owner                          @rls maps insert
  permission edit   = owner                          @rls maps update
  permission delete = owner + @holds(agents:write)   @rls maps delete
}

// ── Billing (Landing 2, Wave C) ─────────────────────────────────────────────────
// Matt's decision #2: converge billing to ONE shape — READ by the tenant's own manager
// (the workspace sees its plan/usage), WRITE by staff only. The
// workspace manager is deliberately EXCLUDED from writing billing — those rows are managed
// by Stripe + the metering pipeline, all on the BYPASS pool (which ignores RLS), so
// the staff-only write policy only affects authenticated sessions (and none write
// billing). TTS-1023: the read branch is `@holds(billing:read)` rather than
// `tenant->owner` — a CAPABILITY, not a role key. billing:read is tenant-tier:
// implied by tenant:manage and by nothing below it, and @holds on a
// tenant-scoped object matches only a TENANT-level assignment, which is exactly the
// shape the old workspace-owner definer required, so the holder set is unchanged. Staff's
// impersonation reach is a separate top-level disjunct and is untouched.
// TTS-1942: the write arms are GONE, not narrowed, and the paragraph above says
// why they could go. Every billing writer — the Stripe webhook, the overage
// meter, the plan assigners, the metering workers — runs on the bypass pool, and
// `subscriptions.go` states the reason at the callsite: running one under WithRLS
// "fails the INSERT WITH CHECK with SQLSTATE 42501 whenever staff aren't
// actively impersonating the target tenant". So no caller ever depended on the
// impersonation write arm; it was authority nothing exercised.
//
// What it DID do was let an impersonating staff account insert, update and delete a
// workspace's billing rows — 25 of the 27 cells by which a tenant-wide grant
// out-reached a workspace MANAGER, who cannot write billing at all. A grant should
// confer no more than the role it impersonates, and this was the largest place
// it did.
//
// Omitting the permissions rather than narrowing them is the idiom
// `impersonation_grants` already uses: no policy is emitted, RLS is FORCED, so
// the authenticated plane denies. The bypass pool is unaffected, which is where
// every real writer already is. Authorization for those writers is
// RequireStaffPrincipal in Go plus an explicit tenant_id, and that is unchanged.
// THE PLATFORM ARM IS WHAT LETS SUPPORT SEE A TENANT'S BILLING AT ALL, and it is
// here rather than on thirteen objects because all thirteen read through this
// one line.
//
// An approved impersonation grant confers CONTAINMENT REACH and nothing else —
// it satisfies `tenant_id = claim OR impersonation_grants_reach(...)` and stops
// there. A staff member holds no billing:read at somebody else's tenant, so
// before this arm every billing read returned ZERO ROWS WITH NO ERROR: a support
// engineer with an approved grant, opening a workspace to answer a billing
// question, saw an empty account and had nothing to attribute it to. That is the
// withheld-content-reads-as-zero failure on the one surface whose entire purpose
// is diagnosing somebody else's data.
//
// ⚠️ THIS IS NOT AMBIENT REACH, and the position of the term is what makes that
// true. The emitter folds every permission term INSIDE the containment block
// (`containment AND (t1 OR t2 …)`), so the grant is still required to reach the
// tenant at all; this only satisfies the PERMISSION half once the tenant has
// already let staff in. Remove the grant and the arm reaches nothing.
//
// It is also not a new idea here. Thirteen objects on the content plane already
// carry exactly this disjunct — organizations, organization_members, projects,
// roles, role_assignments, invitations among them — and billing and the user
// directory were simply the ones nobody extended it to. The defect this fixes is
// the INCONSISTENCY: nobody decided that support may read a tenant's
// organisations and not its invoices.
//
// SELECT ONLY, deliberately. `view` alone takes the arm; create, edit and delete
// are untouched on every object that uses this template. Support reads a tenant's
// billing and cannot change it, which is the read-only half of the standard
// impersonation pattern expressed by bounding the verb rather than by inventing a
// read-only mode.
template billing {
  permission view   = (@holds(platform:manage) and not @claim("staff_reach", "role")) + @holds(billing:read)     @rls maps select
}

object billing_subscriptions {
  table  billing_subscriptions
  scoped tenant
  reach impersonation unscoped for select
  relation tenant: tenant via tenant_id
  use billing
}
object billing_stripe_customers { table billing_stripe_customers; scoped tenant; reach impersonation unscoped for select; relation tenant: tenant via tenant_id; use billing }
object billing_usage_history    { table billing_usage_history;    scoped tenant; reach impersonation unscoped for select; relation tenant: tenant via tenant_id; use billing }
object billing_usage_current    { table billing_usage_current;    scoped tenant; reach impersonation unscoped for select; relation tenant: tenant via tenant_id; use billing }
object billing_usage_media_transformations { table billing_usage_media_transformations; scoped tenant; reach impersonation unscoped for select; relation tenant: tenant via tenant_id; use billing }   // fold also FORCES RLS (closes the un-FORCED gap)
object billing_usage_resolutions { table billing_usage_resolutions; scoped tenant; reach impersonation unscoped for select; relation tenant: tenant via tenant_id; use billing }   // content-resolution usage cells (TTS-1110 Phase 1; measurement only, nothing reads these into an invoice)
object billing_usage_notes      { table billing_usage_notes;      scoped tenant; reach impersonation unscoped for select; relation tenant: tenant via tenant_id; use billing }   // notes written, append-only (TTS-1383; measurement only, no price). Rows are inserted by the notes_billing_meter TRIGGER, which is SECURITY DEFINER — so no policy here needs to admit the note's author, who may be a project's user
object billing_usage_note_attachments { table billing_usage_note_attachments; scoped tenant; reach impersonation unscoped for select; relation tenant: tenant via tenant_id; use billing }   // note attachments written, append-only (measurement only, no price — the BYTES are already billed as media storage). Same SECURITY DEFINER trigger arrangement as billing_usage_notes above
object ai_credit_events         { table ai_credit_events;         scoped tenant; reach impersonation unscoped for select; relation tenant: tenant via tenant_id; use billing }   // AI-credit ledger (TTS-648)
// The overage window is scoped TENANT and takes no organisation axis, for the
// same reason the rate limiter does not (see services/internal/ratelimit,
// TenantLimitFunc): an overage is measured against the plan a TENANT bought, and
// an organisation has no plan and no bill to overrun. A per-organisation overage
// report would be a number with no contract behind it. The rationale for not
// selling throughput per organisation belongs to the throughput-and-overage
// ticket and is cited rather than restated.
object billing_overage_reports  { table billing_overage_reports;  scoped tenant; reach impersonation unscoped for select; relation tenant: tenant via tenant_id; use billing }   // metered-overage idempotency ledger (TTS-617)

// project_limits: the TTS-1043 per-project quota cap beneath the tenant's plan
// ceiling. Reads like the rest of billing (`use billing` → @holds(billing:read),
// tenant-tier); writes are the whole point of the object and diverge from the
// template deliberately.
//
// WHY `scoped tenant` AND NOT `scoped tenant > project`, when the table carries a
// project_id. This is the load-bearing line of the object, not an oversight:
//
//   @holds keys on the object's DECLARED scope columns. Under `scoped tenant` the
//   capability can only ever be satisfied by a TENANT-LEVEL role assignment, so a
//   project-pinned grant cannot match at any verb — which is exactly the control
//   this ticket exists to install. Declaring the project axis (as
//   operation_signing_secrets deliberately does, for the opposite reason) would let
//   the capability be read AT THE ROW'S OWN PROJECT, and a project-level assignment
//   would then confer over its own row. The party being capped would be able to
//   satisfy the write policy on its own cap. That is precisely the decorative
//   control the ticket forbids.
//
//   The cost is that the containment branch carries no project condition — a tenant
//   manager sees every project's caps in its tenant. That is correct: caps are the
//   TENANT's allocation decision across its projects, and reading them is exactly
//   what a workspace manager does to make the next one.
//
// WRITES = @holds(tenant:manage), NOT billing:manage. billing:manage would also be
// unreachable from project:manage (it is tenant-tier), so it would satisfy the
// letter of the requirement — but it means "may change what the workspace BUYS",
// and this is not a purchase. tenant:manage is the authority to manage the
// workspace's own structure, which is what sub-allocating a bought ceiling across
// projects is. It is also the narrower of the two: `tenant:manage` is implied by
// nothing at all (see auth.member_perm_implied_by), so the holder set cannot widen
// underneath this policy the way a tiered verb's can.
//
// QUOTA IS NOT AUTHORIZATION. This object governs who may WRITE a cap row. The cap
// itself is never consulted by the access system — no policy reads project_limits
// to decide whether an action is permitted, and member_has_perm knows nothing about
// it. A cap answers "how much", the access system answers "whether"; they meet only
// at the enforcement point in services/internal/billing.
object project_limits {
  table  project_limits
  scoped tenant
  // A PROJECT PIN MEANS ONE THING, on this object as on the nine beside it.
  //
  // An impersonation grant naming a project reaches nothing here: tenant-wide
  // billing needs a workspace-wide grant. Without this clause the object takes
  // the scoped reach and a pinned grant read EVERY row of the tenant — including
  // rows whose project_id names a project the grant does not name — because
  // `scoped tenant` puts no project conjunct on the row.
  //
  // `scoped tenant` is separately correct and stays: a plan limit is the tenant's
  // allowance expressed per project, project_id names the row's subject rather
  // than its partition, and a project-level caller may not read their own cap.
  // What this decides is which GRANTS reach it, not which level it lives at.
  reach impersonation unscoped for select, insert, update, delete
  relation tenant: tenant via tenant_id
  use billing
  permission create = @holds(tenant:manage)  @rls maps insert
  permission edit   = @holds(tenant:manage)  @rls maps update
  permission delete = @holds(tenant:manage)  @rls maps delete
}

// The marketplace CATALOGUE — the same shape as the plan catalog below, and for
// the same reason: global reference data every session may read, curated by
// platform staff. Browsing happens before a console user has chosen a project, so
// a tenant-scoped object could not serve it.
//
// `published` is NOT expressible at the row layer — @public view admits every
// authenticated reader, exactly as billing_plans does with is_active — so
// "unpublished is invisible to tenants" is a handler predicate with no RLS
// backstop, and the test that proves it has to be a handler test.
object app_listings {
  table  app_listings
  scoped platform
  permission view   = @public  @rls maps select
  permission create = @holds(platform:manage)    @rls maps insert
  permission edit   = @holds(platform:manage)    @rls maps update
  permission delete = @holds(platform:manage)    @rls maps delete
}
// The platform plan CATALOG — world-readable (workspace managers must see available plans
// to choose), managed by platform staff.
object billing_plans {
  table  billing_plans
  scoped platform
  permission view   = @public  @rls maps select
  permission create = @holds(platform:manage)    @rls maps insert
  permission edit   = @holds(platform:manage)    @rls maps update
  permission delete = @holds(platform:manage)    @rls maps delete
}
// Per-tenant custom plans — workspace-manager read, staff-managed writes (like billing).
object custom_billing_plans {
  table  custom_billing_plans
  scoped tenant
  reach impersonation unscoped for select
  relation tenant: tenant via tenant_id
  use billing
}
// The platform-global Stripe Billing Meter registry (TTS-617): one row per metered
// metric mapping it to its Stripe meter id + event_name. Internal staff data
// (not shown to workspaces, unlike the world-readable billing_plans catalog), so
// staff-only on every verb. Platform provisions it on the BYPASS pool at boot.
object billing_meters {
  table  billing_meters
  scoped platform
  permission view   = @holds(platform:manage)  @rls maps select
  permission create = @holds(platform:manage)  @rls maps insert
  permission edit   = @holds(platform:manage)  @rls maps update
  permission delete = @holds(platform:manage)  @rls maps delete
}

// The models Fóir runs, each with the price staff confirmed for it, and which
// model does each of Fóir's jobs. Platform-wide rows with no tenant in them:
// staff set them on the Model setup page, and the platform reads them for
// every tenant's calls on the BYPASS pool, so staff-only on every verb.
object ai_models {
  table  ai_models
  scoped platform
  permission view   = @holds(platform:manage)  @rls maps select
  permission create = @holds(platform:manage)  @rls maps insert
  permission edit   = @holds(platform:manage)  @rls maps update
  permission delete = @holds(platform:manage)  @rls maps delete
}
object ai_jobs {
  table  ai_jobs
  scoped platform
  permission view   = @holds(platform:manage)  @rls maps select
  permission create = @holds(platform:manage)  @rls maps insert
  permission edit   = @holds(platform:manage)  @rls maps update
  permission delete = @holds(platform:manage)  @rls maps delete
}

// ── Wave B.3: staff-managed + workspace-manager + collab ────────────────────────
// editing_state: collaborative-editing state (realtime). Decision #4: the old policy
// gave staff reach on READ but NOT on writes (an oversight) — normalised to
// uniform tenant containment + staff reach on every op.
// ⚠️ scoped tenant > project, and it was `scoped tenant` while the table carried
// project_id — so the emitted policy mentioned no project and a caller standing
// in project A reached every project's live draft content in the tenant.
//
// The column was there and NOBODY WROTE IT. The realtime gateway is this table's
// only writer and it wrote neither tenant_id nor project_id, so every production
// row held NULL in both: the tenant term matched nothing either, the gateway's
// own reads keyed on the record triple alone, and the project purge — which
// reaches this table by an ON DELETE CASCADE on project_id — never fired, so
// deleting a project left its drafts behind indefinitely. The gateway carries
// the scope now and 20270622110000 backfilled the rows that predate it.
object editing_state { table editing_state; pk (record_type, record_id, variant_id); scoped tenant > project; use contained }

// invitations: workspace invitations. Read/update by the workspace's own manager
// (tenant->owner → the old workspace-owner definer) OR the inviter (owner via invited_by);
// create/delete by the workspace manager. Tenant-scoped; the staff reach auto-applies.
// TTS-1042 — WHY THIS OBJECT HAS FOUR HAND-WRITTEN COMPANION POLICIES.
//
// Its workspace arms are unchanged, and the four policies below are unchanged, but they are
// no longer the whole story for this table. Migration
// 20270225100000_tts1042_project_scoped_invitations.sql adds
// invitations_{select,insert,update,delete}_project_scoped beside them — the only
// sanctioned exception to "the generator owns the policy surface", registered by
// name in authz.bespokePolicies and pinned to an exact predicate there.
//
// The requirement they carry: an invitation naming a project set must be writable by
// a principal holding members:write at EVERY named project, while one naming no
// projects (tenant-wide) still requires tenant-scope authority. Demesne v0.77.1
// cannot emit that, and neither shape of the object fixes it:
//
//   - A workspace invitation has no project of its own (its project column is
//     the place of a project's invitation, NULL here), so @holds passes NULL for
//     the project argument, and auth.member_has_perm's `(ra.project_id IS NULL OR ra.project_id =
//     check_project_id)` collapses to `ra.project_id IS NULL` against NULL — so a
//     project-pinned grant can never match, at any verb tier.
//   - `scoped tenant > project` would make the containment block emit
//     `project_id = <project claim>` unconditionally, which a tenant-wide invitation
//     can never satisfy — and this object must support both shapes.
//   - No term quantifies over a set-valued column, which "every project this row
//     names" requires; invitations.project_ids is a text[] since TTS-1042 precisely
//     so the row layer CAN quantify over it.
//
// The durable fix is a demesne construct — a @holds that can read a scope column the
// object carries without scoping by it, and/or a set-quantified form — plus a
// release. When that lands, fold the four companions back in here and delete the
// bespokePolicies entry.
object invitations {
  table  invitations
  scoped tenant > project wildcard
  reach impersonation unscoped for delete, insert, select, update
  relation tenant: tenant via tenant_id
  relation owner:  member via invited_by
  // An invitation asks somebody to stand at a place, so it is read and written
  // on the members verbs at that place, in every pool: a workspace and its
  // projects for the console's people, a project and its organisations for a
  // project's. A key holding the members verbs reaches the invitations of its
  // own project, and the inviter keeps sight of theirs.
  permission view   = (@holds(platform:manage) and not @claim("staff_reach", "role")) + @holds(members:read) + (@claim("members_read", "true") and @within(project)) + owner   @rls maps select
  permission create = (@holds(platform:manage) and not @claim("staff_reach", "role")) + @holds(members:write) + (@claim("members_write", "true") and @within(project))   @rls maps insert
  permission edit   = (@holds(platform:manage) and not @claim("staff_reach", "role")) + @holds(members:write) + (@claim("members_write", "true") and @within(project)) + owner   @rls maps update
  permission delete = (@holds(platform:manage) and not @claim("staff_reach", "role")) + @holds(members:write) + (@claim("members_write", "true") and @within(project))   @rls maps delete
}

// operation_signing_secrets: the per-project webhook signing secret, relocated
// off the retired generic `settings` k/v store. One row per project; read by the
// platform's GetSigningSecret RPCs and provisioned by config-as-code (`foir
// push`, a kind='service' caller) alongside hooks. Tenant-scoped so the
// workspace-manager branch carries no project condition; every other branch carries
// its own project scope through @within(project). SELECT: workspace manager (any
// project) OR project manager/service in the active project. Writes: project manager
// or service in the active project. No is_public branch — a signing secret is
// never public. The service branch uses @kind("service"), matching the settings
// precedent it replaces. Staff reach auto-applies to all verbs.
//
// The service branch is not what decides whether a key may hold the secret. An
// API key's session is a service caller, so the branch admits every key in the
// project, whatever it was granted. A key reaches these rows only through the
// three signing secret RPCs, and each of them requires opsecrets:read (or
// opsecrets:write to replace it) of the key before it touches a row. The row
// layer cannot ask that itself: a key's grant is not a claim it can read. The
// branch narrows to the key's own grant once a key's grant is a role the row
// layer holds, as a console user's already is.
// TTS-1023: this table is the reason the repoint could not be deferred. Its role
// branch was `project->owner`, which compiles to the LEVEL-owner definer for the
// project level — a name that, under demesne <= v0.74, collided with the
// `via role(rank >= …)` definer emitted for the `project` object at the
// project-management rank, and was deduplicated away in its favour. Retiring the
// rank form (v0.75.0) restores that level-owner definer to its true meaning, "holds
// ANY project role here", which would silently hand every editing or reading role in
// the project the webhook SIGNING SECRET — enough to forge deliveries. So the branch
// is repointed onto the capability it was always meant to express. opsecrets:* is
// project-tier — implied by project:manage (and so by tenant:manage) — which is
// exactly the measured holder set.
//
// The object also becomes `scoped tenant > project`: @holds keys on the object's
// declared scope columns, so with project as a mere @within column it could only ever
// have matched a TENANT-level assignment, which would have locked out the
// project manager the table is FOR. Declaring the project axis is what lets the
// capability be read at the row's project.
object operation_signing_secrets {
  table  operation_signing_secrets
  scoped tenant > project
  relation tenant:  tenant  via tenant_id
// The capability term needs no @within(project) beside it: @holds is itself scoped, so
// a PROJECT-level assignment confers only at its own project (reproducing the old
// project branch) while a TENANT-level one confers across the tenant (reproducing the
// old tenant->owner branch, which likewise carried no project condition). One term
// therefore says exactly what the two role branches said between them.
  permission view   = (@holds(platform:manage) and not @claim("staff_reach", "role"))
                    + @holds(opsecrets:read)
                    + (@kind("service") and @within(project))
                    @rls maps select
  permission create = (@holds(platform:manage) and not @claim("staff_reach", "role"))
                    + @holds(opsecrets:write)
                    + (@kind("service") and @within(project))
                    @rls maps insert
  permission edit   = (@holds(platform:manage) and not @claim("staff_reach", "role"))
                    + @holds(opsecrets:write)
                    + (@kind("service") and @within(project))
                    @rls maps update
  permission delete = (@holds(platform:manage) and not @claim("staff_reach", "role"))
                    + @holds(opsecrets:write)
                    @rls maps delete
}

// billing_usage_alerts: like `billing` (workspace-manager read, staff-managed deletes)
// but the workspace manager may ACKNOWLEDGE its own alert (edit), and alerts are
// system-created in-tenant (create = @scoped; the metering pipeline writes via bypass).
object billing_usage_alerts {
  table  billing_usage_alerts
  scoped tenant
  reach impersonation unscoped for insert, select, update
  relation tenant: tenant via tenant_id
  use billing
  permission create = @scoped                  @rls maps insert
  permission edit   = @holds(billing:manage)   @rls maps update
}

// email_copy_override: email-template overrides — a console-plane setting (Matt:
// a project's users have no access; the public API does not expose it). Folded to project
// containment; the old tenant-scoped read + per-row action_key CASE (staff vs
// workspace manager keyed on email prefix) is normalised away — staff + in-project
// console users manage all email copy, like every other console-config table.
//
// `project wildcard` because project_id is nullable and NULL is how a WORKSPACE-WIDE
// override is spelled. TWO different sets of copy are stored that way and both are
// the account app's, under the workspace: the wording Fóir sends a workspace's
// MANAGERS, and the default wording that workspace's projects send their
// USERS. Only the action key tells them apart. A plain `> project` ANDs
// `project_id = claims.project_id` onto all four policies, and NULL = <claim> is
// never TRUE, so those rows are writable only by a bypass path and readable by
// nobody: the screen saves without error and refetches the shipped defaults.
// Project-scoped rows carry a real project_id and are unaffected.
//
// The wildcard widens CONTAINMENT and nothing else, and in particular it does not
// let a project's manager write a row their siblings inherit. A tenant-wide
// row resolves `member_has_perm(sub, tenant_id, project_id => NULL, 'settings:write')`,
// whose assignment match is `(ra.project_id IS NULL OR ra.project_id = check_project_id)`
// — with a NULL row scope only a project-less assignment satisfies it, so the write
// needs workspace-level authority. The console briefly offered that write from a
// project URL through an "every project in the workspace" scope radio; the row layer
// refused it for anyone whose settings verb came from a project role, and the radio
// has moved to the account app rather than the policy loosening to meet it.
//
// GATED ON THE SETTINGS VERBS rather than `use contained`. The PROCEDURE map
// already charges settings:write for the three write RPCs, so the caller was
// checked — but the ROW layer was not, and the row layer's whole value is that
// it holds when the application layer is wrong about who the caller is. Bare
// containment made this table's policies satisfiable by a tenant claim alone
// once the wildcard admitted workspace rows, which is the class TTS-1046 pins.
//
// Same verbs the procedure map already names, so nothing that could write email
// copy loses the ability to. The READ is a genuine narrowing: it was excused by
// its Get/List prefix and bounded only by containment, so a console user
// holding no settings verb could read a workspace's email copy. Now it cannot.
// ⚠️ THIS KEEPS THE UNBOUNDED `project wildcard`, AND THAT IS A DECISION.
//
// `(project_id IS NULL OR project_id = claim)` lands in every command here,
// including update and delete, which on the notification pair was a cross-project
// write and is bounded there to select and insert. It is safe on this object for a
// reason that does not hold there: the authority term is
// `auth.member_has_perm(sub, tenant_id, project_id, <verb>)`, keyed on THE ROW'S OWN
// project_id. A workspace-wide row therefore demands workspace-scope authority, so
// the wide containment is already compensated by a scope-relative permission check.
//
// The notification pair authorises by its owner and by what a holder holds, and
// bounds its wildcard to select and insert. If this object's permissions ever
// move off `@holds`, the wildcard has to be bounded with them.
//
// A CALLER THE CHECK ADMITTED, IN ITS OWN PROJECT. A key, or a token that
// carries a console user's grants, holds no role, so no @holds term answers for
// it. What it may do is decided before the row is reached: the contract's check
// and the handler ask it for settings:read or settings:write. Here it reads and
// writes the copy of the one project its claims name, and never the workspace's
// own copy: @within(project) pins the row's project to the claim, which the
// wildcard's NULL does not satisfy. A request on a publishable key is a service
// at this layer too, and is named out. It deletes nothing.
object email_copy_override {
  table  email_copy_override
  scoped tenant > project wildcard
  permission view   = (@holds(platform:manage) and not @claim("staff_reach", "role")) + @holds(settings:read)  + (@kind("service") and @within(project) and not @claim("credential", "public"))   @rls maps select
  permission create = (@holds(platform:manage) and not @claim("staff_reach", "role")) + @holds(settings:write) + (@kind("service") and @within(project) and not @claim("credential", "public"))   @rls maps insert
  permission edit   = (@holds(platform:manage) and not @claim("staff_reach", "role")) + @holds(settings:write) + (@kind("service") and @within(project) and not @claim("credential", "public"))   @rls maps update
  permission delete = (@holds(platform:manage) and not @claim("staff_reach", "role")) + @holds(settings:write)   @rls maps delete
}

// Files adopt the SAME unified access descriptor as records (the second resource
// kind on resource_acl): owner-origination + per-file visibility + app-declared
// grants, discriminated by resource_type = "file". No console-owner plane (files are
// owned by users or services). The mode column is the existing `visibility` text col
// (public | private) the media-serving layer already reads — now RLS-enforced: a
// public file is readable in-scope, a private file only by its owner + grantees,
// closing the "private files served by unguessable URL" gap. The grant write-moat
// (@store_manage) auto-extends to file_can_edit, and the accessor enumerator
// (Expand) auto-emits — files join with no new mechanism.
// File — pure relations (user-owned, no console plane). Resource READ access_mode
// is a SEPARATE axis from the byte-serving `visibility` column (EID-58, CDN
// tokenless serving, default public for storefront assets). Conflating them leaked
// service/other-owner files into users' file lists (EID-123) — a public storefront
// asset is byte-servable by URL but must NOT be listable by a user. So files keep
// their own access_mode (default private, like records); visibility stays for serving.
object file {
  table  files
  scoped tenant > project > org wildcard confers select, insert
  relation owner:   user | service via owner_id where owner_kind = "user"
  relation grantee: user via grant resource_acl(resource_id, principal_kind, principal_id, access) where resource_type = "file"
  // The organization's members reach the organization's files (see record).
  relation org_member: organizations via object organizations->view on org_id
  // Whose files a holder reaches, as on records and for the same reasons: its
  // own, the project's where it stands as the project, what was opened to it
  // (a share, its organisation's, a public one to read), and every owner's
  // where its grant says all. A file belongs to no model, so all is one claim
  // for each of read, write and delete. files declares no console owner, so the
  // project's files are every file no user owns.
  //
  // The arms marked by reach = "decided" are the release before's, as on
  // records: the branch for a caller with no user, an organisation's
  // members reaching every file in it, and files_list_all.
  permission view   = (@claim("stands", "project") and not @row(owner_kind, "user")) + owner + (org_member and not @row(owner_kind, "user")) + mode access_mode = "public" + grantee:read + @claim("files_read_all", "true")   @rls maps select
  // The public surface's floor, before, as on records: for a request the
  // release before built, a user-owned file is visible there to its owner
  // and a files:read.all holder, unless its row is public. The floor reads the
  // row axis only. visibility governs who the CDN serves the bytes to and says
  // nothing about who may list the row; an organisation's files, its logo
  // among them, pass because no user owns them (see uploadOwner).
  permission edit   = (@claim("stands", "project") and not @row(owner_kind, "user")) + owner + (org_member and not @row(owner_kind, "user")) + grantee:write + @claim("files_write_all", "true")   @rls maps update
  permission create = (@claim("stands", "project") and not @row(owner_kind, "user")) + owner + (org_member and not @row(owner_kind, "user")) + @claim("files_write_all", "true")   @rls maps insert
  permission delete = (@claim("stands", "project") and not @row(owner_kind, "user")) + owner + (org_member and not @row(owner_kind, "user")) + grantee:delete + @claim("files_delete_all", "true")   @rls maps delete
}

// Notes (console users' annotations) adopt the unified access descriptor as a
// CONSOLE-PLANE resource (demesne v0.35.x). Owned by the person who authored it via
// author_id (a STORED generated column = the bare cuid stripped from the prefixed
// created_by audit ref, so it equals the `sub` claim) — there is no project-user
// column. A "public" note
// is visible PROJECT-WIDE to console users (the actor-scoped read mode
// that read "public" for the console's people), preserving today's collaborative-annotation
// behaviour, yet never leaks to a project's user / the public API. A note flipped to
// "private" is visible only to its author + whoever is @mentioned (a mention
// writes a read grant on the shared resource_acl store).
//
// READ tightens, WRITES stay project-wide. SELECT is @descriptor-only, so the
// console-scoped public read is the ONLY broad-reach branch — private notes are
// hidden from other console users. The write verbs keep @app_scope (today's
// project-wide behaviour), so a non-author console user can still resolve/edit a note
// (the ResolveNote coda stamps resolved_by). Private notes remain undiscoverable
// (no SELECT, no list), so the broad write reach is bounded by what a console user
// can actually find.
// Note — pure relations. A note is its writer's, a user in any pool
// (owner_kind = "user"), and the owner branch matches the user_id the request
// carries. An id names one user of one users table, so no caller's id can match
// another person's note. A note a key or the platform's own work wrote is the
// project's (owner_kind = "project"), which no owner branch matches.
//
// A "public" note is written for all to see, and is read under the reach
// (notes:read.all, minted as notes_read_all), which the require below asks of
// every read: a person reads their own notes, the ones they are named on, and
// every note for all to see only where they hold the reach. A "private" note is
// visible only to its author and whoever a grant names (a mention, an
// assignment, a reply sent to its addressee). SELECT has NO @app_scope, so the
// reach is the only broad branch and private notes stay hidden from everyone
// else; the WRITE verbs keep @app_scope.
//
// A person reads a REPLY through `grantee`: addressing a reply writes a read
// grant on resource_acl, exactly as a mention does, and the note records whom
// it was sent to (reply_to_user_id). The grant is the whole decision, so a reply
// with none is internal. A shared inbox can therefore hold triage and
// correspondence in one stream without the first leaking through the second.
//
// Two routes were tried before this one and both are dead ends worth naming, so
// nobody rediscovers them. "You can read a thread if you can read the note that
// roots it" is rejected outright — `cross-object 'via object' references form a
// cycle through "note"`, which would generate mutually-recursive definers. A
// denormalised thread owner ANDed against a flag visible to users fails
// differently: any `and` in this SELECT tree forces the whole tree through an
// accessor enumerator that cannot compose the `access_mode` mode-leaf, the same
// wall the stage-1 visibility-inheritance work hit.
//
// A grant leaf has neither problem, and it needs no new column: the access fact
// lives in the table that already exists for access facts. An earlier draft of
// this work stamped a reply-to-user column instead and reached for an
// engine change to make the accessor enumerator report it correctly. The
// enumerator emits the grant branch's real `access` value off the row, so there
// was nothing to fix in the engine and nothing to denormalise.
//
// A note is shared with a user directly. There is no group principal:
// principal_kind admits "user" only.
//
object note {
  table  notes
  scoped tenant > project > org wildcard confers select, insert
  relation owner:       user | service via owner_id where owner_kind = "user"
  relation grantee: user via grant resource_acl(resource_id, principal_kind, principal_id, access) where resource_type = "note"
  //
  // REACH. A note is its writer's own, and is shared with whoever a grant on it
  // names. Every note written for all to see is the project's, and is read on
  // notes:read.all and changed on notes:write.all, which the platform works out
  // once for a request from what its holder holds and mints as notes_read_all
  // and notes_write_all. The read used to be open to any caller with no
  // user, and the three writes to any caller with no user at all, which
  // left what a caller may do to whatever stood in front of the row.
  //
  // A note written for its writer alone is not reached by either: it stays its
  // writer's, and whoever it names. The write reach is not held to notes
  // written for all, because a change is to a note its holder can find, and a
  // note they were named on is one of those.
  //
  // A NOTE IS MADE by someone, and the row says who. A console user and a
  // project's user make their own. A caller that stands as the project (a secret key,
  // an agent acting for a console user, the platform's own work) makes one no
  // user owns. A visitor's is the one kind nobody owns, and is made by a
  // caller with no user: which callers are visitors, and whether the
  // project takes their notes, is the handler's to say before the row is
  // reached. A request on a publishable key with nobody signed in is none of
  // these, so it makes none.
  permission view   = owner + mode access_mode = "public" + grantee:read   @rls maps select
  // The note written for all to see is read by a holder of the reach, and by
  // nobody for being a person alone. It stays a mode, which is what the
  // access surface reads a note's visibility from, and the reach is asked
  // beside it: a row is read by its writer, by whoever it names, or under the
  // reach.
  require view      = owner + grantee + @claim("notes_read_all", "true")
  permission edit   = @claim("notes_write_all", "true") + owner + grantee:write                                   @rls maps update
  permission create = (@claim("stands", "project") and not @row(owner_kind, "user")) + owner + (@app_scope and @row(owner_kind, "anonymous"))   @rls maps insert
  permission delete = @claim("notes_write_all", "true") + owner + grantee:delete                                  @rls maps delete
}

object record_relationship {
  table  record_relationships
  pk     (from_record_id, field_key, to_record_id)   // composite PK (EID-371 §4.1)
  scoped tenant > project > org wildcard confers select, insert, update, delete
  // An edge is READ like the record it leaves, by whoever may read that record
  // and by nobody else, as the record's points and lookups are. An edge says
  // that a record exists and what it references, which the record's own read
  // rule withholds; the owner term alone showed a caller with no user the
  // edges of records it could not read, and hid a record's edges from the
  // users it is shared with. Reverse reads go through
  // auth.records_referencing, which reads past this and is answered by the
  // referencing records' own read.
  //
  // An edge is WRITTEN by whoever may edit that record. The write coda deletes
  // and rewrites a record's edges inside the writer's own transaction, so the
  // owner term refused the rewrite for a user granted write on the record,
  // and for a user whose role grants records:write on its model, and their
  // edit left the record's edges stale. The rewrite deletes and upserts, which
  // reach only edges the writer can read, so a grant that confers write on a
  // record without read maintains no edge, as it maintains no point or lookup.
  relation rec:      record via object record->view on from_record_id
  relation rec_edit: record via object record->edit on from_record_id
  permission view   = rec                     @rls maps select
  permission create = rec_edit   @rls maps insert
  permission edit   = rec_edit   @rls maps update
  permission delete = rec_edit   @rls maps delete
  // Written where its record is written; see record_lookup.
  require edit      = @external(record_projection_write_level_admits, org_id, from_record_id, @org_id)
  require delete    = @external(record_projection_write_level_admits, org_id, from_record_id, @org_id)
}

// ============================================================================
// The PLATFORM / control plane (Demesne v3 WS6) — the tables ABOVE tenancy that
// were governed by the staff god-flag. Each now references the
// platform role via the `staff` term (→ auth.has_platform_role), composed with
// the table's real self / role / session axes. The two staff planes are kept
// distinct: `staff` (has_platform_role) is the control plane; the impersonation
// GRANT reaches the tenant subtree (it auto-applies to the tenant level-entity,
// exactly as it already does to the project level-entity).
//
// The credential tables are sign_in_methods and user_credentials, beside users:
// a person's own, the project's people in a project's pool, and staff in the
// platform's. factor_names, the names people give their own keys, follows them.
// ============================================================================

// ============================================================================
// CLAIM-ONLY GRANTS — the measured taxonomy (TTS-1046)
// ============================================================================
// A "claim-only" branch is one a caller satisfies by presenting a JWT claim, with
// no lookup of any kind behind it. It matters because the row layer's whole value
// is that it holds when the application layer is wrong about who the caller is; a
// branch that grants on a claim alone forfeits that for its table.
//
// TTS-1046 asked for a sweep of the generated SQL for the class. The sweep was run
// as a DNF analysis over every emitted policy — is there a satisfying assignment
// that performs no table lookup? — and, crucially, INLINING each auth.* definer's
// body first, because a definer name reads as an authority check whether or not its
// body is one (auth.model_reach_can_bound is pure claim containment; a syntactic
// grep for `auth.` calls it earned). Measured over 347 policy clauses:
//
//   claims leaned on            clauses  what it is
//   ------------------------  --------  -----------------------------------------
//   tenant_id + project_id         196  CONTAINMENT. The `use contained` / @scoped
//                                       project-data model. Not a defect: for these
//                                       tables RLS is the ISOLATION moat and the PDP
//                                       verb layer is the AUTHORITY gate. Changing
//                                       it is a redesign, not a fix.
//   + user_id                       57  the user self-service lane (@self).
//   sub                             23  SELF. `sub` NAMES THE CALLER, and every
//                                       member_has_perm(sub, …) already trusts it —
//                                       if sub is forgeable nothing in the system
//                                       stands. Not the TTS-1046 shape.
//   kind = 'service' (+scope)       25  the trusted service plane. Deliberate, and
//                                       already ticketed where it over-reaches
//                                       (TTS-1039 on operations/operation_versions).
//   sub + tenant_id                  6  invitations: `invited_by = sub` — self.
//   literal `true`                   1  billing_plans SELECT — the @public price
//                                       catalogue, read unauthenticated by the
//                                       pricing page. Pinned in the RLS behaviour
//                                       fixture as deliberate.
//                                       WAS 3. The two auth-bootstrap INSERTs
//                                       (the console's credential and session tables) were
//                                       closed by dropping their create permission
//                                       — see those objects for the measurement.
//                                       Their `@open` was justified by a premise
//                                       that did not support it: the bootstrap
//                                       runs on the BYPASSRLS pool, where no
//                                       policy is consulted, so the openness only
//                                       ever admitted callers the bootstrap is not.
//   tenant_id ALONE                  8  THE CLASS THIS TICKET IS ABOUT.
//
// The eight, itemised, because "name any survivor with a reason" is the acceptance:
//
//   tenants_select                 FIXED HERE — see below. It was the only member
//                                  of the class where the claim named the RESOURCE
//                                  (the tenant row itself) on an object that
//                                  otherwise gates on membership and a verb, so the
//                                  claim-only branch strictly dominated both.
//   billing_usage_alerts_insert    KEPT. `@scoped`: append a row to your claimed
//                                  tenant's alert feed.
//   editing_state_{select,insert,  KEPT. Collaborative-editing presence, tenant
//     update,delete}               containment only.
//
// Those seven are all CONTAINMENT on a tenant-scoped object — the 196-clause model
// one level up the tree — not a grant that overrides a sibling authority term. They
// are also written by the platform on the bypass pool, so the branch is a backstop
// rather than the live gate. They stay until the containment model itself is
// revisited; they are recorded here so the next sweep does not re-derive them.
//
// JOINED THE CLASS AND THEN LEFT IT. `email_copy_override` was briefly here: the
// `project wildcard` admitted workspace rows, whose containment reads as
// tenant-alone because they have no project to name. It is now gated on the
// settings verbs — see the object — so its policies carry a lookup and the class
// is back to the seven above.
// ============================================================================

// The tenant entity (the tenants table IS the tenant node). Mirrors the `project`
// level-entity: staff (control plane) + any-tenant-role (the tenant picker,
// "tenants I manage"), with the CHURNED guard on the role branch. The
// impersonation grant auto-applies (consistent with project).
//
// TTS-1046 DROPPED the `@session` disjunct. It compiled to a bare
// `id = <jwt tenant_id claim>` with no role, verb or membership lookup behind it,
// so a principal presenting a tenant_id claim for a tenant it had no relationship
// to read that tenant's row — recorded by the RLS behaviour fixture as `tenants`
// SELECT = allow for the `nonmember` principal (defined as one presenting forged
// T1 claims). It was the last `@session` term in the spec; the sibling on `project`
// went with the role keys in TTS-1023, and the two looked identical.
//
// WHO LEGITIMATELY READS `tenants`, established before removing it rather than
// assumed:
//   - tenant members      -> `tenant_access` (auth.member_memberin_tenant). This
//                            already subsumed every honest caller the @session
//                            branch admitted: role_assignments carries tenant_id on
//                            PROJECT-scoped grants too, so a project member of T
//                            satisfies it, not only a tenant-wide holder.
//   - platform staff      -> @holds(platform:manage), emitted claim-free at the top
//                            of the policy. Ambient by the data-plane split: the
//                            tenant row is identity/structure, not tenant content.
//   - staff in a tenant   -> the impersonation grant, auto-applied.
//   - login / branding /  -> NOTHING. Every `tenants` read in the platform runs on
//     the tenant picker      the request pool or an explicit WithBypassRLS — checked
//                            call site by call site (GetTenantByID x4,
//                            GetTenantStatus x2, ListAllActiveTenants,
//                            ListUserTenants, and the cohort/AI-credit readers). Not
//                            one is inside db.WithRLS, which is the only path that
//                            switches into `authenticated`. So no pre-session path
//                            needs a claim-only read, and none is declared here.
//                            The tenant picker re-verifies membership in SQL
//                            (ListUserTenants JOINs role_assignments) rather than
//                            trusting a claim.
object tenant {
  table  tenants
  level  tenant
  scoped tenant
  reach impersonation unscoped for insert, delete
  relation tenant_access: member via memberin tenant(@sub, id)
  permission view   = @holds(platform:manage) + tenant_access   @rls maps select guard status <> "CHURNED"
  // TTS-1190: founding is staff OR the account capability. The generated insert
  // policy stays honest rather than operative for self-serve — the founding
  // transaction runs BYPASSRLS because the same transaction must also seed the
  // owner grant, which no policy can authorise for a principal with no prior
  // relationship to the row (see tenantbootstrap) — but the PDP reads this rule,
  // and CreateWorkspace's HoldsPlatform gate is this rule's handler-side spelling.
  permission create = @holds(platform:manage) + @holds(platform:create_workspace)  @rls maps insert
  // Lent to the project entity, predicate-only: whether the caller holds the verb
  // across this workspace. A role given in one of its projects never answers, and
  // the project borrows each for the command it gates, so impersonation reaches it
  // as that command's own reach says: a grant across the whole workspace, never
  // one bound to a project of it.
  permission projectscreate = @holds(projects:create)  @rls predicate
  permission projectsdelete = @holds(projects:delete)  @rls predicate
  // TTS-1942: edit and delete are GONE from the authenticated plane, for the
  // reason the billing template's arms went. Every writer is on the privileged
  // pool — UpdateTenant and DeleteTenant both take h.pool directly, gated by
  // RequireVerbOrKeyLane / RequireStaffPrincipal in Go, and the purge worker has
  // its own connection — so no caller ever reached these policies.
  //
  // What they DID do was let an impersonating staff account update and delete the
  // workspace row. Those were the last 2 cells by which a tenant-wide grant
  // out-reached a workspace MANAGER, who can do neither, and a grant should confer no
  // more than the role it impersonates. Deleting somebody's workspace is not a
  // support action that should arrive as a side effect of a support grant.
  //
  // The handler gate is untouched and is where the authorization actually lives:
  // tenants:write is a static verb and the RPC mapping comes from the
  // verb registry, neither of which reads this permission.
  //
  // `create` stays because it is honest rather than operative — founding runs
  // BYPASSRLS (the same transaction seeds the owner grant, which no policy can
  // authorise for a principal with no prior relationship to the row) and the PDP
  // reads the rule.
}

// WHO STANDS WHERE, FOR THE CONSOLE'S DIRECTORY. Where a person stands is their
// memberships, whatever roles they hold there, so the directory of the console's
// people is read from memberships and never from roles: somebody whose last role
// was taken away still stands in the workspace, is on its team, and is someone
// its managers can see and take off it.
//
// workspace_roster lends `users` the workspace's half. `users` is kept above
// every workspace and cannot ask what the caller holds in one, so the question
// is asked of the person's memberships: "this person stands in the workspace the
// request stands in, and I hold members:read across it" (a NULL project in
// auth.member_has_perm matches a role given at the workspace alone). Standing
// together is not enough by itself: every member of a workspace would then see
// every other. An approved grant reaches the team of the workspace it was
// approved for when it names the whole workspace, and not when it names one
// project: a workspace's team is the workspace's, not a project's.
//
// project_peer lends the project's half: the people who stand at the project the
// request stands in, to a caller who stands there too, whatever either holds.
//
// Both are predicates over memberships with no policy of their own; `pk user_id`
// names the join column, not a unique key.
object workspace_roster {
  table  memberships
  pk     user_id
  scoped tenant
  reach impersonation unscoped
  permission roster = @holds(members:read) and @row(status, "active")   @rls predicate
}

object project_peer {
  table  memberships
  pk     user_id
  scoped tenant > project
  relation caller_stands: project_standing via object project_standing->stands on project_id
  permission peer = caller_stands and @row(status, "active")   @rls predicate
}


// Capability requests (TTS-1190) — the ask lane for capabilities: "may I have
// platform:create_workspace". Account lane wired (user_id set, tenant_id
// NULL); the tenant lane is declared in the schema (XOR check) but dormant, so
// its rows — having no owner — are reachable only by staff. The owner files and
// may withdraw their own request; only staff resolve (edit), and approval
// writes the grant in the same transaction that marks the row approved, which
// is what makes this an access request rather than a second waitlist — the
// subject already has a row for the grant to land on.
object capability_requests {
  table  capability_requests
  scoped platform
  relation owner: member via user_id
  permission view   = @holds(platform:manage) + owner   @rls maps select
  permission create = owner                             @rls maps insert
  permission edit   = @holds(platform:manage)           @rls maps update
  permission delete = @holds(platform:manage) + owner   @rls maps delete
}

// A person's own settings in the console (global): the owner manages their own,
// and staff may read. No staff write: preferences are personal.
object user_preferences {
  table  user_preferences
  pk     (user_id, key)   // composite PK
  scoped platform
  relation owner: member via user_id
  permission view   = @holds(platform:manage) + owner   @rls maps select
  permission create = owner           @rls maps insert
  permission edit   = owner           @rls maps update
  permission delete = owner           @rls maps delete
}

// Sessions, in every pool. A person reads and ends their own, whoever
// manages a project reaches its own people's, and staff the console's. NO
// rule admits making one in the console's pool: a session is written by the
// sign-in on a connection these rules do not govern, and a session row made
// under them for somebody else would be a sign-in with an id its maker chose
// (the id is the hash of the bearer value). Measured on the table this
// replaced: under the request role with claims sub=A, an insert naming user B
// returned INSERT 0 1.
object sessions {
  table  sessions
  scoped tenant wildcard > project wildcard
  relation self:         user via user_id
  permission view   = ((self + @app_scope + (@holds(users:read.all) + @claim("users_read_all", "true"))) and @row(pool_kind, "application") and @within(project)) + (((@holds(platform:manage) and not @claim("staff_reach", "role")) + self) and @row(pool_kind, "platform"))   @rls maps select
  permission edit   = ((self + @app_scope + (@holds(users:write.all) + @claim("users_write_all", "true"))) and @row(pool_kind, "application") and @within(project)) + (((@holds(platform:manage) and not @claim("staff_reach", "role")) + self) and @row(pool_kind, "platform"))   @rls maps update
  permission delete = ((self + @app_scope + (@holds(users:write.all) + @claim("users_write_all", "true"))) and @row(pool_kind, "application") and @within(project)) + (((@holds(platform:manage) and not @claim("staff_reach", "role")) + self) and @row(pool_kind, "platform"))   @rls maps delete
}

// The app-defined containment template (the generic replacement for the removed
// `settings`/`platform` sugar). Four @scoped CRUD permissions: containment alone
// grants (the console-config plane — no user axis, no roles); verb authority is
// the PDP, not RLS. An object `use`s it; on a `scoped tenant > project` object the
// @scoped perms compose to "staff OR tenant+project containment", and on a
// `scoped platform` (global) object they compose to the platform-role branch.
// Reproduces the live policies byte-for-byte under the RLS oracle.
template contained {
  permission view   = @scoped @rls maps select
  permission create = @scoped @rls maps insert
  permission edit   = @scoped @rls maps update
  permission delete = @scoped @rls maps delete
}

// Billing events (global) — pure platform-staff, all ops.
// TTS-1017: written out rather than `use contained`. On a GLOBAL object the
// containment template contributes nothing and the whole grant was the implicit
// platform-role disjunct, which retires with the `staff` term; the four verbs
// below re-state it as the capability it always was.
object billing_events {
  table  billing_events
  pk     event_id
  scoped platform
  permission view   = @holds(platform:manage)  @rls maps select
  permission create = @holds(platform:manage)  @rls maps insert
  permission edit   = @holds(platform:manage)  @rls maps update
  permission delete = @holds(platform:manage)  @rls maps delete
}

// Console-config plane (§5.3 settings pattern) — every project-scoped table whose
// RLS is the uniform "staff OR tenant+project containment". Each `use contained`.
object api_keys                        { table api_keys;                        scoped tenant > project; use contained }

// impersonation_grants — the staff grant edge itself. Bare self-read: a grantee sees
// its own grant (@self grantee_id). The staff reach this table DEFINES is suppressed
// on its own source table (EID-500 cap 4), so it does not circularly grant itself.
// Writes stay on the BYPASS bootstrap (minted by a trusted path, not an authenticated
// session), so there is no insert/update/delete policy.
object impersonation_grants {
  table  impersonation_grants
  scoped tenant
  permission view = @self(grantee_id) @rls maps select
}
// apps and app_status DO take the axis and inherit upward: an install sits at
// the project or one organisation, a caller is served the deepest install of
// each app on its composed path, and a sibling's is never visible. A status row
// lands where the reporting app acts. Writes are exact-level: an install is
// managed only where it sits.
object app_status                      { table app_status;                      scoped tenant > project > org wildcard confers select, insert; reach ancestry via inheritance for select; use contained }
object apps                            { table apps;                            scoped tenant > project > org wildcard confers select, insert; reach ancestry via inheritance for select; use contained }
object configs                         { table configs;                         scoped tenant > project; use contained }
object context_dimension_versions      { table context_dimension_versions;      scoped tenant > project > org wildcard confers select, insert; reach ancestry via inheritance for select; use contained }
object context_dimensions              { table context_dimensions;              scoped tenant > project > org wildcard confers select, insert; reach ancestry via inheritance for select; use contained }
object custom_domains                  { table custom_domains;                  scoped tenant > project; use contained }
object sign_in_provider_versions { table sign_in_provider_versions; scoped tenant > project > org wildcard confers select, insert; reach ancestry via inheritance for select; use contained }
object sign_in_providers         { table sign_in_providers;         scoped tenant > project > org wildcard confers select, insert; reach ancestry via inheritance for select; use contained }
// verified_domains: a domain a project or an organisation has proven through
// DNS, which its own sign-in issuer may vouch for. Configuration of sign-in, so
// it is contained like the providers above; the RPCs that add, check and
// remove one ask for the sign-in provider permission.
object verified_domains                { table verified_domains;                scoped tenant > project > org wildcard confers select, insert; reach ancestry via inheritance for select; use contained }
// design_tokens and design_token_versions DO take the axis, and inherit upward
// with it — an org overrides its ancestor's palette and falls back to it where
// it does not. The VERSIONS table carries the identical reason rather than
// riding on the current row's: a version is read to show what a token used to
// be, and a history an org could not see would make its own audit trail stop at
// whatever it inherited. Topology block, "the closure".
object design_token_versions           { table design_token_versions;           scoped tenant > project > org wildcard confers select, insert; reach ancestry via inheritance for select; use contained }
object design_tokens                   { table design_tokens;                   scoped tenant > project > org wildcard confers select, insert; reach ancestry via inheritance for select; use contained }
// login_pages and login_page_versions take the axis and inherit upward like
// the design tokens a page names: a level's default page sits at the project
// or one organisation, an app's page at the project as the app is, and a
// sign-in reads every page on its path. Writes are exact-level, so an
// organisation edits its own page standing in it. Foir's own page belongs to no
// project and is never on this lane.
object login_page_versions             { table login_page_versions;             scoped tenant > project > org wildcard confers select, insert; reach ancestry via inheritance for select; use contained }
object login_pages                     { table login_pages;                     scoped tenant > project > org wildcard confers select, insert; reach ancestry via inheritance for select; use contained }
object embeddings                      { table embeddings;                      scoped tenant > project > org wildcard confers select, insert; use contained }

// events — the durable event spine (TTS-974). Deliberately NOT `use contained`:
// the table is append-only, so it declares view + create and NOTHING else. The
// generator's orphan sweep then drops events_update / events_delete, which means
// no authenticated request-path caller can rewrite or erase history — RLS, not a
// handler convention, is what makes the log tamper-evident. The two legitimate
// mutations both sit outside the authenticated lane: the TTS-976 sequencer stamps
// seq on the BYPASSRLS relay, and retention is a partition DROP (DDL, not DML).
//
// The predicate is the ordinary @scoped tenant+project containment, same as
// hook_deliveries. Tenant-plane events carry project_id NULL and so are invisible
// on the RLS lane — which is the same shape tenant-hook rows in hook_deliveries
// already have, and is fail-closed. TTS-981 owns the read for a project's
// predicate; refining it is a DROP/CREATE POLICY, which costs nothing on a hot
// table. What genuinely cannot be retrofitted cheaply — ENABLE + FORCE, and the
// tenant_id/project_id columns the predicate needs — is right from migration one.
// events — the durable fact log, now partitioned by organization as well.
//
// `> org wildcard` is what turns the edge's REFUSAL into a confinement. Before
// the column existed, an org-confined credential asking for the event-log tail
// was denied outright, because a filter with no org awareness would have
// returned zero events and zero is indistinguishable from a quiet system. With
// the axis declared, the row layer answers the question: an org claim sees that
// org's events plus the project-shared tier, and a project-level caller with no
// claim sees the shared tier alone.
//
// WHICH ORG A ROW CARRIES is the org of the thing that changed, stamped by the
// emit path, never the claim of whoever changed it — a caller standing in one
// organization can change a project-shared record, and that change belongs to
// everyone.
object events {
  table  events
  scoped tenant > project > org wildcard confers select, insert
  permission view   = @scoped @rls maps select
  permission create = @scoped @rls maps insert
  // An event about a person stands where the act stands, and a person may
  // stand at many places: reading one asks whether the reader reaches them.
  require view      = @external(event_subject_reached, subject_user_id)
}

// event_deliveries — relay-time subscriber fan-out (TTS-978). The same
// containment predicate as hook_deliveries, deliberately: it IS hook_deliveries'
// shape, resolved at relay time instead of inside the originating write
// transaction, and the dispatcher below it is unchanged. Giving it a different
// predicate would mean the delivery log a project's user can read changes visibility
// the moment the claim source is swapped, which is exactly the kind of silent
// behavior change this phase's two-step migration exists to avoid.
// event_deliveries carries the axis for the same reason events does: a delivery
// row names the organization of the fact it is delivering, so an org reading its
// own delivery log sees its own attempts and the project-shared ones, and not
// another tenant's endpoint failures.
object event_deliveries {
  table  event_deliveries
  scoped tenant > project > org wildcard confers select, insert
  permission view   = @scoped @rls maps select
  permission create = @scoped @rls maps insert
  permission edit   = @scoped @rls maps update
  permission delete = @scoped @rls maps delete
  // As for events: a delivery of an event about a person is read only by
  // whoever reaches that person.
  require view      = @external(event_subject_reached, subject_user_id)
}

object field_slow_query_log            { table field_slow_query_log; pk (tenant_id, project_id, resource_type, resource_key, field_path, operator); scoped tenant > project; use contained }
object file_storage_usage              { table file_storage_usage;              scoped tenant > project; use contained }
// hooks — a subscription. The org column says which organization the
// subscription is FOR, so a fan-out selects one org's endpoints rather than
// every endpoint in the project; NULL means project-wide, which is what every
// existing subscription is.
object hooks                           { table hooks;                           scoped tenant > project > org wildcard confers select, insert; use contained }
// install_tickets takes the axis exact-level: a ticket is stamped with the level
// its InstallApp stood at and redeemed only from there.
object install_tickets                 { table install_tickets;                 scoped tenant > project > org wildcard confers select, insert; use contained }
// model_versions — a definition's schema history. Reached through the SAME
// binding lane as the definition itself, because it answers a question about the
// definition: "what did this schema used to be".
//
// It cannot be `scoped tenant > project`. A version row carries the project it
// was AUTHORED from, which is honest provenance but is not an access key, and
// declaring the project level forces an equality containment AND on that column
// (see the note on scope levels above), which would hide a model's history from
// every session except the one that happened to write the row — an empty
// history, and no push-time optimistic locking on that model. Tenant containment
// stays; the project term is what was wrong.
//
// `binder` borrows model_reach, and model_versions.model_id IS a models.id, so
// the predicate applies unchanged.
// It admits precisely the callers the old project-exact rule did, plus a
// tenant-level models:read holder who can already read the model's full `fields`
// through the model itself.
//
// No @kind("service"): no service reads this table. api-public and workers do
// not touch it, and services/mcp reaches it through the platform RPC.
// ⚠️ scoped tenant > project, and it was `scoped tenant` while the table carried
// project_id. The emitted policy then mentioned no project at all, so a caller
// standing in project A read project B's model definition history — every field
// of every version, across the tenant's projects, with nothing failing.
//
// The column was always there and always written (5,788 production rows, none
// NULL), so this is containment catching up with the data rather than a new
// axis. TTS-2258 took this table to the ORGANISATION axis and the project gap
// survived it, because the coverage guard of the day asked whether a table was
// classified rather than whether its declared containment reached the lowest
// level its own columns could express.
object model_versions {
  table  model_versions
  scoped tenant > project
  // TWO BINDERS, AND THE SPLIT IS THE POINT. model_versions has no organization
  // column and needs none: it keys on model_id and borrows `object model_reach`
  // for the whole of its containment. Borrowing ONE form for all four commands
  // is what made a model's history contained more tightly than the model itself
  // — every project-level model, which is every model that existed before
  // organizations did, had an EMPTY version history for any org-confined caller,
  // in a flat project with no nesting at all. So the SELECT takes the read form
  // and the writes keep the strict one: a descendant reads the history of a
  // definition it inherited and cannot write it, the same line `confers select`
  // draws for the definition tables themselves.
  relation binder: member via object model_reach->bound on model_id
  relation binder_read: member via object model_reach->bound on model_id for select
  permission view   = (@holds(platform:manage) and not @claim("staff_reach", "role")) + @holds(models:read)  + binder_read   @rls maps select
  permission create = (@holds(platform:manage) and not @claim("staff_reach", "role")) + @holds(models:write) + binder   @rls maps insert
  permission edit   = (@holds(platform:manage) and not @claim("staff_reach", "role")) + @holds(models:write) + binder   @rls maps update
  permission delete = (@holds(platform:manage) and not @claim("staff_reach", "role")) + @holds(models:write) + binder   @rls maps delete
}
// models — the model, schema content included. The fold put `fields` and
// `config` on this row, so the policy that governed the CONTENT is the one that
// has to govern this table.
//
// It does NOT `use contained`, and it did until the fold. That template is
// containment alone — any plane whose claims name the tenant and project, with
// no role, capability or membership lookup — which was the right gate for a row
// carrying a key and a pointer, and is the wrong one for a row carrying the
// schema. The floor that protected the content is the one below.
//
// The read lane keeps the three no-capability planes and tenant membership,
// because the record data plane resolves a model's fields under the CALLER's RLS
// on every record read and those planes hold nothing else to check. That is
// model_reach's `bound` predicate, which is the lane those reads already went
// through; it is spelled inline because there is no second table to bridge to.
//
// platform:manage is not a bare disjunct: it travels through project_staff,
// which pins it to the session's project. A bare one is what let a staff session
// in one project read every project's schema in the tenant.
object models {
  table  models
  scoped tenant > project > org wildcard confers select, insert
  reach ancestry via inheritance for select
  relation tenant_member:   member via memberin tenant(@sub, tenant_id)
  relation project_read:    member via object project->modelsread    on project_id
  relation project_write:   member via object project->modelswrite   on project_id
  relation project_staff:   member via object project->modelsstaff   on project_id
  relation project_service: member via object project->modelsservice on project_id
  relation stands_here: project_standing via object project_standing->stands on project_id
  permission view   = @scoped and (project_read + project_staff + project_service
                    + tenant_member + stands_here + @kind("scoped") + @kind("service"))
                    @rls maps select
  permission create = @scoped and (project_write + project_staff + project_service)   @rls maps insert
  permission edit   = @scoped and (project_write + project_staff + project_service)   @rls maps update
  permission delete = @scoped and (project_write + project_staff + project_service)   @rls maps delete
}

// model_reach (TTS-1023, narrowed TTS-1050) — a PREDICATE-ONLY object over
// `models`, lending model_versions its "this model is mine to read" reach. It
// emits no policy of its own (`models` above owns the table's policies); it is
// invoked as model_reach_can_bound(model_versions.model_id).
//
// WHO READS A MODEL, WHICH IS THE WHOLE DESIGN. Four callers read one, and only
// a person can hold a capability:
//
//   a person       kind="user", sub = their user id, user_id = the person a row
//                  is theirs for. member_has_perm / member_memberin_tenant are
//                  true for them where their roles say so.
//   a person who stands in the project
//                  an active membership there (`project_standing`), whichever
//                  people they sign in among: a project's schema is what its
//                  own records are read and written through.
//   scoped token   kind="scoped", sub="scoped:<jti>" — an id in no id-space, with no
//                  role_assignments row anywhere, so it resolves every capability to
//                  false. Until TTS-1050 it READ as a person while being none;
//                  `kind` tells the truth about it (services/internal/db/rls.go,
//                  BuildRLSClaims).
//   service        kind="service" (api-public, config-as-code).
//
// TTS-1050 — WHAT WAS WRONG. This permission was a bare `@scoped`, so the definer
// compiled to pure claim containment:
//
//   EXISTS (SELECT 1 FROM models
//            WHERE models.id = <the model>
//              AND ((tenant_id = jwt.tenant_id OR impersonation)
//                   AND project_id = jwt.project_id))
//
// no role lookup, no verb, no membership join. Because the borrowing policy CALLS
// auth.model_reach_can_bound(id), it READ as an authority check while the
// claim-only-ness sat one level down, inside the definer — the same "names are not
// semantics" failure mode as auth.is_project_viewer recursing into
// the old workspace-owner definer. A principal that belonged to no project of the claimed
// tenant reached that tenant's model schema on the strength of its claims alone;
// the RLS behaviour fixture recorded it as SELECT = allow for the `nonmember`
// principal (grants on sibling T2, probing with forged T1/P1 claims).
//
// WHAT IT IS NOW. The containment stays, ANDed with a term each caller is read
// by:
//
//   a person           a MEMBER of the row's tenant (auth.member_memberin_tenant
//                      over role_assignments), or standing in the row's project
//                      (an active memberships row). Relationships the row layer
//                      verifies, not claims it is handed.
//   a token or service named explicitly by `kind`. An allowlist: a new kind of
//                      caller gets no reach until somebody writes it down here.
//
// WHY MEMBERSHIP AND NOT @holds(models:read). The first cut of this object carried
// @holds(models:read) — "the verb check the hand-written lane never had" — and had to
// be reverted (TTS-1023): the record data plane resolves a model's config and field
// schema under the CALLER's RLS on EVERY record read and write, so requiring a
// verb there took the schema away
// from the callers the schema exists to serve and surfaced as "model not found"
// rather than as a denial. That argument did not stop at the callers who hold no
// verb: roles are COMPOSED (TTS-1017), so a role carrying records:read and
// not models:read is expressible and legitimate, and gating the data plane's schema
// resolution on models:read would break its record reads the same silent way.
// Membership is the term that separates "a principal of this workspace" from "a
// principal presenting this workspace's id", which is exactly the defect, and it
// costs no composed role its record reads.
//
// The invariant this expresses is still the right one: a model's version history
// is reachable through this lane exactly when the model itself is reachable BY A
// PRINCIPAL OF THAT TENANT.
//
// The models:read / models:write tightening is NOT lost — it sits where it belongs,
// on `models`' own branches, the project->modelsread|modelswrite bridges. Nobody
// authors a model schema without models:write.
//
// Platform staff are unaffected: they reach it through project_staff, outside this
// lane entirely.
//
// `pk id` names the join column, not a unique key.
// model_reach is a REACH object over the same table as `models`, and it is what
// model_versions borrows through. It has to carry the same axes `models` does:
// the definer it generates is the only org check on a version row, because
// model_versions keys on model_id and not on an org column of its own. Left at
// `tenant > project` it granted every organisation in the project the fields and
// config of every other organisation's models.
//
// ⚠️ THE WILDCARD AND THE `confers` LIST BELOW DO NOT REACH THIS PERMISSION, and
// declaring them here is not what makes the read work. `bound` is
// `@rls predicate`, so it maps no table op; `scopeIsWildcardFor(level, op)` is
// asked with an empty op and falls through to the strict `IS NOT DISTINCT FROM`
// branch, and `Grant.Confers(op)` is false for the same reason, which withholds
// the ancestry reach too. One miss, both symptoms. The clauses stay because the
// object genuinely is scoped that way and the coverage guards read the
// declaration — but the READ form is assembled in demesnespec/definerpatch.go,
// as a second definer the policy patch hands to the SELECT alone. Changing
// either of them without the other puts a definition's history back out of step
// with the definition, which surfaces as an empty history rather than as a
// denial. Neither `maps select predicate` nor `maps select` on its own is
// available: the first is refused as contradictory, the second emits a duplicate
// models_select that silently replaces the real one.
object model_reach {
  table  models
  pk     id
  scoped tenant > project > org wildcard confers select, insert
  reach ancestry via inheritance for select
  relation tenant_member: member via memberin tenant(@sub, tenant_id)
  relation stands_here: project_standing via object project_standing->stands on project_id
  permission bound = @scoped and (tenant_member + stands_here + @kind("scoped") + @kind("service"))   @rls predicate
}
// app_install is a REACH object over the same table as `apps`, as model_reach
// is over `models`. It lends one predicate: the caller may write apps, at the
// install a row names. `operations` borrows it for the rows an install owns,
// which that install's update rewrites and its removal deletes.
//
// The authority is in the predicate. `apps` itself is `use contained`, so its
// own verbs are containment alone and are decided at the verb's gate: a
// borrower that needs an authority check at the row cannot take it from them.
//
// `write` is `@rls predicate`, so it maps no table op and takes the strict form
// of each axis, the organisation's too: an install made for one organisation is
// written from that organisation, which is where the verbs that write it stand.
object app_install {
  table  apps
  pk     id
  scoped tenant > project > org wildcard confers select, insert
  permission write = @scoped and @holds(apps:write)   @rls predicate
}
object operation_dead_letters          { table operation_dead_letters;          scoped tenant > project > org wildcard confers select, insert; use contained }
object operation_executions {
  table  operation_executions
  scoped tenant > project wildcard > org wildcard confers select, insert
  relation owner: user | service via user_id
  // A run is its person's, where it was made for one. An agent's run and the
  // operations it calls are one tree here, so every run in the project is read
  // on operations:read or agents:read, and the nodes waiting on an approval on
  // approvals:read as well. Made and moved on on operations:execute, and
  // cleared on operations:write.
  permission view   = @app_scope + owner + @holds(operations:read) + @holds(agents:read) + @holds(approvals:read)      @rls maps select
  permission create = @app_scope + owner + @holds(operations:execute)   @rls maps insert
  permission edit   = @app_scope + owner + @holds(operations:execute)   @rls maps update
  permission delete = @app_scope + owner + @holds(operations:write)     @rls maps delete
  require view   = @external(stands_in_the_requests_project, project_id, @project_id)
  require create = @external(stands_in_the_requests_project, project_id, @project_id)
  require edit   = @external(stands_in_the_requests_project, project_id, @project_id)
  require delete = @external(stands_in_the_requests_project, project_id, @project_id)
}
// What an agent's run holds beyond its node: the definition it started with,
// its caller, its thread and what pays for it. Read as the run's own node is,
// by its person and on agents:read, and in the organisation the run stood in
// as its node is: a run of one organisation is no other's to read. Written by
// the platform for the run, on the person's claims or on the bypass lane for a
// visitor's run. Ask Fóir's run with no project open stands at the
// workspace, in no project, and is read only there.
object agent_runs {
  table  agent_runs
  scoped tenant > project wildcard > org wildcard confers select, insert
  relation owner: user | service via user_id
  permission view   = @app_scope + owner + @holds(agents:read)      @rls maps select
  permission create = @app_scope + owner + @holds(agents:execute)   @rls maps insert
  permission edit   = @app_scope + owner + @holds(agents:execute)   @rls maps update
  permission delete = @app_scope + owner + @holds(agents:write)     @rls maps delete
  require view   = @external(stands_in_the_requests_project, project_id, @project_id)
  require create = @external(stands_in_the_requests_project, project_id, @project_id)
  require edit   = @external(stands_in_the_requests_project, project_id, @project_id)
  require delete = @external(stands_in_the_requests_project, project_id, @project_id)
}
// The definitions. Contained by the project; what a caller may do with one is
// the verb's: agents:read and agents:write, brief:read and brief:write. A run
// reads the copy it is served on the platform's own lane, whoever its caller.
object agents         { table agents;         scoped tenant > project; use contained }
object project_briefs { table project_briefs; pk project_id; scoped tenant > project; use contained }
// operation_versions is on the ORDINARY chain, `tenant > project > org wildcard`,
// and was not always. It used to be `scoped tenant` with the project axis
// expressed per verb as `@within(project nullable)`, a leftover of the layer kept
// because the containment template hard-wires `project_id = jwt.project` and a
// NULL-project version row would have become unreachable by everyone but platform
// staff. The note here used to say tightening belonged with making that column
// NOT NULL rather than with a scoping change.
//
// 20270601140000 did exactly that. The nullable tolerance was never load-bearing:
// the only writer passes the handler's own project, and the foreign key to
// operations is ON DELETE CASCADE, so every version row has a live operation whose
// project_id is NOT NULL and a backfill from the parent cannot strand one.
//
// What forced the question was the ORG axis rather than tidiness. It could not be
// added per verb: TestOrgLevel_EmittedClaimReadersMatchTheDeclaredOptIn requires
// that the set of objects whose policies READ the org claim equals the set that
// DECLARE the level, and it refuses a term that leaks into an object which did not
// ask for it. That invariant is what makes the axis auditable from the declaration
// alone, so the object took the chain instead of a shortcut.
//
// TTS-1039: the bare `@within(project)` disjunct is DELETED from all four
// permissions. It cited no role definer, which is why it never showed up in a
// key-matching sweep, and that is exactly what made it the worst branch on the
// table: `project_id = jwt.project_id` grants on the raw session claim with NO
// role, permission or membership lookup of any kind, so every principal that
// could put a tenant+project pair in its claims — including a non-member
// presenting FORGED claims — had full CRUD on that project's operation history.
// Nothing replaces it; the capability terms below are the whole gate.
//
// The project branch is the `via object project->opsread|opswrite` bridge
// (declared on the project entity above). It is the CAPABILITY check: "does the
// caller hold operations:read / operations:write at the project this row belongs
// to", which a plain @holds on a `scoped tenant` object cannot express. The
// bridge alone is not containment — it resolves against the ROW's project with no
// reference to the session's, and auth.member_has_perm treats a role assignment
// with a NULL project_id as a wildcard over every project in the tenant, which is
// the shape every tenant founder holds — so `@within` is what bounds it.
//
// Deleting an operation cascades its operation_versions (ON DELETE CASCADE), and
// the cascade bypasses RLS as a referential-integrity action, so the version rows
// go with it.
//
// `@scoped` stays as the marker that tenant containment BOUNDS every branch below
// it; with capability terms present it contributes no disjunct of its own.
object operation_versions {
  table  operation_versions
  scoped tenant > project > org wildcard confers select, insert
  reach ancestry via inheritance for select
  relation proj_read:  member via object project->opsread  on project_id
  relation proj_write: member via object project->opswrite on project_id
  // This policy never keyed on operation_id: it keys on the version row's OWN
  // tenant_id and project_id. An operation's history is project-exact, which is
  // what `@within(project nullable)` bounds. Reaching for `binder` here instead
  // measurably widened it (a bare
  // @holds(platform:manage) crossing projects, an unbounded @kind("service")) and
  // narrowed it in the same pass (project-tier holders lost the bridge they need,
  // because @holds on a `scoped tenant` object matches only tenant-level grants).
  // TestRankRLSMatrix is what said so, cell by cell.
  permission view   = @scoped
                    and ((@holds(platform:manage) and not @claim("staff_reach", "role"))
                       + proj_read
                       + @holds(operations:read)
                       + @kind("service"))
                    @rls maps select
  permission create = @scoped
                    and ((@holds(platform:manage) and not @claim("staff_reach", "role"))
                       + proj_write
                       + @holds(operations:write)
                       + @kind("service"))
                    @rls maps insert
  permission edit   = @scoped
                    and ((@holds(platform:manage) and not @claim("staff_reach", "role"))
                       + proj_write
                       + @holds(operations:write)
                       + @kind("service"))
                    @rls maps update
  permission delete = @scoped
                    and ((@holds(platform:manage) and not @claim("staff_reach", "role"))
                       + proj_write
                       + @holds(operations:write)
                       + @kind("service"))
                    @rls maps delete
}

// operations — the per-project BINDING. `scoped tenant > project` is what puts
// containment above every authority term, which is the whole point of the split: no
// branch below can opt out of it.
//
// It does NOT `use contained`, and the difference is deliberate. That template is
// containment ALONE, which admits any plane whose claims match the tenant and
// project — including the project users' and scoped-token planes. `models` is contained
// that way on purpose: the record data plane resolves a model's fields through
// a model's fields under the CALLER's RLS on every record read, and
// those planes hold no capability to check. Nothing equivalent reads operations. The
// pre-split policy admitted the console plane and @kind("service") and no other, and
// widening that is a decision to be ratified rather than a side effect of picking a
// template (a test of the platform's authz package pins it).
object operations {
  table  operations
  scoped tenant > project > org wildcard confers select, insert
  reach ancestry via inheritance for select
  relation tenant_member:   member via memberin tenant(@sub, tenant_id)
  relation project_read:    member via object project->opsread   on project_id
  relation project_write:   member via object project->opswrite  on project_id
  relation project_staff:   member via object project->opsstaff  on project_id
  //
  // platform:manage is a disjunct here and that is safe now, which it was not before:
  // @scoped is the OUTER conjunct on a `tenant > project` object, so staff authority
  // is evaluated inside the project term rather than beside it. The production leak
  // was a staff branch carrying no project term at all; it carries one structurally
  // here, and cannot stop carrying it without changing the object's scope line.
  //
  // The project bridges and the tenant-member read lane arrive with the fold.
  // They are what the retired definition table granted on a project-owned row,
  // so carrying them here leaves the reach of an operation's content exactly
  // where it was rather than narrowing it to the capability holders the binding
  // alone admitted.
  permission view   = @scoped and (@holds(operations:read)  + (@holds(platform:manage) and not @claim("staff_reach", "role")) + @kind("service")
                    + project_read + project_staff + tenant_member)   @rls maps select
  //
  // An installed app's operations are written from its manifest, by the install,
  // by each update and by each change of its mappings, and removed with it. The
  // verbs that do so take apps:write, and what they give each operation is
  // bounded by what their caller holds. So a row an install owns (config_id is
  // that install's row, sitting where the caller stands) is written by whoever
  // may write apps. Without this arm the verb admitted somebody who manages
  // apps and does not write operations, and the row refused them: an install, an
  // update or an uninstall answered with the database's own refusal. Writing
  // any other operation stays operations:write.
  //
  // The arm borrows app_install->write, which asks for apps:write at the install
  // itself. Borrowing apps->edit would not do: that is containment alone, and a
  // borrowed term that checks no authority reads as a gate here and is none.
  relation app_writer:      member via object app_install->write on config_id
  permission create = @scoped and (@holds(operations:write) + (@holds(platform:manage) and not @claim("staff_reach", "role")) + @kind("service")
                    + project_write + project_staff + app_writer)   @rls maps insert
  permission edit   = @scoped and (@holds(operations:write) + (@holds(platform:manage) and not @claim("staff_reach", "role")) + @kind("service")
                    + project_write + project_staff + app_writer)   @rls maps update
  permission delete = @scoped and (@holds(operations:write) + (@holds(platform:manage) and not @claim("staff_reach", "role")) + @kind("service")
                    + project_write + project_staff + app_writer)   @rls maps delete
}
object notification_categories         { table notification_categories;         scoped tenant > project > org wildcard confers select, insert; reach ancestry via inheritance for select; use contained }
// placements sit at their install's level (stamped through config_id) and
// inherit upward with it.
object placements                      { table placements;                      scoped tenant > project > org wildcard confers select, insert; reach ancestry via inheritance for select; use contained }
// project_locales DOES take the axis and inherits upward: an org adds a locale
// its ancestor does not offer and keeps the ones it does, which is the whole
// point of a per-org overlay resolved deepest-first. Topology block, "the
// closure".
object project_locales                 { table project_locales;                 scoped tenant > project > org wildcard confers select, insert; reach ancestry via inheritance for select; use contained }
// project_public_settings — project config that must reach the PUBLIC plane
// (TTS-1099). `use contained` is topology gating, so a caller with no subject
// can read it: api-public builds the per-project GraphQL schema on an internal
// token, and `projects` — the project topology NODE — is gated on console roles and can
// never answer that read. Membership of this table IS the public/private
// boundary; anything a public key must not see stays on `projects`.
object project_public_settings         { table project_public_settings;         scoped tenant > project; use contained }
// public_query_names — the registry of public root-query names claimed by models
// and KIND_QUERY operations, one row per name per LEVEL: the project tier or one
// organisation. A claim sits at its claimant's level, because a name lives in a
// composed schema exactly the way the definition that mints it does.
//
// SCOPED TO ORG AND READ UPWARD, like the definition tables, and for their
// reason. An organisation's composed schema holds the project's names, its own
// and its ancestors', so those are the claims it may read; a sibling's are not
// in any schema it is served, and a claim names the model key behind it, so a
// sibling's claim row is a sibling's private model key. patchDefinitionInheritance
// swaps the SELECT to the inheritance set; writes keep the strict level.
//
// Nothing that needs the whole project reads through this policy, which is what
// makes the containment free rather than a trade:
//
//   - uniqueness is public_query_names_live_unique plus the SECURITY DEFINER
//     auth.guard_public_query_name_claim, and neither consults RLS, so a writer
//     is refused on a claim it cannot see — the models:write holder with no
//     operations:read this registry was built for
//   - the refusal's incumbent lookup runs on the privileged pool, and the
//     one-time registration pass runs through a bypass transaction
//   - what does run under the caller's claim is the claim INSERT and the release
//     DELETE, and both only ever touch the caller's own level, because the model
//     and operation write policies pin a writer there
object public_query_names              { table public_query_names;              scoped tenant > project > org wildcard confers select, insert; reach ancestry via inheritance for select; use contained }
object publish_batch_items             { table publish_batch_items;             scoped tenant > project > org wildcard confers select, insert; use contained }
object publish_batches                 { table publish_batches;                 scoped tenant > project > org wildcard confers select, insert; use contained }
object push_credentials                { table push_credentials;                scoped tenant > project; use contained }
// record_acl is governed as the `record_grant` object above (moat-preserving grant
// writes), NOT the containment-only template pattern.
// The geo subsystem, which mirrors embeddings. A point is a projection of its
// record, written where its record is written; see record_lookup.
object record_geometry {
  table  record_geometry
  scoped tenant > project > org wildcard confers select, insert, update, delete
  // A point is written by whoever may edit its record, and by nobody else. The
  // write coda maintains the points inside the writer's own transaction, as it
  // does the lookups and the typed index, so the writes follow the record's
  // EDIT the same way theirs do. Containment alone let any user standing
  // in an organisation move or remove the points of a record they could not
  // edit. The table carries no owner of its own, so there is no owner term:
  // the no-user branch and the record's edit are the whole of it.
  //
  // A point is READ by whoever may read its record, and by nobody else. A point
  // says that a record exists and where it is, which is what the record's own
  // read rule withholds; containment alone let a caller count, box or rank by
  // distance the points of records it could not read.
  relation rec:      record via object record->view on record_id
  relation rec_edit: record via object record->edit on record_id
  permission view   = rec                     @rls maps select
  permission create = rec_edit   @rls maps insert
  permission edit   = rec_edit   @rls maps update
  permission delete = rec_edit   @rls maps delete
  require edit      = @external(record_projection_write_level_admits, org_id, record_id, @org_id)
  require delete    = @external(record_projection_write_level_admits, org_id, record_id, @org_id)
}
object refresh_tokens                  { table refresh_tokens;                  scoped tenant > project; use contained }   // EID-254
object relying_parties                 { table relying_parties;                 scoped tenant > project; use contained }
object auth_client_secrets             { table auth_client_secrets;             scoped tenant > project; use contained }   // a confidential app's secrets stand where the app does

// role_assignments + roles — the PERMISSION tables. Written out rather than
// `use contained` because they carry an ambient staff branch the template does
// not give them (TTS-1044, the data-plane split decided on TTS-1017).
//
// The split is by the PLANE OF THE DATA, not by mechanism: staff reach TENANT
// CONTENT (records, files, users, billing) only under a time-boxed,
// audited impersonation grant, but staff reach IDENTITY AND PERMISSIONS
// ambiently, because that is the help-desk case — "manage all other users'
// permissions in all tenants" is the stated requirement for platform:manage,
// and these two tables ARE the permissions. Without the branch the requirement
// is simply unmet: every other identity/permission table already has it
// (users, credentials, sessions, invitations), and these two
// were the hole.
//
// Deliberately NOT extended to the audit trail. That widening was not asked for,
// the tenant's audit:read holder already covers the read, and an ambient staff
// read of a tenant's action trail is exactly the kind of
// reach the impersonation record exists to make legible.
//
// THE TENANT BRANCH MOVED, AND IT HAD TO. `@scoped` is not a disjunct: the
// emitter folds every other term INSIDE the containment block
// (`containment AND (t1 OR t2 …)`), so `@scoped + @holds(platform:manage)`
// compiles to `containment AND staff` — a narrowing, the exact opposite of the
// intent. There is no grammar for "containment alone OR staff" on a non-global
// object; the only top-level branches demesne emits are the impersonation grant
// and the retired platform-role subject. So adding a staff branch necessarily
// means naming what the TENANT's branch is, and bare containment — an authority
// check that checks no authority — is not defensible on the two tables that
// decide everyone else's access. They take the verbs that already govern the
// same surface in the PDP: members:read to see who has access, members:write
// to change it (the CreateRole / AssignRole floor). Same repoint TTS-1023 made
// to users and invitations, on the same argument: one rule, both layers.
//
// No runtime behaviour changes today — every roles/role_assignments query runs
// on the BYPASSRLS request pool (verified: roles.go, users.go,
// auth_clients.go, configs/bundle.go). This is the row-layer
// backstop those queries do not currently have.
// ⚠️ THIS KEEPS THE UNBOUNDED `project wildcard`, AND THAT IS A DECISION.
//
// `(project_id IS NULL OR project_id = claim)` lands in every command here,
// including update and delete, which on the notification pair was a cross-project
// write and is bounded there to select and insert. It is safe on this object for a
// reason that does not hold there: the authority term is
// `auth.member_has_perm(sub, tenant_id, project_id, <verb>)`, keyed on THE ROW'S OWN
// project_id. A workspace-wide row therefore demands workspace-scope authority, so
// the wide containment is already compensated by a scope-relative permission check.
//
// The notification pair authorises by its owner and by what a holder holds, and
// bounds its wildcard to select and insert. If this object's permissions ever
// move off `@holds`, the wildcard has to be bounded with them.
//
// THE ROLES A MEMBERSHIP HOLDS, for every pool. A role is read by whoever
// holds it, by whoever reads the members of its place, and by whoever may view
// the organisation it is held at, which is how an organisation's members see
// who else is in it. Its terms are its own and not borrowed from the
// membership: a role given where the person has no membership makes that
// membership in the same statement, and a borrowed rule cannot see a row its
// own statement is making.
//
// A caller that is one of Foir's services acting for a key or an application
// writes the roles given in the one project its claims name: @within(project)
// pins the row's project to the claim, and a role given across a workspace,
// in no project, is never one of them.
//
// It is confined the way its membership is: a credential confined to one
// organisation reaches the roles held at that organisation and beneath it,
// and one that carries no organisation reaches the project's. A role names
// the place it is held at, and one named for the whole project is never
// quietly given at the one organisation its writer happened to stand in: the
// place is the membership's, pinned by
// membership_roles_hold_to_their_membership.
object membership_roles {
  table  membership_roles
  scoped tenant > project wildcard
  relation self:     user via holder_id
  relation org_view: organizations via object organizations->view on org_id
  relation confined: service via closure organization_closure(ancestor_id, descendant_id) on org_id from claim org_id missing allow
  permission view   = self + (@holds(platform:manage) and not @claim("staff_reach", "role")) + @holds(members:read) + (@claim("members_read", "true") and @within(project) and confined) + org_view   @rls maps select
  permission create = (@holds(platform:manage) and not @claim("staff_reach", "role")) + @holds(members:write) + (@claim("members_write", "true") and @within(project) and confined)   @rls maps insert
  permission edit   = (@holds(platform:manage) and not @claim("staff_reach", "role")) + @holds(members:write) + (@claim("members_write", "true") and @within(project) and confined)   @rls maps update
  permission delete = (@holds(platform:manage) and not @claim("staff_reach", "role")) + @holds(members:write) + (@claim("members_write", "true") and @within(project) and confined)   @rls maps delete
}
// ⚠️ THIS KEEPS THE UNBOUNDED `project wildcard`, AND THAT IS A DECISION.
//
// `(project_id IS NULL OR project_id = claim)` lands in every command here,
// including update and delete, which on the notification pair was a cross-project
// write and is bounded there to select and insert. It is safe on this object for a
// reason that does not hold there: the authority term is
// `auth.member_has_perm(sub, tenant_id, project_id, <verb>)`, keyed on THE ROW'S OWN
// project_id. A workspace-wide row therefore demands workspace-scope authority, so
// the wide containment is already compensated by a scope-relative permission check.
//
// The notification pair authorises by its owner and by what a holder holds, and
// bounds its wildcard to select and insert. If this object's permissions ever
// move off `@holds`, the wildcard has to be bounded with them.
//
// A CALLER THE CHECK ADMITTED, IN ITS OWN PROJECT. A key, or a token that
// carries a person's grants, holds no role, so no @holds term answers for it.
// What it may do is decided before the row is reached: the contract's check and
// the handler ask it for roles:read or roles:write. Here it reads and writes
// the roles kept in the one project its claims name: @within(project) pins the
// row's project to the claim, which a workspace's role, kept in no project,
// does not satisfy. A request on a publishable key is a service at this layer
// too, and is named out. It deletes nothing.
object roles {
  table  roles
  scoped tenant > project wildcard
  permission view   = (@holds(platform:manage) and not @claim("staff_reach", "role")) + @holds(roles:read) + @holds(members:read) + (@kind("service") and @within(project) and not @claim("credential", "public"))   @rls maps select
  permission create = (@holds(platform:manage) and not @claim("staff_reach", "role")) + @holds(roles:write) + (@kind("service") and @within(project) and not @claim("credential", "public"))   @rls maps insert
  permission edit   = (@holds(platform:manage) and not @claim("staff_reach", "role")) + @holds(roles:write) + (@kind("service") and @within(project) and not @claim("credential", "public"))   @rls maps update
  permission delete = (@holds(platform:manage) and not @claim("staff_reach", "role")) + @holds(roles:write)   @rls maps delete
}
object schedules                       { table schedules;                       scoped tenant > project > org wildcard confers select, insert; use contained }
object secret_references               { table secret_references; pk (table_name, column_name, row_id); scoped tenant > project; use contained }
object variant_catalog                 { table variant_catalog;                 scoped tenant > project > org wildcard confers select, insert; reach ancestry via inheritance for select; use contained }


// Tenant-plane webhooks (TTS-533) — a workspace-manager / staff control surface,
// the tenant sibling of the project-scoped `hooks`. Its hook_deliveries drain the
// same dispatcher.
//
// Scoped `tenant`, not `tenant > project`: the authority is tenant-level, and the
// object is written out rather than templated because it names its OWN capability
// (TTS-1023) instead of a shared `tenant->owner` role-key gate. That lets a tenant
// manager delegate "may manage tenant webhooks" to a custom role without handing
// over the rest of the tenant tier. @holds on a tenant-scoped object matches only
// a TENANT-level assignment — the shape the old workspace-owner definer required — so the holder
// set is unchanged.
// A workspace's own sign-in providers sign its staff into the console. They are
// sign-in providers like a project's, held by signinproviders: scoped
// `tenant`, where @holds matches only a grant given at the workspace, so a
// project's manager, given it in one project, neither reads nor changes
// them.
object workspace_sign_in_providers {
  table  workspace_sign_in_providers
  scoped tenant
  reach impersonation unscoped for delete, insert, select, update
  relation tenant: tenant via tenant_id
  permission view   = (@holds(platform:manage) and not @claim("staff_reach", "role")) + @holds(signinproviders:read)    @rls maps select
  permission create = (@holds(platform:manage) and not @claim("staff_reach", "role")) + @holds(signinproviders:write)   @rls maps insert
  permission edit   = (@holds(platform:manage) and not @claim("staff_reach", "role")) + @holds(signinproviders:write)   @rls maps update
  permission delete = (@holds(platform:manage) and not @claim("staff_reach", "role")) + @holds(signinproviders:write)   @rls maps delete
}

object tenant_hooks {
  table  tenant_hooks
  scoped tenant
  reach impersonation unscoped for delete, insert, select, update
  relation tenant: tenant via tenant_id
  permission view   = (@holds(platform:manage) and not @claim("staff_reach", "role")) + @holds(tenanthooks:read)    @rls maps select
  permission create = (@holds(platform:manage) and not @claim("staff_reach", "role")) + @holds(tenanthooks:write)   @rls maps insert
  permission edit   = (@holds(platform:manage) and not @claim("staff_reach", "role")) + @holds(tenanthooks:write)   @rls maps update
  permission delete = (@holds(platform:manage) and not @claim("staff_reach", "role")) + @holds(tenanthooks:write)   @rls maps delete
}


// api-public field→scope gate (V10's second emit-site): GraphQL root field →
// required scope, multi-plane (a project's user + api-key + console user). The STATIC
// (model/operation-independent) table — reproduced byte-for-byte under the
// field-scope oracle vs FieldScopeRegistry.PopulateFromProjectData(empty). The
// per-model fields (records:<verb>:<model>) follow from the project users' vocab; the
// per-operation fields (→ operations:execute) are a rule. (Share fields exit
// with the EID-263 shares removal.)
fieldscopes apipublic {
  addVerifiedDomain -> signinproviders:write
  appConsoleSettings -> apps:read
  appCredential -> middleware:credential.read
  approveJoinRequest -> members:write
  batchRecordOperations -> records:write
  cancelOperationExecution -> operations:execute
  checkVerifiedDomain -> signinproviders:write
  confirmFileUpload -> files:write
  createFileUpload -> files:write
  createInvitation -> members:write
  createMyNote -> notes:create
  createSchedule -> schedules:write
  createSignInProvider -> signinproviders:write
  createUser -> users:create
  declineJoinRequest -> members:write
  deleteEmbeddings -> embeddings:write
  deleteFile -> files:delete
  deleteSchedule -> schedules:write
  deleteSecret -> secrets:delete
  deleteSignInProvider -> signinproviders:write
  deleteUser -> users:delete
  dropOrganizationPool -> organizations:write
  embeddingCoverage -> embeddings:read
  embeddingDigests -> embeddings:read
  embeddingsForRecord -> embeddings:read
  eraseUserRecord -> middleware:records.erase
  events -> events:read
  file -> files:read
  files -> files:read
  findNearbyRecords -> search:read
  findSimilarRecords -> embeddings:read
  generateEmbedding -> embeddings:write
  getSecret -> secrets:read
  integrationConfig -> middleware:config.read
  invitation -> members:read
  invitations -> members:read
  joinRequests -> members:read
  listSecrets -> secrets:list
  makeSCIMToken -> signinproviders:write
  mergeUsers -> users:write
  models -> schemas:read
  myNotes -> notes:read
  myNotifications -> notifications:read
  myUnreadCount -> notifications:read
  noteConfig -> notes:create
  notificationPreferences -> notifications:read
  operationExecution -> operations:read
  operationExecutions -> operations:read
  organizationPool -> organizations:read
  pauseSchedule -> schedules:write
  permanentlyDeleteFile -> files:delete
  projectSchemas -> schemas:read
  provisionOrganization -> organizations:create
  publishDesignTokens -> designtokens:write
  publishSignInProvider -> signinproviders:write
  putSecret -> secrets:put
