{
  "name": "@foir/demesne",
  "version": "0.0.0",
  "description": "Demesne authorization runtime — claims minting, the verb PDP, the holds-resolver, and the Layer-2/3 SQL builders, from the same projection the compiler emits. It is demesne's Rust runtime compiled to WebAssembly, with zero runtime dependencies.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foir-io/demesne.git",
    "directory": "ts/packages/runtime"
  },
  "homepage": "https://github.com/foir-io/demesne#readme",
  "bugs": "https://github.com/foir-io/demesne/issues",
  "keywords": [
    "authorization",
    "rls",
    "postgres",
    "rebac",
    "pdp"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "workerd": "./dist/index.workerd.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src/*.ts"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./dist/index.workerd.js",
    "./dist/start.js",
    "./dist/start.workerd.js"
  ],
  "scripts": {
    "build:wasm": "../../../scripts/build-runtime-wasm.sh",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-wasm.mjs && node scripts/check-size.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "VITE_DEMESNE_RUNTIME=node vitest run",
    "test:workerd": "VITE_DEMESNE_RUNTIME=workerd vitest run --config vitest.workers.config.ts",
    "test:browser": "VITE_DEMESNE_RUNTIME=browser vitest run --config vitest.browser.config.ts",
    "test:deno": "VITE_DEMESNE_RUNTIME=deno deno run -A node_modules/vitest/vitest.mjs run",
    "test:watch": "vitest",
    "test:packed": "node scripts/test-packed.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.0",
    "@types/node": "^22.10.2",
    "@vitest/browser-playwright": "5.0.4",
    "esbuild": "^0.25.0",
    "miniflare": "4.20260310.0",
    "playwright": "1.63.0",
    "typescript": "^5.7.2",
    "vitest": "5.0.4",
    "wrangler": "4.72.0"
  }
}
