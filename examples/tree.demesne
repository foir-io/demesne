topology { level estate level space parent estate level folder parent space }

closure paths(ancestor_id, descendant_id)
  base folders(id, parent_id)
  scope space_id
  depth depth

grant descendants at folder via edge paths(ancestor_id, descendant_id) confers select
grant ancestors   at folder via edge paths(descendant_id, ancestor_id) named paths_up confers select

subject member { anchor space; reach self; identifies sub; roles none }
subject viewer { anchor folder; reach via grant descendants; identifies folder_id; roles none }

object folder {
  table folders
  scoped estate > space
  relation beneath:        member via closure paths(ancestor_id, descendant_id) on id        from claim folder_id missing allow
  relation beneath_parent: member via closure paths(ancestor_id, descendant_id) on parent_id from claim folder_id missing allow
  relation above:          member via closure paths(descendant_id, ancestor_id) on id        from claim folder_id missing deny
  projection folder_path(id text, name text as title) = above
  permission view   = @scoped and (beneath + above) @rls maps select
  permission create = @scoped and beneath_parent    @rls maps insert
  permission edit   = @scoped and beneath           @rls maps update
  permission delete = @scoped and beneath           @rls maps delete
}

object template {
  table templates
  scoped estate > space
  relation beneath: member via closure paths(ancestor_id, descendant_id) on folder_id from claim folder_id missing allow
  relation above:   member via closure paths(descendant_id, ancestor_id) on folder_id from claim folder_id missing deny
  permission view   = @scoped             @rls maps select
  require view      = beneath + above + @row(folder_id, null)
  permission create = @scoped and beneath @rls maps insert
  permission edit   = @scoped and beneath @rls maps update
  permission delete = @scoped and beneath @rls maps delete
}

object atlas {
  table atlases
  scoped estate > space > folder wildcard confers select
  reach descendants via descendants, ancestors for select
  permission view = @scoped @rls maps select
  permission edit = @scoped @rls maps update
}

object space {
  table spaces
  level space
  scoped estate > space
  probe space_named(name text)
  probe spaces_in_estate() count
  probe space_by_name(name text as wanted) key
  projection space_cards(id text, name text as title) = @kind("member")
  permission view = @scoped and @row(status, "open") @rls maps select
}

object page {
  table pages
  scoped estate > space
  relation open_space: member via object space->view on space_id pinned
  permission view = @scoped and open_space @rls maps select
}

object sheet {
  table sheets
  scoped estate > space
  relation open_space: member via object space->view on space_id
  permission view = @scoped and open_space @rls maps select
}

object theme {
  table themes
  scoped estate > space
  nearest theme_color(color text) via closure paths on folder_id
  permission view = @scoped @rls maps select
}

object notice {
  table notices
  scoped estate > space exact
  permission view   = @scoped @rls maps select
  permission create = @scoped @rls maps insert
  permission edit   = @scoped @rls maps update
  permission delete = @scoped @rls maps delete
}

object draft {
  table drafts
  scoped estate > space
  permission view = @scoped @rls maps select
  require view    = @claim("folder_id", null) + not @row(visibility, "private")
}

object ledger {
  table ledgers
  scoped estate
  permission view = @scoped @rls maps select
  permission edit = @scoped @rls maps update
  require edit    = @within(space exact)
}
