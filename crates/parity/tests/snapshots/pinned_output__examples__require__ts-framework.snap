export const invitation = {
  async canView(q: Querier, id: string): Promise<Decision> {
    const { rows } = await q.query("SELECT EXISTS (SELECT 1 FROM invitations WHERE id = $1)", [id]);
    return composeCan(true, Boolean(rows[0]?.exists), Decision.NotGoverned);
  },

  async canEdit(q: Querier, id: string): Promise<Decision> {
    const { rows } = await q.query("SELECT EXISTS (SELECT 1 FROM invitations WHERE id = $1 AND (((tenant_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'tenant_id') AND (auth.admin_has_perm((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub'), tenant_id, NULL, 'invitations:write') OR invited_by = (SELECT current_setting('request.jwt.claims', true)::json ->> 'sub')))) AND (invited_by = (SELECT current_setting('request.jwt.claims', true)::json ->> 'sub'))))", [id]);
    return composeCan(true, Boolean(rows[0]?.exists), Decision.NotGoverned);
  },

  async listResources(q: Querier, after: string | null, limit: number): Promise<string[]> {
    const { rows } = await q.query("SELECT id FROM invitations WHERE ($1::text IS NULL OR id::text > $1::text) ORDER BY id::text LIMIT $2", [after, limit]);
    return rows.map((r) => r["id"] as string);
  },

  async checkMany(q: Querier, ids: string[]): Promise<string[]> {
    const { rows } = await q.query("SELECT id FROM invitations WHERE id = ANY($1)", [ids]);
    return rows.map((r) => r["id"] as string);
  },
};

