CREATE OR REPLACE FUNCTION auth.support_grants_reach(user_id text, check_tenant_id text)
RETURNS boolean
LANGUAGE sql
STABLE
STRICT
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT EXISTS (SELECT 1 FROM support_grants WHERE holder_id = user_id AND tenant_id = check_tenant_id AND ended_at IS NULL);
$$;

CREATE OR REPLACE FUNCTION auth.support_grants_reach_set(user_id text)
RETURNS SETOF text
LANGUAGE sql
STABLE
STRICT
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT tenant_id FROM support_grants WHERE holder_id = user_id AND ended_at IS NULL;
$$;

CREATE OR REPLACE FUNCTION auth.acl_grants_doc(p_member_id text, p_doc_id text, p_access text)
RETURNS boolean
LANGUAGE sql
STABLE
STRICT
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT EXISTS (SELECT 1 FROM acl WHERE resource_id = p_doc_id AND resource_type = 'doc' AND principal_kind = 'member' AND principal_id = p_member_id AND access = p_access);
$$;

CREATE OR REPLACE FUNCTION auth.acl_grants_note(p_member_id text, p_note_id text, p_access text)
RETURNS boolean
LANGUAGE sql
STABLE
STRICT
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT EXISTS (SELECT 1 FROM acl WHERE resource_id = p_note_id AND resource_type = 'note' AND principal_kind = 'member' AND principal_id = p_member_id AND access = p_access);
$$;

CREATE OR REPLACE FUNCTION auth.docs_accessors(p_id text)
RETURNS TABLE(source text, principal_kind text, principal_id text, access text)
LANGUAGE sql
STABLE
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT 'owner'::text AS source, 'member'::text AS principal_kind, owner_id AS principal_id, 'write'::text AS access
    FROM docs WHERE id = p_id AND owner_id IS NOT NULL
  UNION ALL
  SELECT 'grant'::text, principal_kind, principal_id, access
    FROM acl WHERE resource_id = p_id AND resource_type = 'doc'
$$;

CREATE OR REPLACE FUNCTION auth.docs_admits(p_id text, p_claims jsonb)
RETURNS boolean
LANGUAGE plpgsql
STABLE
STRICT
SECURITY DEFINER
SET search_path = public
AS $$
#variable_conflict use_column
DECLARE
  prior text := current_setting('request.jwt.claims', true);
  admitted boolean;
BEGIN
  PERFORM set_config('request.jwt.claims', p_claims::text, true);
  admitted := EXISTS (SELECT 1 FROM docs WHERE id = p_id AND (((tenant_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'tenant_id') OR tenant_id IN (SELECT auth.support_grants_reach_set((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub')))) AND workspace_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'workspace_id') AND (owner_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'member_id') OR auth.acl_grants_doc((SELECT current_setting('request.jwt.claims', true)::json ->> 'member_id'), docs.id, 'read') OR auth.acl_grants_doc((SELECT current_setting('request.jwt.claims', true)::json ->> 'member_id'), docs.id, 'write')))));
  PERFORM set_config('request.jwt.claims', coalesce(prior, ''), true);
  RETURN admitted;
END
$$;
REVOKE EXECUTE ON FUNCTION auth.docs_admits(text, jsonb) FROM PUBLIC;

CREATE OR REPLACE FUNCTION auth.notes_accessors(p_id text)
RETURNS TABLE(source text, principal_kind text, principal_id text, access text)
LANGUAGE sql
STABLE
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT 'owner'::text AS source, 'member'::text AS principal_kind, owner_id AS principal_id, 'write'::text AS access
    FROM notes WHERE id = p_id AND owner_id IS NOT NULL
  UNION ALL
  SELECT 'grant'::text, principal_kind, principal_id, access
    FROM acl WHERE resource_id = p_id AND resource_type = 'note'
  UNION ALL
  SELECT a.source, a.principal_kind, a.principal_id, a.access
    FROM notes t
    JOIN LATERAL auth.docs_accessors(t.doc_id) a ON true
    WHERE t.id = p_id
$$;

CREATE OR REPLACE FUNCTION auth.doc_can_view(p_doc_id text)
RETURNS boolean
LANGUAGE sql
STABLE
STRICT
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT EXISTS (SELECT 1 FROM docs WHERE docs.id = p_doc_id AND (((tenant_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'tenant_id') OR tenant_id IN (SELECT auth.support_grants_reach_set((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub')))) AND workspace_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'workspace_id') AND (owner_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'member_id') OR auth.acl_grants_doc((SELECT current_setting('request.jwt.claims', true)::json ->> 'member_id'), docs.id, 'read') OR auth.acl_grants_doc((SELECT current_setting('request.jwt.claims', true)::json ->> 'member_id'), docs.id, 'write')))));
$$;

CREATE OR REPLACE FUNCTION auth.notes_admits(p_id text, p_claims jsonb)
RETURNS boolean
LANGUAGE plpgsql
STABLE
STRICT
SECURITY DEFINER
SET search_path = public
AS $$
#variable_conflict use_column
DECLARE
  prior text := current_setting('request.jwt.claims', true);
  admitted boolean;
BEGIN
  PERFORM set_config('request.jwt.claims', p_claims::text, true);
  admitted := EXISTS (SELECT 1 FROM notes WHERE id = p_id AND (((tenant_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'tenant_id') OR tenant_id IN (SELECT auth.support_grants_reach_set((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub')))) AND workspace_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'workspace_id') AND (owner_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'member_id') OR auth.acl_grants_note((SELECT current_setting('request.jwt.claims', true)::json ->> 'member_id'), notes.id, 'read') OR auth.acl_grants_note((SELECT current_setting('request.jwt.claims', true)::json ->> 'member_id'), notes.id, 'write') OR auth.doc_can_view(doc_id)))));
  PERFORM set_config('request.jwt.claims', coalesce(prior, ''), true);
  RETURN admitted;
END
$$;
REVOKE EXECUTE ON FUNCTION auth.notes_admits(text, jsonb) FROM PUBLIC;

CREATE OR REPLACE FUNCTION auth.doc_can_edit(p_id text)
RETURNS boolean
LANGUAGE sql
STABLE
STRICT
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT EXISTS (SELECT 1 FROM docs WHERE docs.id = p_id AND (((tenant_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'tenant_id') OR tenant_id IN (SELECT auth.support_grants_reach_set((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub')))) AND workspace_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'workspace_id') AND (owner_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'member_id') OR auth.acl_grants_doc((SELECT current_setting('request.jwt.claims', true)::json ->> 'member_id'), docs.id, 'write')))));
$$;

