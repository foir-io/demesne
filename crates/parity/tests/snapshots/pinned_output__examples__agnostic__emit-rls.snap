DROP POLICY IF EXISTS assets_delete ON public.assets;
CREATE POLICY assets_delete ON public.assets FOR DELETE TO authenticated
    USING ((auth.is_ops((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub')) AND (SELECT current_setting('request.jwt.claims', true)::json ->> 'spc') IS NULL) OR (tenant_ref = (SELECT current_setting('request.jwt.claims', true)::json ->> 'tnt') AND space_ref = (SELECT current_setting('request.jwt.claims', true)::json ->> 'spc') AND (holder_ref = (SELECT current_setting('request.jwt.claims', true)::json ->> 'member_ref') OR auth.asset_acl_grants((SELECT current_setting('request.jwt.claims', true)::json ->> 'member_ref'), assets.asset_pk, 'delete'))));

DROP POLICY IF EXISTS assets_insert ON public.assets;
CREATE POLICY assets_insert ON public.assets FOR INSERT TO authenticated
    WITH CHECK ((auth.is_ops((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub')) AND (SELECT current_setting('request.jwt.claims', true)::json ->> 'spc') IS NULL) OR (tenant_ref = (SELECT current_setting('request.jwt.claims', true)::json ->> 'tnt') AND space_ref = (SELECT current_setting('request.jwt.claims', true)::json ->> 'spc') AND (holder_ref = (SELECT current_setting('request.jwt.claims', true)::json ->> 'member_ref'))));

DROP POLICY IF EXISTS assets_select ON public.assets;
CREATE POLICY assets_select ON public.assets FOR SELECT TO authenticated
    USING ((auth.is_ops((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub')) AND (SELECT current_setting('request.jwt.claims', true)::json ->> 'spc') IS NULL) OR (tenant_ref = (SELECT current_setting('request.jwt.claims', true)::json ->> 'tnt') AND space_ref = (SELECT current_setting('request.jwt.claims', true)::json ->> 'spc') AND (holder_ref = (SELECT current_setting('request.jwt.claims', true)::json ->> 'member_ref') OR share = 'open' OR auth.asset_acl_grants((SELECT current_setting('request.jwt.claims', true)::json ->> 'member_ref'), assets.asset_pk, 'read') OR auth.asset_acl_grants((SELECT current_setting('request.jwt.claims', true)::json ->> 'member_ref'), assets.asset_pk, 'write') OR auth.asset_acl_grants((SELECT current_setting('request.jwt.claims', true)::json ->> 'member_ref'), assets.asset_pk, 'delete'))));

DROP POLICY IF EXISTS assets_update ON public.assets;
CREATE POLICY assets_update ON public.assets FOR UPDATE TO authenticated
    USING ((auth.is_ops((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub')) AND (SELECT current_setting('request.jwt.claims', true)::json ->> 'spc') IS NULL) OR (tenant_ref = (SELECT current_setting('request.jwt.claims', true)::json ->> 'tnt') AND space_ref = (SELECT current_setting('request.jwt.claims', true)::json ->> 'spc') AND (holder_ref = (SELECT current_setting('request.jwt.claims', true)::json ->> 'member_ref') OR auth.asset_acl_grants((SELECT current_setting('request.jwt.claims', true)::json ->> 'member_ref'), assets.asset_pk, 'write'))))
    WITH CHECK ((auth.is_ops((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub')) AND (SELECT current_setting('request.jwt.claims', true)::json ->> 'spc') IS NULL) OR (tenant_ref = (SELECT current_setting('request.jwt.claims', true)::json ->> 'tnt') AND space_ref = (SELECT current_setting('request.jwt.claims', true)::json ->> 'spc') AND (holder_ref = (SELECT current_setting('request.jwt.claims', true)::json ->> 'member_ref') OR auth.asset_acl_grants((SELECT current_setting('request.jwt.claims', true)::json ->> 'member_ref'), assets.asset_pk, 'write'))));

DROP POLICY IF EXISTS spaces_select ON public.spaces;
CREATE POLICY spaces_select ON public.spaces FOR SELECT TO authenticated
    USING (auth.is_ops((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub')) OR (tenant_ref = (SELECT current_setting('request.jwt.claims', true)::json ->> 'tnt') AND (auth.is_tenant_crew((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub'), tenant_ref) OR auth.crew_has_space_role((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub'), tenant_ref, space_pk) OR space_pk = (SELECT current_setting('request.jwt.claims', true)::json ->> 'spc'))));

DROP POLICY IF EXISTS spaces_update ON public.spaces;
CREATE POLICY spaces_update ON public.spaces FOR UPDATE TO authenticated
    USING (auth.is_ops((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub')) OR (tenant_ref = (SELECT current_setting('request.jwt.claims', true)::json ->> 'tnt') AND (auth.is_tenant_crew((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub'), tenant_ref) OR space_pk = (SELECT current_setting('request.jwt.claims', true)::json ->> 'spc') AND auth.crew_has_space_role((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub'), tenant_ref, space_pk))))
    WITH CHECK (auth.is_ops((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub')) OR (tenant_ref = (SELECT current_setting('request.jwt.claims', true)::json ->> 'tnt') AND (auth.is_tenant_crew((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub'), tenant_ref) OR space_pk = (SELECT current_setting('request.jwt.claims', true)::json ->> 'spc') AND auth.crew_has_space_role((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub'), tenant_ref, space_pk))));


