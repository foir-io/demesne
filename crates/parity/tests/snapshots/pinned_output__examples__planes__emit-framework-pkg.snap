func Check(ctx context.Context, q demesne.Querier, object, verb, id string) (Decision, error) {
	switch object + "." + verb {
	case "document.view":
		return Document.CanView(ctx, q, id)
	case "document.edit":
		return Document.CanEdit(ctx, q, id)
	case "tenant.view":
		return Tenant.CanView(ctx, q, id)
	case "tenant.edit":
		return Tenant.CanEdit(ctx, q, id)
	default:
		return NotGoverned, nil
	}
}

func CheckHandler(q demesne.Querier) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		d, err := Check(r.Context(), q, r.FormValue("object"), r.FormValue("verb"), r.FormValue("id"))
		if err != nil {
			http.Error(w, err.Error(), http.StatusInternalServerError)
			return
		}
		w.Header().Set("Content-Type", "application/json")
		_ = json.NewEncoder(w).Encode(map[string]string{"decision": d.String()})
	}
}

