func (s *Surface) Check(ctx context.Context, q demesne.Querier, object, verb, id string) (Decision, error) {
	switch object + "." + verb {
	case "asset.view":
		return s.Asset.CanView(ctx, q, id)
	case "asset.edit":
		return s.Asset.CanEdit(ctx, q, id)
	case "blueprint.view":
		return s.Blueprint.CanView(ctx, q, id)
	case "blueprint.edit":
		return s.Blueprint.CanEdit(ctx, q, id)
	case "ledger.view":
		return s.Ledger.CanView(ctx, q, id)
	case "allowance.view":
		return s.Allowance.CanView(ctx, q, id)
	case "allowance.edit":
		return s.Allowance.CanEdit(ctx, q, id)
	case "space.view":
		return s.Space.CanView(ctx, q, id)
	case "space.edit":
		return s.Space.CanEdit(ctx, q, id)
	case "entry.view":
		return s.Entry.CanView(ctx, q, id)
	case "entry.edit":
		return s.Entry.CanEdit(ctx, q, id)
	case "folder.view":
		return s.Folder.CanView(ctx, q, id)
	case "folder.edit":
		return s.Folder.CanEdit(ctx, q, id)
	default:
		return NotGoverned, nil
	}
}

func (s *Surface) CheckHandler(q demesne.Querier) http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
		p := req.URL.Query()
		d, err := s.Check(req.Context(), q, p.Get("object"), p.Get("verb"), p.Get("id"))
		if err != nil {
			http.Error(w, err.Error(), http.StatusInternalServerError)
			return
		}
		w.Header().Set("Content-Type", "application/json")
		_ = json.NewEncoder(w).Encode(map[string]Decision{"decision": d})
	})
}

