export async function check(q: Querier, object: string, verb: string, id: string): Promise<Decision> {
  switch (object + "." + verb) {
    case "asset.view":
      return asset.canView(q, id);
    case "asset.edit":
      return asset.canEdit(q, id);
    case "blueprint.view":
      return blueprint.canView(q, id);
    case "blueprint.edit":
      return blueprint.canEdit(q, id);
    case "ledger.view":
      return ledger.canView(q, id);
    case "allowance.view":
      return allowance.canView(q, id);
    case "allowance.edit":
      return allowance.canEdit(q, id);
    case "space.view":
      return space.canView(q, id);
    case "space.edit":
      return space.canEdit(q, id);
    case "entry.view":
      return entry.canView(q, id);
    case "entry.edit":
      return entry.canEdit(q, id);
    case "folder.view":
      return folder.canView(q, id);
    case "folder.edit":
      return folder.canEdit(q, id);
    default:
      return Decision.NotGoverned;
  }
}

export function checkHandler(q: Querier): (req: Request) => Promise<Response> {
  return async (req: Request): Promise<Response> => {
    const url = new URL(req.url);
    try {
      const d = await check(
        q,
        url.searchParams.get("object") ?? "",
        url.searchParams.get("verb") ?? "",
        url.searchParams.get("id") ?? "",
      );
      return new Response(JSON.stringify({ decision: d }), {
        headers: { "Content-Type": "application/json" },
      });
    } catch (e) {
      return new Response((e as Error).message, { status: 500 });
    }
  };
}

