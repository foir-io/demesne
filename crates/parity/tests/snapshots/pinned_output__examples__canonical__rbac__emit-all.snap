CREATE OR REPLACE FUNCTION auth.staff_has_resource_role(user_id text, check_tenant_id text, check_project_id text)
RETURNS boolean
LANGUAGE sql
STABLE
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT EXISTS (SELECT 1 FROM role_grants ra JOIN roles r ON r.id = ra.role_id WHERE ra.grantee_kind = 'staff' AND ra.grantee_id = user_id AND ra.tenant_id = check_tenant_id AND ra.project_id = check_project_id AND ra.revoked_at IS NULL AND r.key IN ('editor', 'viewer'));
$$;

CREATE OR REPLACE FUNCTION auth.is_tenant_staff(user_id text, check_tenant_id text)
RETURNS boolean
LANGUAGE sql
STABLE
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT EXISTS (SELECT 1 FROM role_grants ra JOIN roles r ON r.id = ra.role_id WHERE ra.grantee_kind = 'staff' AND ra.grantee_id = user_id AND ra.tenant_id = check_tenant_id AND ra.project_id IS NULL AND ra.revoked_at IS NULL AND r.key IN ('owner'));
$$;

CREATE OR REPLACE FUNCTION auth.staff_has_perm(user_id text, check_tenant_id text, check_project_id text, p_perm text)
RETURNS boolean
LANGUAGE sql
STABLE
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT EXISTS (SELECT 1 FROM role_grants ra JOIN roles r ON r.id = ra.role_id WHERE ra.grantee_kind = 'staff' AND ra.grantee_id = user_id AND (ra.tenant_id IS NULL OR ra.tenant_id = check_tenant_id) AND (ra.project_id IS NULL OR ra.project_id = check_project_id) AND ra.revoked_at IS NULL AND p_perm = ANY(r.permissions));
$$;


ALTER TABLE public.resources ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.resources FORCE ROW LEVEL SECURITY;

DROP POLICY IF EXISTS resources_select ON public.resources;
CREATE POLICY resources_select ON public.resources FOR SELECT TO authenticated
    USING ((tenant_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'tenant_id') AND project_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'project_id') AND (auth.staff_has_resource_role((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub'), tenant_id, project_id) OR auth.staff_has_perm((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub'), tenant_id, project_id, 'resource:write') OR auth.is_tenant_staff((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub'), tenant_id))));

DROP POLICY IF EXISTS resources_update ON public.resources;
CREATE POLICY resources_update ON public.resources FOR UPDATE TO authenticated
    USING ((tenant_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'tenant_id') AND project_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'project_id') AND (auth.staff_has_perm((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub'), tenant_id, project_id, 'resource:write') OR auth.is_tenant_staff((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub'), tenant_id))))
    WITH CHECK ((tenant_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'tenant_id') AND project_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'project_id') AND (auth.staff_has_perm((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub'), tenant_id, project_id, 'resource:write') OR auth.is_tenant_staff((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub'), tenant_id))));


