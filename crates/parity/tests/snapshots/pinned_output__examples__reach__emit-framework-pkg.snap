func Check(ctx context.Context, q demesne.Querier, object, verb, id string) (Decision, error) {
	switch object + "." + verb {
	case "asset.view":
		return Asset.CanView(ctx, q, id)
	case "asset.edit":
		return Asset.CanEdit(ctx, q, id)
	case "blueprint.view":
		return Blueprint.CanView(ctx, q, id)
	case "blueprint.edit":
		return Blueprint.CanEdit(ctx, q, id)
	case "ledger.view":
		return Ledger.CanView(ctx, q, id)
	case "allowance.view":
		return Allowance.CanView(ctx, q, id)
	case "allowance.edit":
		return Allowance.CanEdit(ctx, q, id)
	case "space.view":
		return Space.CanView(ctx, q, id)
	case "space.edit":
		return Space.CanEdit(ctx, q, id)
	case "entry.view":
		return Entry.CanView(ctx, q, id)
	case "entry.edit":
		return Entry.CanEdit(ctx, q, id)
	case "folder.view":
		return Folder.CanView(ctx, q, id)
	case "folder.edit":
		return Folder.CanEdit(ctx, q, id)
	default:
		return NotGoverned, nil
	}
}

func CheckHandler(q demesne.Querier) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		d, err := Check(r.Context(), q, r.FormValue("object"), r.FormValue("verb"), r.FormValue("id"))
		if err != nil {
			http.Error(w, err.Error(), http.StatusInternalServerError)
			return
		}
		w.Header().Set("Content-Type", "application/json")
		_ = json.NewEncoder(w).Encode(map[string]string{"decision": d.String()})
	}
}

