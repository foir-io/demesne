    USING ((estate_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'estate_id') AND space_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'space_id') AND ((((SELECT current_setting('request.jwt.claims', true)::json ->> 'folder_id') IS NULL OR id IN (SELECT auth.paths_descendants((SELECT current_setting('request.jwt.claims', true)::json ->> 'folder_id'))))))));

