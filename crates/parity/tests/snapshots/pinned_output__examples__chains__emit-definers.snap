CREATE OR REPLACE FUNCTION auth.doc_composition_lent_0(p_doc_id text, p_access text, p_slot text)
RETURNS boolean
LANGUAGE plpgsql
STABLE
STRICT
SECURITY DEFINER
SET search_path = public
AS $$
#variable_conflict use_column
BEGIN
  IF p_access = 'read' THEN
    RETURN EXISTS (SELECT 1 FROM doc_lends e WHERE e.borrower_id = p_doc_id AND e.field::text = p_slot AND CASE WHEN EXISTS (SELECT 1 FROM docs WHERE docs.id = e.lender_id AND ((estate_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'estate_id') AND (EXISTS (SELECT 1 FROM unnest(docs.rules_live) AS demesne_element(v) WHERE starts_with(demesne_element.v, 'read.') AND demesne_element.v = ANY(ARRAY(SELECT e FROM jsonb_array_elements_text((SELECT current_setting('request.jwt.claims', true)::json ->> 'rules_held')::jsonb) e)) AND ((NOT EXISTS (SELECT 1 FROM auth.rule_slots_declared_by_rule(demesne_element.v) AS demesne_slot WHERE demesne_slot.role = 'require' AND ((demesne_slot.kind = 'share') AND (auth.doc_shared_keyed_inside((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub'), docs.id, demesne_element.v))) IS NOT TRUE)) AND (auth.doc_terms_hold_inside(docs.id, demesne_element.v, (SELECT (current_setting('request.jwt.claims', true)::json -> 'facts')::jsonb))))))))) THEN (NOT EXISTS (SELECT 1 FROM auth.trail_hops_declared_by_trail(e.trail::text) AS demesne_slot WHERE (((demesne_slot.kind = 'claim') AND (demesne_slot.rule = ANY(ARRAY(SELECT e FROM jsonb_array_elements_text((SELECT current_setting('request.jwt.claims', true)::json ->> 'rules_held')::jsonb) e)))) OR ((demesne_slot.kind = 'live') AND ((SELECT CASE WHEN demesne_hop.record IS NULL OR demesne_hop.element IS NULL OR demesne_hop.slot IS NULL THEN NULL ELSE EXISTS (SELECT 1 FROM docs WHERE docs.id = demesne_hop.record AND estate_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'estate_id') AND (EXISTS (SELECT 1 FROM unnest(docs.rules_live) AS demesne_element(v) WHERE demesne_element.v = demesne_hop.element AND starts_with(demesne_element.v, 'read.') AND demesne_element.v = ANY(ARRAY(SELECT e FROM jsonb_array_elements_text((SELECT current_setting('request.jwt.claims', true)::json ->> 'rules_held')::jsonb) e)) AND ((NOT EXISTS (SELECT 1 FROM auth.rule_slots_declared_by_rule(demesne_element.v) AS demesne_slot WHERE demesne_slot.role = 'require' AND ((demesne_slot.kind = 'share') AND (auth.doc_shared_keyed_inside((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub'), docs.id, demesne_element.v)) OR (demesne_slot.kind = 'lend') AND (demesne_slot.param = demesne_hop.slot)) IS NOT TRUE)) AND (auth.doc_terms_hold_inside(docs.id, demesne_element.v, (SELECT (current_setting('request.jwt.claims', true)::json -> 'facts')::jsonb))))))) END FROM (SELECT demesne_slot.doc_id AS record, demesne_slot.rule AS element, demesne_slot.field AS slot) AS demesne_hop)))) IS NOT TRUE)) ELSE false END);
  END IF;
  RETURN false;
END
$$;
REVOKE EXECUTE ON FUNCTION auth.doc_composition_lent_0(text, text, text) FROM PUBLIC;

CREATE OR REPLACE FUNCTION auth.doc_composition_lent(p_doc_id text, p_access text, p_slot text)
RETURNS boolean
LANGUAGE plpgsql
STABLE
STRICT
SECURITY DEFINER
SET search_path = public
AS $$
#variable_conflict use_column
BEGIN
  IF p_access = 'read' THEN
    RETURN EXISTS (SELECT 1 FROM doc_lends e WHERE e.borrower_id = p_doc_id AND e.field::text = p_slot AND CASE WHEN EXISTS (SELECT 1 FROM docs WHERE docs.id = e.lender_id AND ((estate_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'estate_id') AND (EXISTS (SELECT 1 FROM unnest(docs.rules_live) AS demesne_element(v) WHERE starts_with(demesne_element.v, 'read.') AND demesne_element.v = ANY(ARRAY(SELECT e FROM jsonb_array_elements_text((SELECT current_setting('request.jwt.claims', true)::json ->> 'rules_held')::jsonb) e)) AND ((NOT EXISTS (SELECT 1 FROM auth.rule_slots_declared_by_rule(demesne_element.v) AS demesne_slot WHERE demesne_slot.role = 'require' AND ((demesne_slot.kind = 'share') AND (auth.doc_shared_keyed_inside((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub'), docs.id, demesne_element.v))) IS NOT TRUE)) AND (auth.doc_terms_hold_inside(docs.id, demesne_element.v, (SELECT (current_setting('request.jwt.claims', true)::json -> 'facts')::jsonb))))))))) THEN (NOT EXISTS (SELECT 1 FROM auth.trail_hops_declared_by_trail(e.trail::text) AS demesne_slot WHERE (((demesne_slot.kind = 'claim') AND (demesne_slot.rule = ANY(ARRAY(SELECT e FROM jsonb_array_elements_text((SELECT current_setting('request.jwt.claims', true)::json ->> 'rules_held')::jsonb) e)))) OR ((demesne_slot.kind = 'live') AND ((SELECT CASE WHEN demesne_hop.record IS NULL OR demesne_hop.element IS NULL OR demesne_hop.slot IS NULL THEN NULL ELSE EXISTS (SELECT 1 FROM docs WHERE docs.id = demesne_hop.record AND estate_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'estate_id') AND (EXISTS (SELECT 1 FROM unnest(docs.rules_live) AS demesne_element(v) WHERE demesne_element.v = demesne_hop.element AND starts_with(demesne_element.v, 'read.') AND demesne_element.v = ANY(ARRAY(SELECT e FROM jsonb_array_elements_text((SELECT current_setting('request.jwt.claims', true)::json ->> 'rules_held')::jsonb) e)) AND ((NOT EXISTS (SELECT 1 FROM auth.rule_slots_declared_by_rule(demesne_element.v) AS demesne_slot WHERE demesne_slot.role = 'require' AND ((demesne_slot.kind = 'share') AND (auth.doc_shared_keyed_inside((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub'), docs.id, demesne_element.v)) OR (demesne_slot.kind = 'lend') AND ((demesne_slot.param = demesne_hop.slot OR auth.doc_composition_lent_0(docs.id, 'read', demesne_slot.param)))) IS NOT TRUE)) AND (auth.doc_terms_hold_inside(docs.id, demesne_element.v, (SELECT (current_setting('request.jwt.claims', true)::json -> 'facts')::jsonb))))))) END FROM (SELECT demesne_slot.doc_id AS record, demesne_slot.rule AS element, demesne_slot.field AS slot) AS demesne_hop)))) IS NOT TRUE)) ELSE false END);
  END IF;
  RETURN false;
END
$$;
GRANT EXECUTE ON FUNCTION auth.doc_composition_lent(text, text, text) TO PUBLIC;


