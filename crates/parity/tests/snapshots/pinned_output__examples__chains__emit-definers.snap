      WHEN 'not_in' THEN holds := NOT (CASE WHEN jsonb_typeof(x_v) = 'array' THEN EXISTS (SELECT 1 FROM jsonb_array_elements(x_v) e WHERE (jsonb_typeof(e) = 'number' AND (e #>> '{}')::double precision = c.num) OR (jsonb_typeof(e) = 'string' AND (e #>> '{}') = c.txt COLLATE "C")) END);
