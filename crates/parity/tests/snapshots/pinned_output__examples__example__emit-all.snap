CREATE OR REPLACE FUNCTION auth.is_root(user_id text)
RETURNS boolean
LANGUAGE sql
STABLE
STRICT
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT EXISTS (SELECT 1 FROM staff_users WHERE id = user_id AND is_root AND status = 'ACTIVE');
$$;

CREATE OR REPLACE FUNCTION auth.is_tenant_staff(user_id text, check_tenant_id text)
RETURNS boolean
LANGUAGE sql
STABLE
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT auth.is_root(user_id) OR EXISTS (SELECT 1 FROM role_grants ra JOIN roles r ON r.id = ra.role_id WHERE ra.grantee_kind = 'staff' AND ra.grantee_id = user_id AND ra.tenant_id = check_tenant_id AND ra.workspace_id IS NULL AND ra.revoked_at IS NULL AND r.key IN ('tenant_owner'));
$$;

CREATE OR REPLACE FUNCTION auth.staff_has_workspace_role(user_id text, check_tenant_id text, check_workspace_id text)
RETURNS boolean
LANGUAGE sql
STABLE
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT EXISTS (SELECT 1 FROM role_grants ra JOIN roles r ON r.id = ra.role_id WHERE ra.grantee_kind = 'staff' AND ra.grantee_id = user_id AND ra.tenant_id = check_tenant_id AND ra.workspace_id = check_workspace_id AND ra.revoked_at IS NULL AND r.key IN ('ws_editor', 'ws_viewer'));
$$;

CREATE OR REPLACE FUNCTION auth.has_org_role(user_id text)
RETURNS boolean
LANGUAGE sql
STABLE
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT EXISTS (SELECT 1 FROM role_grants ra JOIN roles r ON r.id = ra.role_id WHERE ra.grantee_kind = 'staff' AND ra.grantee_id = user_id AND ra.tenant_id IS NULL AND ra.workspace_id IS NULL AND ra.revoked_at IS NULL AND r.key IN ('platform_admin'));
$$;

CREATE OR REPLACE FUNCTION auth.member_can_access_doc(p_member_id text, p_doc_id text, p_access text)
RETURNS boolean
LANGUAGE sql
STABLE
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT EXISTS (SELECT 1 FROM docs r WHERE r.id = p_doc_id AND r.owner_id = p_member_id);
$$;

CREATE OR REPLACE FUNCTION auth.doc_acl_grants(p_member_id text, p_doc_id text, p_access text)
RETURNS boolean
LANGUAGE sql
STABLE
STRICT
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT EXISTS (SELECT 1 FROM doc_acl WHERE doc_id = p_doc_id AND principal_kind = 'member' AND principal_id = p_member_id AND access = p_access);
$$;

CREATE OR REPLACE FUNCTION auth.docs_accessors_conditional(p_id text)
RETURNS TABLE(source text, principal_kind text, principal_id text, access text, via_claim_keys text[], via_claim_values text[])
LANGUAGE sql
STABLE
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT b.source, b.principal_kind, b.principal_id, b.access, NULL::text[] AS via_claim_keys, NULL::text[] AS via_claim_values
    FROM (
  SELECT 'owner'::text AS source, 'member'::text AS principal_kind, owner_id AS principal_id, 'write'::text AS access
    FROM docs WHERE id = p_id AND owner_id IS NOT NULL
  UNION ALL
  SELECT 'grant'::text, principal_kind, principal_id, access
    FROM doc_acl WHERE doc_id = p_id
    ) b(source, principal_kind, principal_id, access)
  UNION ALL
  SELECT 'mode'::text, NULL::text, NULL::text, 'read'::text, NULL::text[], NULL::text[]
    FROM docs WHERE id = p_id AND visibility = 'public_project'
  UNION ALL
  SELECT 'mode'::text, NULL::text, NULL::text, 'read'::text, NULL::text[], NULL::text[]
    FROM docs WHERE id = p_id AND visibility = 'public_world'
$$;

CREATE OR REPLACE FUNCTION auth.docs_admits(p_id text, p_claims jsonb)
RETURNS boolean
LANGUAGE plpgsql
STABLE
STRICT
SECURITY DEFINER
SET search_path = public
AS $$
#variable_conflict use_column
DECLARE
  prior text := current_setting('request.jwt.claims', true);
  admitted boolean;
BEGIN
  PERFORM set_config('request.jwt.claims', p_claims::text, true);
  admitted := EXISTS (SELECT 1 FROM docs WHERE id = p_id AND ((auth.is_root((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub')) AND (SELECT current_setting('request.jwt.claims', true)::json ->> 'workspace_id') IS NULL) OR (tenant_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'tenant_id') AND workspace_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'workspace_id') AND (owner_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'member_id') OR visibility = 'public_project' OR visibility = 'public_world' OR auth.doc_acl_grants((SELECT current_setting('request.jwt.claims', true)::json ->> 'member_id'), docs.id, 'read') OR auth.doc_acl_grants((SELECT current_setting('request.jwt.claims', true)::json ->> 'member_id'), docs.id, 'write') OR auth.doc_acl_grants((SELECT current_setting('request.jwt.claims', true)::json ->> 'member_id'), docs.id, 'delete')))));
  PERFORM set_config('request.jwt.claims', coalesce(prior, ''), true);
  RETURN admitted;
END
$$;
REVOKE EXECUTE ON FUNCTION auth.docs_admits(text, jsonb) FROM PUBLIC;

CREATE OR REPLACE FUNCTION auth.workspaces_accessors(p_id text)
RETURNS TABLE(source text, principal_kind text, principal_id text, access text)
LANGUAGE sql
STABLE
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT 'role'::text AS source, 'staff'::text AS principal_kind, ra.grantee_id AS principal_id, 'read'::text AS access
    FROM workspaces e JOIN role_grants ra ON ra.grantee_kind = 'staff' AND ra.revoked_at IS NULL AND ra.tenant_id = e.tenant_id AND ra.workspace_id IS NULL JOIN roles rr ON rr.id = ra.role_id AND rr.key IN ('tenant_owner')
    WHERE e.id = p_id
  UNION
  SELECT 'role'::text AS source, 'staff'::text AS principal_kind, ra.grantee_id AS principal_id, 'read'::text AS access
    FROM workspaces e JOIN role_grants ra ON ra.grantee_kind = 'staff' AND ra.revoked_at IS NULL AND ra.tenant_id = e.tenant_id AND ra.workspace_id = e.id JOIN roles rr ON rr.id = ra.role_id AND rr.key IN ('ws_editor', 'ws_viewer')
    WHERE e.id = p_id
$$;

CREATE OR REPLACE FUNCTION auth.workspaces_admits(p_id text, p_claims jsonb)
RETURNS boolean
LANGUAGE plpgsql
STABLE
STRICT
SECURITY DEFINER
SET search_path = public
AS $$
#variable_conflict use_column
DECLARE
  prior text := current_setting('request.jwt.claims', true);
  admitted boolean;
BEGIN
  PERFORM set_config('request.jwt.claims', p_claims::text, true);
  admitted := EXISTS (SELECT 1 FROM workspaces WHERE id = p_id AND (auth.is_root((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub')) OR (tenant_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'tenant_id') AND (auth.is_tenant_staff((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub'), tenant_id) OR auth.staff_has_workspace_role((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub'), tenant_id, id) OR id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'workspace_id')))));
  PERFORM set_config('request.jwt.claims', coalesce(prior, ''), true);
  RETURN admitted;
END
$$;
REVOKE EXECUTE ON FUNCTION auth.workspaces_admits(text, jsonb) FROM PUBLIC;


ALTER TABLE public.docs ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.docs FORCE ROW LEVEL SECURITY;
ALTER TABLE public.workspaces ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.workspaces FORCE ROW LEVEL SECURITY;

DROP POLICY IF EXISTS docs_delete ON public.docs;
CREATE POLICY docs_delete ON public.docs FOR DELETE TO authenticated
    USING ((auth.is_root((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub')) AND (SELECT current_setting('request.jwt.claims', true)::json ->> 'workspace_id') IS NULL) OR (tenant_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'tenant_id') AND workspace_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'workspace_id') AND (owner_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'member_id') OR auth.doc_acl_grants((SELECT current_setting('request.jwt.claims', true)::json ->> 'member_id'), docs.id, 'delete'))));

DROP POLICY IF EXISTS docs_insert ON public.docs;
CREATE POLICY docs_insert ON public.docs FOR INSERT TO authenticated
    WITH CHECK ((auth.is_root((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub')) AND (SELECT current_setting('request.jwt.claims', true)::json ->> 'workspace_id') IS NULL) OR (tenant_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'tenant_id') AND workspace_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'workspace_id') AND (owner_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'member_id'))));

DROP POLICY IF EXISTS docs_select ON public.docs;
CREATE POLICY docs_select ON public.docs FOR SELECT TO authenticated
    USING ((auth.is_root((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub')) AND (SELECT current_setting('request.jwt.claims', true)::json ->> 'workspace_id') IS NULL) OR (tenant_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'tenant_id') AND workspace_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'workspace_id') AND (owner_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'member_id') OR visibility = 'public_project' OR visibility = 'public_world' OR auth.doc_acl_grants((SELECT current_setting('request.jwt.claims', true)::json ->> 'member_id'), docs.id, 'read') OR auth.doc_acl_grants((SELECT current_setting('request.jwt.claims', true)::json ->> 'member_id'), docs.id, 'write') OR auth.doc_acl_grants((SELECT current_setting('request.jwt.claims', true)::json ->> 'member_id'), docs.id, 'delete'))));

DROP POLICY IF EXISTS docs_update ON public.docs;
CREATE POLICY docs_update ON public.docs FOR UPDATE TO authenticated
    USING ((auth.is_root((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub')) AND (SELECT current_setting('request.jwt.claims', true)::json ->> 'workspace_id') IS NULL) OR (tenant_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'tenant_id') AND workspace_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'workspace_id') AND (owner_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'member_id') OR auth.doc_acl_grants((SELECT current_setting('request.jwt.claims', true)::json ->> 'member_id'), docs.id, 'write'))))
    WITH CHECK ((auth.is_root((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub')) AND (SELECT current_setting('request.jwt.claims', true)::json ->> 'workspace_id') IS NULL) OR (tenant_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'tenant_id') AND workspace_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'workspace_id') AND (owner_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'member_id') OR auth.doc_acl_grants((SELECT current_setting('request.jwt.claims', true)::json ->> 'member_id'), docs.id, 'write'))));

DROP POLICY IF EXISTS workspaces_select ON public.workspaces;
CREATE POLICY workspaces_select ON public.workspaces FOR SELECT TO authenticated
    USING (auth.is_root((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub')) OR (tenant_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'tenant_id') AND (auth.is_tenant_staff((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub'), tenant_id) OR auth.staff_has_workspace_role((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub'), tenant_id, id) OR id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'workspace_id'))));

DROP POLICY IF EXISTS workspaces_update ON public.workspaces;
CREATE POLICY workspaces_update ON public.workspaces FOR UPDATE TO authenticated
    USING (auth.is_root((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub')) OR (tenant_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'tenant_id') AND (auth.is_tenant_staff((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub'), tenant_id) OR id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'workspace_id') AND auth.staff_has_workspace_role((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub'), tenant_id, id))))
    WITH CHECK (auth.is_root((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub')) OR (tenant_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'tenant_id') AND (auth.is_tenant_staff((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub'), tenant_id) OR id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'workspace_id') AND auth.staff_has_workspace_role((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub'), tenant_id, id))));


