CREATE OR REPLACE FUNCTION auth.folder_closure_reachable(p_ancestor text, p_descendant text)
RETURNS boolean
LANGUAGE sql
STABLE
STRICT
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT EXISTS (SELECT 1 FROM folder_closure WHERE ancestor_id = p_ancestor AND descendant_id = p_descendant AND (p_ancestor = (SELECT NULLIF(current_setting('request.jwt.claims', true), '')::json ->> 'viewer_folder')::text OR p_descendant = (SELECT NULLIF(current_setting('request.jwt.claims', true), '')::json ->> 'viewer_folder')::text));
$$;
GRANT EXECUTE ON FUNCTION auth.folder_closure_reachable(text, text) TO PUBLIC;


