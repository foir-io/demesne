    const { rows } = await q.query("SELECT EXISTS (SELECT 1 FROM records WHERE id = $1 AND ((tenant_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'tenant_id') AND project_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'project_id') AND (auth.member_has_perm((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub'), tenant_id, project_id, 'records:write')))))", [id]);
