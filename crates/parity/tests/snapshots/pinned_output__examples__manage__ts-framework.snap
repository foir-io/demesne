export interface Claims {
  projectID?: string;
  sub?: string;
  tenantID?: string;
  extra?: Record<string, string>;
}

export function mint(c: Claims): string {
  const values: Record<string, string> = {};
  if (c.projectID !== undefined && c.projectID !== "") values["project_id"] = c.projectID;
  if (c.sub !== undefined && c.sub !== "") values["sub"] = c.sub;
  if (c.tenantID !== undefined && c.tenantID !== "") values["tenant_id"] = c.tenantID;
  return mintClaimsValuesWithExtra(claimsContract, values, c.extra);
}

export const connectionRole = "authenticated";
export const claimsGUC = "request.jwt.claims";

export function setRoleSQL(local: boolean): string {
  return (local ? "SET LOCAL ROLE " : "SET ROLE ") + connectionRole;
}

export function claimsSetSQL(local: boolean): string {
  return "SELECT set_config('" + claimsGUC + "', $1, " + (local ? "true" : "false") + ")";
}

export function sessionSetupSQL(local: boolean): [string, string] {
  return [setRoleSQL(local), claimsSetSQL(local)];
}

