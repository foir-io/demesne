CREATE OR REPLACE FUNCTION auth.paths_reach(user_id text, check_folder_id text)
RETURNS boolean
LANGUAGE sql
STABLE
STRICT
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT EXISTS (SELECT 1 FROM paths WHERE ancestor_id = user_id AND descendant_id = check_folder_id);
$$;

CREATE OR REPLACE FUNCTION auth.paths_reach_set(user_id text)
RETURNS SETOF text
LANGUAGE sql
STABLE
STRICT
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT descendant_id FROM paths WHERE ancestor_id = user_id;
$$;

CREATE OR REPLACE FUNCTION auth.paths_up_reach(user_id text, check_folder_id text)
RETURNS boolean
LANGUAGE sql
STABLE
STRICT
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT EXISTS (SELECT 1 FROM paths WHERE descendant_id = user_id AND ancestor_id = check_folder_id);
$$;

CREATE OR REPLACE FUNCTION auth.paths_up_reach_set(user_id text)
RETURNS SETOF text
LANGUAGE sql
STABLE
STRICT
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT ancestor_id FROM paths WHERE descendant_id = user_id;
$$;

CREATE OR REPLACE FUNCTION auth.paths_reachable(p_ancestor text, p_descendant text)
RETURNS boolean
LANGUAGE sql
STABLE
STRICT
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT EXISTS (SELECT 1 FROM paths WHERE ancestor_id = p_ancestor AND descendant_id = p_descendant);
$$;

CREATE OR REPLACE FUNCTION auth.paths_descendants(p_node text)
RETURNS SETOF text
LANGUAGE sql
STABLE
STRICT
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT descendant_id FROM paths WHERE ancestor_id = p_node;
$$;

CREATE OR REPLACE FUNCTION auth.paths_ancestors(p_node text)
RETURNS SETOF text
LANGUAGE sql
STABLE
STRICT
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT ancestor_id FROM paths WHERE descendant_id = p_node;
$$;

CREATE OR REPLACE FUNCTION auth.paths_path(p_node text)
RETURNS TABLE(node text, depth integer)
LANGUAGE sql
STABLE
STRICT
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT ancestor_id, depth::integer FROM paths WHERE descendant_id = p_node ORDER BY depth DESC, ancestor_id;
$$;

CREATE OR REPLACE FUNCTION auth.space_can_view(p_space_id text)
RETURNS boolean
LANGUAGE sql
STABLE
STRICT
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT EXISTS (SELECT 1 FROM spaces WHERE spaces.id = p_space_id AND ((estate_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'estate_id') AND ((status = 'open')))));
$$;

CREATE OR REPLACE FUNCTION auth.space_named(p_name text)
RETURNS boolean
LANGUAGE sql
STABLE
STRICT
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT EXISTS (SELECT 1 FROM spaces WHERE (estate_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'estate_id')) AND name = space_named.p_name);
$$;

CREATE OR REPLACE FUNCTION auth.spaces_in_estate()
RETURNS bigint
LANGUAGE sql
STABLE
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT count(*) FROM spaces WHERE (estate_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'estate_id'));
$$;

CREATE OR REPLACE FUNCTION auth.space_by_name(wanted text)
RETURNS text
LANGUAGE sql
STABLE
STRICT
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT id FROM spaces WHERE (estate_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'estate_id')) AND name = space_by_name.wanted ORDER BY id LIMIT 1;
$$;

CREATE OR REPLACE FUNCTION auth.theme_color(p_node text)
RETURNS text
LANGUAGE sql
STABLE
STRICT
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT x.v FROM (
    SELECT t.color AS v, c.depth AS d FROM paths c JOIN themes t ON t.folder_id = c.ancestor_id WHERE c.descendant_id = p_node AND t.color IS NOT NULL
    UNION ALL
    SELECT t.color, NULL FROM themes t WHERE t.folder_id IS NULL AND t.color IS NOT NULL AND t.space_id = (SELECT s.space_id FROM paths s WHERE s.ancestor_id = p_node AND s.descendant_id = p_node)
  ) x ORDER BY x.d NULLS LAST, x.v::text LIMIT 1;
$$;
REVOKE EXECUTE ON FUNCTION auth.theme_color(text) FROM PUBLIC;


