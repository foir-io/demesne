CREATE OR REPLACE FUNCTION auth.group_closure_member(p_group text, p_member text)
RETURNS boolean
LANGUAGE sql
STABLE
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT EXISTS (SELECT 1 FROM group_closure WHERE grp = p_group AND mem = p_member);
$$;


ALTER TABLE public.docs ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.docs FORCE ROW LEVEL SECURITY;

DROP POLICY IF EXISTS docs_select ON public.docs;
CREATE POLICY docs_select ON public.docs FOR SELECT TO authenticated
    USING ((tenant_id = (current_setting('request.jwt.claims', true)::json ->> 'tenant_id') AND workspace_id = (current_setting('request.jwt.claims', true)::json ->> 'workspace_id') AND (owner_id = (current_setting('request.jwt.claims', true)::json ->> 'member_id') OR auth.group_closure_member(audience_group, (current_setting('request.jwt.claims', true)::json ->> 'member_id')))));


-- ===== Closure maintenance (via closure / via group) =====
-- COST: each of these triggers write-amplifies the base table — a change
-- fans out to the transitive closure. This is the explicit, opt-in price of
-- O(1) indexed reachability (`via closure`) / membership (`via group`).

CREATE OR REPLACE FUNCTION auth.group_closure_rebuild()
RETURNS trigger
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = pg_catalog, public
AS $$
BEGIN
  -- Fast path: nothing to close over and nothing stale to clear. Load-bearing
  -- beyond speed: a statement trigger fires even when the statement touched
  -- zero rows, so WITHOUT this exit every unrelated cascade into the edge
  -- table (deleting a member-able principal that has no memberships) reached
  -- for the rebuild lock while already holding the cascade's own lock on the
  -- closure, and two such sessions deadlocked on the upgrade.
  IF NOT EXISTS (SELECT 1 FROM group_memberships) AND NOT EXISTS (SELECT 1 FROM group_closure) THEN
    RETURN NULL;
  END IF;
  -- Serialize concurrent rebuilds (CONCURRENCY): a full DELETE+INSERT under READ
  -- COMMITTED can otherwise lose a revocation — a second writer's DELETE cannot see the
  -- first writer's freshly-inserted (uncommitted) rows, so a revoked membership survives.
  -- This closure backs the via-group RLS floor (directly via <Closure>_member, and via any
  -- materialized flat built from it), so a stale survivor is a leak. An advisory
  -- transaction lock self-conflicts, so the second rebuild waits for the first COMMIT
  -- and its DELETE sees the first's rows (same guarantee a table lock gave), but unlike
  -- LOCK TABLE it is never an upgrade of the cascade's implicit lock on the closure,
  -- which is what deadlocked concurrent edge-cascading deletes. Readers are unaffected.
  PERFORM pg_advisory_xact_lock(hashtext('group_closure_rebuild'));
  DELETE FROM group_closure;
  INSERT INTO group_closure (grp, mem)
  WITH RECURSIVE tc AS (
    SELECT group_id AS grp, member_id AS mem FROM group_memberships
    UNION
    SELECT tc.grp, e.member_id FROM tc JOIN group_memberships e ON e.group_id = tc.mem
  )
  SELECT grp, mem FROM tc ON CONFLICT DO NOTHING;
  RETURN NULL;
END;
$$;

DROP TRIGGER IF EXISTS group_closure_rebuild ON public.group_memberships;
CREATE TRIGGER group_closure_rebuild AFTER INSERT OR UPDATE OR DELETE OR TRUNCATE ON public.group_memberships FOR EACH STATEMENT EXECUTE FUNCTION auth.group_closure_rebuild();


