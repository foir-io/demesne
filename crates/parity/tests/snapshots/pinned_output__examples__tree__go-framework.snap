func (s *Surface) Check(ctx context.Context, q demesne.Querier, object, verb, id string) (Decision, error) {
	switch object + "." + verb {
	case "folder.view":
		return s.Folder.CanView(ctx, q, id)
	case "folder.edit":
		return s.Folder.CanEdit(ctx, q, id)
	case "template.view":
		return s.Template.CanView(ctx, q, id)
	case "template.edit":
		return s.Template.CanEdit(ctx, q, id)
	case "atlas.view":
		return s.Atlas.CanView(ctx, q, id)
	case "atlas.edit":
		return s.Atlas.CanEdit(ctx, q, id)
	case "space.view":
		return s.Space.CanView(ctx, q, id)
	case "page.view":
		return s.Page.CanView(ctx, q, id)
	case "sheet.view":
		return s.Sheet.CanView(ctx, q, id)
	case "notice.view":
		return s.Notice.CanView(ctx, q, id)
	case "notice.edit":
		return s.Notice.CanEdit(ctx, q, id)
	case "draft.view":
		return s.Draft.CanView(ctx, q, id)
	case "ledger.view":
		return s.Ledger.CanView(ctx, q, id)
	case "ledger.edit":
		return s.Ledger.CanEdit(ctx, q, id)
	default:
		return NotGoverned, nil
	}
}

func (s *Surface) CheckHandler(q demesne.Querier) http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
		p := req.URL.Query()
		d, err := s.Check(req.Context(), q, p.Get("object"), p.Get("verb"), p.Get("id"))
		if err != nil {
			http.Error(w, err.Error(), http.StatusInternalServerError)
			return
		}
		w.Header().Set("Content-Type", "application/json")
		_ = json.NewEncoder(w).Encode(map[string]Decision{"decision": d})
	})
}

