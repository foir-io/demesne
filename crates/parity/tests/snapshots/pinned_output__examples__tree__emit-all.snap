DROP POLICY IF EXISTS atlases_select ON public.atlases;
CREATE POLICY atlases_select ON public.atlases FOR SELECT TO authenticated
    USING ((estate_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'estate_id') AND space_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'space_id') AND ((folder_id IS NULL OR folder_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'folder_id')) OR (folder_id IN (SELECT auth.paths_reach_set((SELECT current_setting('request.jwt.claims', true)::json ->> 'folder_id'))) OR folder_id IN (SELECT auth.paths_up_reach_set((SELECT current_setting('request.jwt.claims', true)::json ->> 'folder_id')))))));

DROP POLICY IF EXISTS atlases_update ON public.atlases;
CREATE POLICY atlases_update ON public.atlases FOR UPDATE TO authenticated
    USING ((estate_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'estate_id') AND space_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'space_id') AND folder_id IS NOT DISTINCT FROM (SELECT current_setting('request.jwt.claims', true)::json ->> 'folder_id')))
    WITH CHECK ((estate_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'estate_id') AND space_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'space_id') AND folder_id IS NOT DISTINCT FROM (SELECT current_setting('request.jwt.claims', true)::json ->> 'folder_id')));

