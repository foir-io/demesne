CREATE OR REPLACE FUNCTION auth.paths_reach(user_id text, check_folder_id text)
RETURNS boolean
LANGUAGE sql
STABLE
STRICT
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT EXISTS (SELECT 1 FROM paths WHERE ancestor_id = user_id AND descendant_id = check_folder_id);
$$;

CREATE OR REPLACE FUNCTION auth.paths_reach_set(user_id text)
RETURNS SETOF text
LANGUAGE sql
STABLE
STRICT
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT descendant_id FROM paths WHERE ancestor_id = user_id;
$$;

CREATE OR REPLACE FUNCTION auth.paths_up_reach(user_id text, check_folder_id text)
RETURNS boolean
LANGUAGE sql
STABLE
STRICT
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT EXISTS (SELECT 1 FROM paths WHERE descendant_id = user_id AND ancestor_id = check_folder_id);
$$;

CREATE OR REPLACE FUNCTION auth.paths_up_reach_set(user_id text)
RETURNS SETOF text
LANGUAGE sql
STABLE
STRICT
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT ancestor_id FROM paths WHERE descendant_id = user_id;
$$;

CREATE OR REPLACE FUNCTION auth.paths_reachable(p_ancestor text, p_descendant text)
RETURNS boolean
LANGUAGE sql
STABLE
STRICT
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT EXISTS (SELECT 1 FROM paths WHERE ancestor_id = p_ancestor AND descendant_id = p_descendant);
$$;

CREATE OR REPLACE FUNCTION auth.paths_descendants(p_node text)
RETURNS SETOF text
LANGUAGE sql
STABLE
STRICT
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT descendant_id FROM paths WHERE ancestor_id = p_node;
$$;

CREATE OR REPLACE FUNCTION auth.paths_ancestors(p_node text)
RETURNS SETOF text
LANGUAGE sql
STABLE
STRICT
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT ancestor_id FROM paths WHERE descendant_id = p_node;
$$;

CREATE OR REPLACE FUNCTION auth.paths_path(p_node text)
RETURNS TABLE(node text, depth integer)
LANGUAGE sql
STABLE
STRICT
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT ancestor_id, depth::integer FROM paths WHERE descendant_id = p_node ORDER BY depth DESC, ancestor_id;
$$;

CREATE OR REPLACE FUNCTION auth.space_can_view(p_space_id text)
RETURNS boolean
LANGUAGE sql
STABLE
STRICT
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT EXISTS (SELECT 1 FROM spaces WHERE spaces.id = p_space_id AND ((estate_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'estate_id') AND ((status = 'open')))));
$$;


