CREATE OR REPLACE FUNCTION auth.approvals_reach(user_id text, check_estate_id text)
RETURNS boolean
LANGUAGE sql
STABLE
STRICT
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT EXISTS (SELECT 1 FROM approvals WHERE holder_id = user_id AND estate_id = check_estate_id AND ended_at IS NULL AND expires_at > now() AND (space_id IS NULL OR space_id = (SELECT NULLIF(current_setting('request.jwt.claims', true), '')::json ->> 'space_id')) AND (folder_id IS NULL OR (SELECT NULLIF(current_setting('request.jwt.claims', true), '')::json ->> 'folder_id') IS NULL OR folder_id = (SELECT NULLIF(current_setting('request.jwt.claims', true), '')::json ->> 'folder_id')));
$$;

CREATE OR REPLACE FUNCTION auth.approvals_reach_set(user_id text)
RETURNS SETOF text
LANGUAGE sql
STABLE
STRICT
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT estate_id FROM approvals WHERE holder_id = user_id AND ended_at IS NULL AND expires_at > now() AND (space_id IS NULL OR space_id = (SELECT NULLIF(current_setting('request.jwt.claims', true), '')::json ->> 'space_id')) AND (folder_id IS NULL OR (SELECT NULLIF(current_setting('request.jwt.claims', true), '')::json ->> 'folder_id') IS NULL OR folder_id = (SELECT NULLIF(current_setting('request.jwt.claims', true), '')::json ->> 'folder_id'));
$$;

