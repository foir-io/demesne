CREATE OR REPLACE FUNCTION auth.paths_reachable(p_ancestor text, p_descendant text)
RETURNS boolean
LANGUAGE sql
STABLE
STRICT
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT EXISTS (SELECT 1 FROM paths WHERE ancestor_id = p_ancestor AND descendant_id = p_descendant);
$$;

CREATE OR REPLACE FUNCTION auth.catalog_can_bound_for_select(p_catalog_id text)
RETURNS boolean
LANGUAGE sql
STABLE
STRICT
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT EXISTS (SELECT 1 FROM catalogs WHERE catalogs.id = p_catalog_id AND (((estate_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'estate_id') OR estate_id IN (SELECT auth.approvals_reach_set((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub')))) AND space_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'space_id') AND ((folder_id IS NULL OR folder_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'folder_id')) OR folder_id IN (SELECT auth.paths_up_reach_set((SELECT current_setting('request.jwt.claims', true)::json ->> 'folder_id'))) OR (SELECT current_setting('request.jwt.claims', true)::json ->> 'view_mode') = 'all') AND (((SELECT current_setting('request.jwt.claims', true)::json ->> 'kind') = 'staff')))));
$$;

CREATE OR REPLACE FUNCTION auth.catalog_can_bound(p_catalog_id text)
RETURNS boolean
LANGUAGE sql
STABLE
STRICT
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT EXISTS (SELECT 1 FROM catalogs WHERE catalogs.id = p_catalog_id AND (((estate_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'estate_id') OR estate_id IN (SELECT auth.approvals_reach_set((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub')))) AND space_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'space_id') AND folder_id IS NOT DISTINCT FROM (SELECT current_setting('request.jwt.claims', true)::json ->> 'folder_id') AND (((SELECT current_setting('request.jwt.claims', true)::json ->> 'kind') = 'staff')))));
$$;

CREATE OR REPLACE FUNCTION auth.folder_write_allowed(check_folder_id text, row_estate_id text, row_space_id text)
RETURNS boolean
LANGUAGE sql
STABLE
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT (((estate_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'estate_id') OR estate_id IN (SELECT auth.approvals_reach_set((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub')))) AND space_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'space_id') AND (((SELECT current_setting('request.jwt.claims', true)::json ->> 'kind') = 'staff')))) OR ((estate_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'estate_id') OR estate_id IN (SELECT auth.approvals_reach_set((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub')))) AND space_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'space_id') AND (((SELECT current_setting('request.jwt.claims', true)::json ->> 'kind') = 'robot') AND (estate_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'estate_id')) AND (space_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'space_id')) AND (((SELECT current_setting('request.jwt.claims', true)::json ->> 'folder_id') IS NULL OR auth.paths_reachable((SELECT current_setting('request.jwt.claims', true)::json ->> 'folder_id'), id))))) FROM (SELECT check_folder_id AS id, row_estate_id AS estate_id, row_space_id AS space_id) AS folders;
$$;


