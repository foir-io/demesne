CREATE OR REPLACE FUNCTION auth.approvals_reach_in_space(user_id text, check_estate_id text, check_space_id text)
RETURNS boolean
LANGUAGE sql
STABLE
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT EXISTS (SELECT 1 FROM approvals WHERE holder_id = user_id AND estate_id = check_estate_id AND ended_at IS NULL AND expires_at > now() AND (space_id IS NULL OR check_space_id = '' OR space_id = check_space_id));
$$;

