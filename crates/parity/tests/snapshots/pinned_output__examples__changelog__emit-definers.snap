CREATE OR REPLACE FUNCTION auth.note_grants_grants(p_member_id text, p_note_id text, p_access text)
RETURNS boolean
LANGUAGE sql
STABLE
STRICT
SECURITY DEFINER
SET search_path = public, pg_temp
AS $$
  SELECT p_member_id = (SELECT NULLIF(current_setting('request.jwt.claims', true), '')::json ->> 'sub') AND (EXISTS (SELECT 1 FROM note_grants WHERE note_id = p_note_id AND principal_kind = 'member' AND principal_id = p_member_id AND access = p_access));
$$;
GRANT EXECUTE ON FUNCTION auth.note_grants_grants(text, text, text) TO PUBLIC;

CREATE OR REPLACE FUNCTION auth.notes_accessors_conditional(p_id text)
RETURNS TABLE(source text, principal_kind text, principal_id text, access text, via_claim_keys text[], via_claim_values text[])
LANGUAGE sql
STABLE
SECURITY DEFINER
SET search_path = public, pg_temp
AS $$
  SELECT b.source, b.principal_kind, b.principal_id, b.access, NULL::text[] AS via_claim_keys, NULL::text[] AS via_claim_values
    FROM (
  SELECT 'owner'::text AS source, 'member'::text AS principal_kind, owner_id AS principal_id, 'write'::text AS access
    FROM notes WHERE id = p_id AND owner_id IS NOT NULL AND owner_kind = 'member'
  UNION ALL
  SELECT 'grant'::text, principal_kind, principal_id, access
    FROM note_grants WHERE note_id = p_id
    ) b(source, principal_kind, principal_id, access)
  UNION ALL
  SELECT 'mode'::text, NULL::text, NULL::text, 'read'::text, NULL::text[], NULL::text[]
    FROM notes WHERE id = p_id AND visibility = 'public'
$$;
REVOKE EXECUTE ON FUNCTION auth.notes_accessors_conditional(text) FROM PUBLIC;

CREATE OR REPLACE FUNCTION auth.notes_admits(p_id text, p_claims jsonb)
RETURNS boolean
LANGUAGE plpgsql
STABLE
STRICT
SECURITY DEFINER
SET search_path = public, pg_temp
AS $$
#variable_conflict use_column
DECLARE
  prior text := current_setting('request.jwt.claims', true);
  admitted boolean;
BEGIN
  PERFORM set_config('request.jwt.claims', p_claims::text, true);
  admitted := EXISTS (SELECT 1 FROM notes WHERE id = p_id AND ((workspace_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'workspace_id') AND project_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'project_id') AND ((owner_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'sub') AND owner_kind = 'member') OR visibility = 'public' OR auth.note_grants_grants((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub'), notes.id, 'read') OR auth.note_grants_grants((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub'), notes.id, 'write')))));
  PERFORM set_config('request.jwt.claims', coalesce(prior, ''), true);
  RETURN admitted;
END
$$;
REVOKE EXECUTE ON FUNCTION auth.notes_admits(text, jsonb) FROM PUBLIC;


