CREATE OR REPLACE FUNCTION auth.support_grants_reach_set(user_id text)
RETURNS SETOF text
LANGUAGE sql
STABLE
STRICT
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT tenant_id FROM support_grants WHERE holder_id = user_id AND ended_at IS NULL AND user_id = (SELECT NULLIF(current_setting('request.jwt.claims', true), '')::json ->> 'sub');
$$;
GRANT EXECUTE ON FUNCTION auth.support_grants_reach_set(text) TO PUBLIC;

CREATE OR REPLACE FUNCTION auth.acl_grants_note(p_member_id text, p_note_id text, p_access text)
RETURNS boolean
LANGUAGE sql
STABLE
STRICT
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT p_member_id IN ((SELECT NULLIF(current_setting('request.jwt.claims', true), '')::json ->> 'sub'), (SELECT NULLIF(current_setting('request.jwt.claims', true), '')::json ->> 'member_id')) AND (EXISTS (SELECT 1 FROM acl WHERE resource_id = p_note_id AND resource_type = 'note' AND principal_kind = 'member' AND principal_id = p_member_id AND access = p_access));
$$;
GRANT EXECUTE ON FUNCTION auth.acl_grants_note(text, text, text) TO PUBLIC;

CREATE OR REPLACE FUNCTION auth.notes_accessors(p_id text)
RETURNS TABLE(source text, principal_kind text, principal_id text, access text)
LANGUAGE sql
STABLE
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT 'owner'::text AS source, 'member'::text AS principal_kind, owner_id AS principal_id, 'write'::text AS access
    FROM notes WHERE id = p_id AND owner_id IS NOT NULL
  UNION ALL
  SELECT 'grant'::text, principal_kind, principal_id, access
    FROM acl WHERE resource_id = p_id AND resource_type = 'note'
  UNION ALL
  SELECT a.source, a.principal_kind, a.principal_id, a.access
    FROM notes t
    JOIN LATERAL auth.docs_accessors(t.doc_id) a ON true
    WHERE t.id = p_id
$$;
REVOKE EXECUTE ON FUNCTION auth.notes_accessors(text) FROM PUBLIC;

CREATE OR REPLACE FUNCTION auth.doc_can_view(p_doc_id text)
RETURNS boolean
LANGUAGE sql
STABLE
STRICT
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT EXISTS (SELECT 1 FROM docs WHERE docs.id = p_doc_id AND (((tenant_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'tenant_id') OR tenant_id IN (SELECT auth.support_grants_reach_set((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub')))) AND workspace_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'workspace_id') AND (owner_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'member_id') OR auth.acl_grants_doc((SELECT current_setting('request.jwt.claims', true)::json ->> 'member_id'), docs.id, 'read') OR auth.acl_grants_doc((SELECT current_setting('request.jwt.claims', true)::json ->> 'member_id'), docs.id, 'write')))));
$$;
GRANT EXECUTE ON FUNCTION auth.doc_can_view(text) TO PUBLIC;

CREATE OR REPLACE FUNCTION auth.notes_admits(p_id text, p_claims jsonb)
RETURNS boolean
LANGUAGE plpgsql
STABLE
STRICT
SECURITY DEFINER
SET search_path = public
AS $$
#variable_conflict use_column
DECLARE
  prior text := current_setting('request.jwt.claims', true);
  admitted boolean;
BEGIN
  PERFORM set_config('request.jwt.claims', p_claims::text, true);
  admitted := EXISTS (SELECT 1 FROM notes WHERE id = p_id AND (((tenant_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'tenant_id') OR tenant_id IN (SELECT auth.support_grants_reach_set((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub')))) AND workspace_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'workspace_id') AND (owner_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'member_id') OR auth.acl_grants_note((SELECT current_setting('request.jwt.claims', true)::json ->> 'member_id'), notes.id, 'read') OR auth.acl_grants_note((SELECT current_setting('request.jwt.claims', true)::json ->> 'member_id'), notes.id, 'write') OR auth.doc_can_view(doc_id)))));
  PERFORM set_config('request.jwt.claims', coalesce(prior, ''), true);
  RETURN admitted;
END
$$;
REVOKE EXECUTE ON FUNCTION auth.notes_admits(text, jsonb) FROM PUBLIC;

CREATE OR REPLACE FUNCTION auth.note_can_edit(p_id text)
RETURNS boolean
LANGUAGE sql
STABLE
STRICT
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT EXISTS (SELECT 1 FROM notes WHERE notes.id = p_id AND (((tenant_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'tenant_id') OR tenant_id IN (SELECT auth.support_grants_reach_set((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub')))) AND workspace_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'workspace_id') AND (owner_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'member_id') OR auth.acl_grants_note((SELECT current_setting('request.jwt.claims', true)::json ->> 'member_id'), notes.id, 'write')))));
$$;
REVOKE EXECUTE ON FUNCTION auth.note_can_edit(text) FROM PUBLIC;

CREATE OR REPLACE FUNCTION auth.acl_manage(p_type text, p_id text)
RETURNS boolean
LANGUAGE sql
STABLE
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT (CASE p_type WHEN 'doc' THEN (SELECT auth.doc_can_edit(p_id)) WHEN 'note' THEN (SELECT auth.note_can_edit(p_id)) ELSE false END);
$$;
GRANT EXECUTE ON FUNCTION auth.acl_manage(text, text) TO PUBLIC;

ALTER TABLE public.notes ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.notes FORCE ROW LEVEL SECURITY;

DROP POLICY IF EXISTS notes_select ON public.notes;
CREATE POLICY notes_select ON public.notes FOR SELECT TO authenticated
    USING (((tenant_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'tenant_id') OR tenant_id IN (SELECT auth.support_grants_reach_set((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub')))) AND workspace_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'workspace_id') AND (owner_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'member_id') OR auth.acl_grants_note((SELECT current_setting('request.jwt.claims', true)::json ->> 'member_id'), notes.id, 'read') OR auth.acl_grants_note((SELECT current_setting('request.jwt.claims', true)::json ->> 'member_id'), notes.id, 'write') OR auth.doc_can_view(doc_id))));

DROP POLICY IF EXISTS notes_update ON public.notes;
CREATE POLICY notes_update ON public.notes FOR UPDATE TO authenticated
    USING (((tenant_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'tenant_id') OR tenant_id IN (SELECT auth.support_grants_reach_set((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub')))) AND workspace_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'workspace_id') AND (owner_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'member_id') OR auth.acl_grants_note((SELECT current_setting('request.jwt.claims', true)::json ->> 'member_id'), notes.id, 'write'))))
    WITH CHECK (((tenant_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'tenant_id') OR tenant_id IN (SELECT auth.support_grants_reach_set((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub')))) AND workspace_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'workspace_id') AND (owner_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'member_id') OR auth.acl_grants_note((SELECT current_setting('request.jwt.claims', true)::json ->> 'member_id'), notes.id, 'write'))));

-- ===== Dropped since the previous manifest =====
DROP FUNCTION IF EXISTS auth.retired(text);
DROP FUNCTION IF EXISTS auth.support_grants_reach(text, text);
DO $demesne$
DECLARE
  survivors text;
BEGIN
  SELECT string_agg(what, ', ' ORDER BY what) INTO survivors FROM (
    SELECT 'function ' || p.oid::regprocedure::text AS what
      FROM pg_proc p JOIN pg_namespace n ON n.oid = p.pronamespace
      WHERE (n.nspname, p.proname) IN (('auth'::name, 'retired'::name), ('auth'::name, 'support_grants_reach'::name))
        AND p.oid <> ALL (array_remove(ARRAY[]::oid[], NULL))
  ) s;
  IF survivors IS NOT NULL THEN
    RAISE EXCEPTION 'demesne: still present after the drops: %', survivors;
  END IF;
END
$demesne$;

