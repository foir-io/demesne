export interface Claims {
  estateID?: string;
  folderID?: string;
  spaceID?: string;
  sub?: string;
  extra?: Record<string, string>;
}

export function mint(c: Claims): string {
  const values: Record<string, string> = {};
  if (c.estateID !== undefined && c.estateID !== "") values["estate_id"] = c.estateID;
  if (c.folderID !== undefined && c.folderID !== "") values["folder_id"] = c.folderID;
  if (c.spaceID !== undefined && c.spaceID !== "") values["space_id"] = c.spaceID;
  if (c.sub !== undefined && c.sub !== "") values["sub"] = c.sub;
  return mintClaimsValuesWithExtra(claimsContract, values, c.extra);
}

