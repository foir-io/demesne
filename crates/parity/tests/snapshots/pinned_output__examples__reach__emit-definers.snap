  SELECT estate_id FROM approvals WHERE holder_id = user_id AND ended_at IS NULL AND expires_at > now() AND (space_id IS NULL OR space_id = (NULLIF(current_setting('request.jwt.claims', true), '')::json ->> 'space_id')) AND (folder_id IS NULL OR (NULLIF(current_setting('request.jwt.claims', true), '')::json ->> 'folder_id') IS NULL OR folder_id = (NULLIF(current_setting('request.jwt.claims', true), '')::json ->> 'folder_id'));
$$;

