REVOKE EXECUTE ON FUNCTION auth.doc_terms_hold_inside(text, text, jsonb) FROM PUBLIC;

CREATE OR REPLACE FUNCTION auth.doc_composition_lent_0(p_doc_id text, p_access text, p_slot text)
RETURNS boolean
LANGUAGE plpgsql
STABLE
STRICT
SECURITY DEFINER
SET search_path = public
AS $$
#variable_conflict use_column
BEGIN
  IF p_access = 'read' THEN
    RETURN EXISTS (SELECT 1 FROM doc_lends e WHERE e.borrower_id = p_doc_id AND e.field::text = p_slot AND CASE WHEN EXISTS (SELECT 1 FROM docs WHERE docs.id = e.lender_id AND ((estate_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'estate_id') AND (EXISTS (SELECT 1 FROM unnest(docs.rules_live) AS demesne_element(v) WHERE starts_with(demesne_element.v, 'read.') AND demesne_element.v = ANY(ARRAY(SELECT e FROM jsonb_array_elements_text((SELECT current_setting('request.jwt.claims', true)::json ->> 'rules_held')::jsonb) e)) AND ((NOT EXISTS (SELECT 1 FROM auth.rule_slots_declared_by_rule(demesne_element.v) AS demesne_slot WHERE demesne_slot.role = 'require' AND ((demesne_slot.kind = 'share') AND (auth.doc_shared_keyed_inside((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub'), docs.id, demesne_element.v))) IS NOT TRUE)) AND (auth.doc_terms_hold_inside(docs.id, demesne_element.v, (SELECT (current_setting('request.jwt.claims', true)::json -> 'facts')::jsonb))))))))) THEN (NOT EXISTS (SELECT 1 FROM auth.trail_hops_declared_by_trail(e.trail::text) AS demesne_slot WHERE (((demesne_slot.kind = 'claim') AND (demesne_slot.rule = ANY(ARRAY(SELECT e FROM jsonb_array_elements_text((SELECT current_setting('request.jwt.claims', true)::json ->> 'rules_held')::jsonb) e)))) OR ((demesne_slot.kind = 'live') AND ((SELECT CASE WHEN demesne_hop.record IS NULL OR demesne_hop.element IS NULL OR demesne_hop.slot IS NULL THEN NULL ELSE EXISTS (SELECT 1 FROM docs WHERE docs.id = demesne_hop.record AND estate_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'estate_id') AND (EXISTS (SELECT 1 FROM unnest(docs.rules_live) AS demesne_element(v) WHERE demesne_element.v = demesne_hop.element AND starts_with(demesne_element.v, 'read.') AND demesne_element.v = ANY(ARRAY(SELECT e FROM jsonb_array_elements_text((SELECT current_setting('request.jwt.claims', true)::json ->> 'rules_held')::jsonb) e)) AND ((NOT EXISTS (SELECT 1 FROM auth.rule_slots_declared_by_rule(demesne_element.v) AS demesne_slot WHERE demesne_slot.role = 'require' AND ((demesne_slot.kind = 'share') AND (auth.doc_shared_keyed_inside((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub'), docs.id, demesne_element.v)) OR (demesne_slot.kind = 'lend') AND (demesne_slot.param = demesne_hop.slot)) IS NOT TRUE)) AND (auth.doc_terms_hold_inside(docs.id, demesne_element.v, (SELECT (current_setting('request.jwt.claims', true)::json -> 'facts')::jsonb))))))) END FROM (SELECT demesne_slot.doc_id AS record, demesne_slot.rule AS element, demesne_slot.field AS slot) AS demesne_hop)))) IS NOT TRUE)) ELSE false END);
  END IF;
  RETURN false;
END
$$;

CREATE OR REPLACE FUNCTION auth.doc_composition_lent(p_doc_id text, p_access text, p_slot text)
RETURNS boolean
LANGUAGE plpgsql
STABLE
STRICT
SECURITY DEFINER
SET search_path = public
AS $$
#variable_conflict use_column
BEGIN
  IF p_access = 'read' THEN
    RETURN EXISTS (SELECT 1 FROM doc_lends e WHERE e.borrower_id = p_doc_id AND e.field::text = p_slot AND CASE WHEN EXISTS (SELECT 1 FROM docs WHERE docs.id = e.lender_id AND ((estate_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'estate_id') AND (EXISTS (SELECT 1 FROM unnest(docs.rules_live) AS demesne_element(v) WHERE starts_with(demesne_element.v, 'read.') AND demesne_element.v = ANY(ARRAY(SELECT e FROM jsonb_array_elements_text((SELECT current_setting('request.jwt.claims', true)::json ->> 'rules_held')::jsonb) e)) AND ((NOT EXISTS (SELECT 1 FROM auth.rule_slots_declared_by_rule(demesne_element.v) AS demesne_slot WHERE demesne_slot.role = 'require' AND ((demesne_slot.kind = 'share') AND (auth.doc_shared_keyed_inside((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub'), docs.id, demesne_element.v))) IS NOT TRUE)) AND (auth.doc_terms_hold_inside(docs.id, demesne_element.v, (SELECT (current_setting('request.jwt.claims', true)::json -> 'facts')::jsonb))))))))) THEN (NOT EXISTS (SELECT 1 FROM auth.trail_hops_declared_by_trail(e.trail::text) AS demesne_slot WHERE (((demesne_slot.kind = 'claim') AND (demesne_slot.rule = ANY(ARRAY(SELECT e FROM jsonb_array_elements_text((SELECT current_setting('request.jwt.claims', true)::json ->> 'rules_held')::jsonb) e)))) OR ((demesne_slot.kind = 'live') AND ((SELECT CASE WHEN demesne_hop.record IS NULL OR demesne_hop.element IS NULL OR demesne_hop.slot IS NULL THEN NULL ELSE EXISTS (SELECT 1 FROM docs WHERE docs.id = demesne_hop.record AND estate_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'estate_id') AND (EXISTS (SELECT 1 FROM unnest(docs.rules_live) AS demesne_element(v) WHERE demesne_element.v = demesne_hop.element AND starts_with(demesne_element.v, 'read.') AND demesne_element.v = ANY(ARRAY(SELECT e FROM jsonb_array_elements_text((SELECT current_setting('request.jwt.claims', true)::json ->> 'rules_held')::jsonb) e)) AND ((NOT EXISTS (SELECT 1 FROM auth.rule_slots_declared_by_rule(demesne_element.v) AS demesne_slot WHERE demesne_slot.role = 'require' AND ((demesne_slot.kind = 'share') AND (auth.doc_shared_keyed_inside((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub'), docs.id, demesne_element.v)) OR (demesne_slot.kind = 'lend') AND ((demesne_slot.param = demesne_hop.slot OR auth.doc_composition_lent_0(docs.id, 'read', demesne_slot.param)))) IS NOT TRUE)) AND (auth.doc_terms_hold_inside(docs.id, demesne_element.v, (SELECT (current_setting('request.jwt.claims', true)::json -> 'facts')::jsonb))))))) END FROM (SELECT demesne_slot.doc_id AS record, demesne_slot.rule AS element, demesne_slot.field AS slot) AS demesne_hop)))) IS NOT TRUE)) ELSE false END);
  END IF;
  RETURN false;
END
$$;

CREATE OR REPLACE FUNCTION auth.doc_select_holds_at(p_record text, p_element text)
RETURNS boolean
LANGUAGE sql
STABLE
STRICT
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT EXISTS (SELECT 1 FROM docs WHERE docs.id = p_record AND estate_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'estate_id') AND (EXISTS (SELECT 1 FROM unnest(docs.rules_live) AS demesne_element(v) WHERE demesne_element.v = p_element AND starts_with(demesne_element.v, 'read.') AND demesne_element.v = ANY(ARRAY(SELECT e FROM jsonb_array_elements_text((SELECT current_setting('request.jwt.claims', true)::json ->> 'rules_held')::jsonb) e)) AND ((NOT EXISTS (SELECT 1 FROM auth.rule_slots_declared_by_rule(demesne_element.v) AS demesne_slot WHERE demesne_slot.role = 'require' AND ((demesne_slot.kind = 'share') AND (auth.doc_shared_keyed_inside((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub'), docs.id, demesne_element.v)) OR (demesne_slot.kind = 'lend') AND (auth.doc_composition_lent(docs.id, 'read', demesne_slot.param))) IS NOT TRUE)) AND (auth.doc_terms_hold_inside(docs.id, demesne_element.v, (SELECT (current_setting('request.jwt.claims', true)::json -> 'facts')::jsonb)))))));
$$;


ALTER TABLE public.banners ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.banners FORCE ROW LEVEL SECURITY;
ALTER TABLE public.docs ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.docs FORCE ROW LEVEL SECURITY;
ALTER TABLE public.keeper_profiles ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.keeper_profiles FORCE ROW LEVEL SECURITY;
ALTER TABLE public.skins ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.skins FORCE ROW LEVEL SECURITY;
ALTER TABLE public.spaces ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.spaces FORCE ROW LEVEL SECURITY;

DROP POLICY IF EXISTS banners_select ON public.banners;
CREATE POLICY banners_select ON public.banners FOR SELECT TO authenticated
    USING ((estate_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'estate_id') AND space_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'space_id')));

DROP POLICY IF EXISTS banners_select_require ON public.banners;
CREATE POLICY banners_select_require ON public.banners AS RESTRICTIVE FOR SELECT TO authenticated
    USING ((SELECT current_setting('request.jwt.claims', true)::json ->> 'folder_id') IS NULL OR skin_id = (SELECT auth.live_skin_own((SELECT current_setting('request.jwt.claims', true)::json ->> 'folder_id'))));

DROP POLICY IF EXISTS docs_select ON public.docs;
CREATE POLICY docs_select ON public.docs FOR SELECT TO authenticated
    USING ((estate_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'estate_id') AND (EXISTS (SELECT 1 FROM unnest(docs.rules_live) AS demesne_element(v) WHERE starts_with(demesne_element.v, 'read.') AND demesne_element.v = ANY(ARRAY(SELECT e FROM jsonb_array_elements_text((SELECT current_setting('request.jwt.claims', true)::json ->> 'rules_held')::jsonb) e)) AND ((NOT EXISTS (SELECT 1 FROM auth.rule_slots_declared_by_rule(demesne_element.v) AS demesne_slot WHERE demesne_slot.role = 'require' AND ((demesne_slot.kind = 'share') AND (auth.doc_shared_keyed((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub'), docs.id, demesne_element.v)) OR (demesne_slot.kind = 'lend') AND (auth.doc_composition_lent(docs.id, 'read', demesne_slot.param))) IS NOT TRUE)) AND (auth.doc_terms_hold(docs.id, demesne_element.v, (SELECT (current_setting('request.jwt.claims', true)::json -> 'facts')::jsonb))))))));

DROP POLICY IF EXISTS keeper_profiles_select ON public.keeper_profiles;
CREATE POLICY keeper_profiles_select ON public.keeper_profiles FOR SELECT TO authenticated
    USING ((estate_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'estate_id') AND (id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'sub') OR auth.keeper_memberin_space(id, (SELECT current_setting('request.jwt.claims', true)::json ->> 'space_id')))));

DROP POLICY IF EXISTS skins_select ON public.skins;
CREATE POLICY skins_select ON public.skins FOR SELECT TO authenticated
    USING ((estate_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'estate_id') AND space_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'space_id')));

DROP POLICY IF EXISTS spaces_select ON public.spaces;
CREATE POLICY spaces_select ON public.spaces FOR SELECT TO authenticated
    USING ((estate_id = (SELECT current_setting('request.jwt.claims', true)::json ->> 'estate_id') AND (auth.keeper_memberin_space((SELECT current_setting('request.jwt.claims', true)::json ->> 'sub'), id))));


-- ===== Closure maintenance (via closure / via group) =====
-- COST: each of these triggers write-amplifies the base table — a change
-- fans out to the transitive closure. This is the explicit, opt-in price of
-- O(1) indexed reachability (`via closure`) / membership (`via group`).

CREATE OR REPLACE FUNCTION auth.paths_maintain()
RETURNS trigger
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = pg_catalog, public
AS $$
BEGIN
  IF (TG_OP = 'DELETE') THEN
    PERFORM pg_advisory_xact_lock(hashtext('paths'), COALESCE(hashtext(OLD.space_id::text), 0));
    DELETE FROM paths WHERE descendant_id = OLD.id OR ancestor_id = OLD.id;
    RETURN OLD;
  END IF;
  PERFORM pg_advisory_xact_lock(hashtext('paths'), COALESCE(hashtext(NEW.space_id::text), 0));
  IF (TG_OP = 'UPDATE') THEN
    IF NEW.space_id IS DISTINCT FROM OLD.space_id THEN
      RAISE EXCEPTION 'a row of folders keeps its space_id: the closure paths is partitioned by it' USING ERRCODE = 'check_violation', CONSTRAINT = 'paths_scope_fixed', TABLE = 'folders';
    END IF;
    IF NEW.parent_id IS NOT NULL AND EXISTS (SELECT 1 FROM paths WHERE ancestor_id = NEW.id AND descendant_id = NEW.parent_id) THEN
      RAISE EXCEPTION 'a row of folders cannot sit beneath itself' USING ERRCODE = 'check_violation', CONSTRAINT = 'paths_acyclic', TABLE = 'folders';
    END IF;
    DELETE FROM paths
      WHERE descendant_id IN (SELECT descendant_id FROM paths WHERE ancestor_id = NEW.id)
        AND ancestor_id IN (SELECT ancestor_id FROM paths WHERE descendant_id = NEW.id AND ancestor_id <> NEW.id);
  ELSE
    IF NEW.parent_id = NEW.id THEN
      RAISE EXCEPTION 'a row of folders cannot sit beneath itself' USING ERRCODE = 'check_violation', CONSTRAINT = 'paths_acyclic', TABLE = 'folders';
    END IF;
    INSERT INTO paths (ancestor_id, descendant_id, space_id, depth) VALUES (NEW.id, NEW.id, NEW.space_id, 0) ON CONFLICT DO NOTHING;
  END IF;
  IF NEW.parent_id IS NOT NULL THEN
    IF NOT EXISTS (SELECT 1 FROM paths WHERE ancestor_id = NEW.parent_id AND descendant_id = NEW.parent_id AND space_id IS NOT DISTINCT FROM NEW.space_id) THEN
      RAISE EXCEPTION 'the parent_id of a row of folders names no row the closure paths holds' USING ERRCODE = 'check_violation', CONSTRAINT = 'paths_parent_known', TABLE = 'folders';
    END IF;
    INSERT INTO paths (ancestor_id, descendant_id, space_id, depth)
      SELECT p.ancestor_id, sub.descendant_id, NEW.space_id, p.depth + sub.depth + 1
        FROM paths p
        CROSS JOIN paths sub
        WHERE p.descendant_id = NEW.parent_id AND sub.ancestor_id = NEW.id
      ON CONFLICT DO NOTHING;
  END IF;
  RETURN NEW;
END;
$$;

DROP TRIGGER IF EXISTS paths_maintain_ins ON public.folders;
CREATE TRIGGER paths_maintain_ins AFTER INSERT ON public.folders FOR EACH ROW EXECUTE FUNCTION auth.paths_maintain();
DROP TRIGGER IF EXISTS paths_maintain_upd ON public.folders;
CREATE TRIGGER paths_maintain_upd AFTER UPDATE ON public.folders FOR EACH ROW WHEN (OLD.parent_id IS DISTINCT FROM NEW.parent_id OR OLD.space_id IS DISTINCT FROM NEW.space_id) EXECUTE FUNCTION auth.paths_maintain();
DROP TRIGGER IF EXISTS paths_maintain_del ON public.folders;
CREATE TRIGGER paths_maintain_del AFTER DELETE ON public.folders FOR EACH ROW EXECUTE FUNCTION auth.paths_maintain();


