      WHEN 'not_suffix' THEN holds := CASE WHEN x_txt IS NOT NULL AND c.txt IS NOT NULL THEN NOT (right(c.txt, length(x_txt)) = x_txt COLLATE "C") END;
      WHEN 'suffix' THEN holds := right(c.txt, length(x_txt)) = x_txt COLLATE "C";
      WHEN 'not_caller_contains' THEN holds := CASE WHEN x_txt IS NOT NULL AND c.txt IS NOT NULL THEN NOT (strpos(x_txt, c.txt) > 0) END;
      WHEN 'caller_contains' THEN holds := strpos(x_txt, c.txt) > 0;
      WHEN 'not_caller_prefix' THEN holds := CASE WHEN x_txt IS NOT NULL AND c.txt IS NOT NULL THEN NOT (starts_with(x_txt, c.txt)) END;
      WHEN 'caller_prefix' THEN holds := starts_with(x_txt, c.txt);
      WHEN 'not_caller_suffix' THEN holds := CASE WHEN x_txt IS NOT NULL AND c.txt IS NOT NULL THEN NOT (right(x_txt, length(c.txt)) = c.txt COLLATE "C") END;
      WHEN 'caller_suffix' THEN holds := right(x_txt, length(c.txt)) = c.txt COLLATE "C";
