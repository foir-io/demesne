      WHEN 'in' THEN holds := CASE WHEN jsonb_typeof(x_v) = 'array' THEN EXISTS (SELECT 1 FROM jsonb_array_elements(x_v) e WHERE (jsonb_typeof(e) = 'number' AND (e #>> '{}')::double precision = c.num) OR (jsonb_typeof(e) = 'string' AND (e #>> '{}') = c.txt COLLATE "C")) END;
      WHEN 'not_in' THEN holds := NOT (CASE WHEN jsonb_typeof(x_v) = 'array' THEN EXISTS (SELECT 1 FROM jsonb_array_elements(x_v) e WHERE (jsonb_typeof(e) = 'number' AND (e #>> '{}')::double precision = c.num) OR (jsonb_typeof(e) = 'string' AND (e #>> '{}') = c.txt COLLATE "C")) END);
      WHEN 'not_contains' THEN holds := CASE WHEN x_txt IS NOT NULL AND c.txt IS NOT NULL THEN NOT (strpos(c.txt, x_txt) > 0) END;
      WHEN 'contains' THEN holds := strpos(c.txt, x_txt) > 0;
      WHEN 'not_prefix' THEN holds := CASE WHEN x_txt IS NOT NULL AND c.txt IS NOT NULL THEN NOT (starts_with(c.txt, x_txt)) END;
