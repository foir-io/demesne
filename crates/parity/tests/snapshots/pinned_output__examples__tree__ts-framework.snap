export async function check(q: Querier, object: string, verb: string, id: string): Promise<Decision> {
  switch (object + "." + verb) {
    case "folder.view":
      return folder.canView(q, id);
    case "folder.edit":
      return folder.canEdit(q, id);
    case "template.view":
      return template.canView(q, id);
    case "template.edit":
      return template.canEdit(q, id);
    case "atlas.view":
      return atlas.canView(q, id);
    case "atlas.edit":
      return atlas.canEdit(q, id);
    case "space.view":
      return space.canView(q, id);
    case "page.view":
      return page.canView(q, id);
    case "sheet.view":
      return sheet.canView(q, id);
    case "notice.view":
      return notice.canView(q, id);
    case "notice.edit":
      return notice.canEdit(q, id);
    case "draft.view":
      return draft.canView(q, id);
    case "ledger.view":
      return ledger.canView(q, id);
    case "ledger.edit":
      return ledger.canEdit(q, id);
    default:
      return Decision.NotGoverned;
  }
}

export function checkHandler(q: Querier): (req: Request) => Promise<Response> {
  return async (req: Request): Promise<Response> => {
    const url = new URL(req.url);
    try {
      const d = await check(
        q,
        url.searchParams.get("object") ?? "",
        url.searchParams.get("verb") ?? "",
        url.searchParams.get("id") ?? "",
      );
      return new Response(JSON.stringify({ decision: d }), {
        headers: { "Content-Type": "application/json" },
      });
    } catch (e) {
      return new Response((e as Error).message, { status: 500 });
    }
  };
}

