{
  "name": "demesne",
  "displayName": "Demesne",
  "description": "Syntax highlighting and live validation for Demesne authorization specs (.demesne)",
  "version": "0.1.0",
  "publisher": "eidestudio",
  "license": "Apache-2.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/foir-io/demesne.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:demesne"
  ],
  "contributes": {
    "languages": [
      {
        "id": "demesne",
        "aliases": [
          "Demesne",
          "demesne"
        ],
        "extensions": [
          ".demesne"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "demesne",
        "scopeName": "source.demesne",
        "path": "./syntaxes/demesne.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Demesne",
      "properties": {
        "demesne.specs": {
          "type": "array",
          "default": [],
          "markdownDescription": "Specs written in several files. Each entry lists one spec's files in order, as paths relative to the workspace folder, such as `[\"authz/core.demesne\", \"authz/extra.demesne\"]`. A file in an entry is checked together with the files of its spec, and each finding shows in the file it names.",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "scripts": {
    "build:wasm": "../../scripts/build-wasm.sh wasm nodejs",
    "test": "node --test test/*.test.js",
    "test:vscode": "node integration/run.mjs"
  },
  "devDependencies": {
    "@vscode/test-electron": "3.1.0"
  }
}
